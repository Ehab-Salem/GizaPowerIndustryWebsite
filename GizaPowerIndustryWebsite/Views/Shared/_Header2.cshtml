                        Business Lines
                        <svg class="gpi-nav__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.8"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <ul class="gpi-dropdown" role="menu">
                        <li role="none">
                            <a asp-controller="Pages" asp-action="Cables-Wires"
                               class="gpi-dropdown__item" role="menuitem">
                                <span class="gpi-dropdown__icon">⚡</span>
