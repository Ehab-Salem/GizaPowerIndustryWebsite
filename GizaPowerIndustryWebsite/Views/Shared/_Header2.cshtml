                            </a>
                        </li>
                        <li role="none">
                            <a href="#" class="gpi-dropdown__item" role="menuitem">
                                <span class="gpi-dropdown__icon">📡</span>
                                Smart Meters
                            </a>
                        </li>
                        <li role="none">
                            <a href="#" class="gpi-dropdown__item" role="menuitem">
                                <span class="gpi-dropdown__icon">💡</span>
