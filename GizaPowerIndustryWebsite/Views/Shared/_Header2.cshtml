                            </a>
                        </li>
                    </ul>
                </li>

                <li><a asp-controller="Pages" asp-action="Sustainability"
                       class="gpi-nav__link" id="link-sustainability">Sustainability Centre</a></li>

                <li><a asp-controller="Pages" asp-action="News"
                       class="gpi-nav__link" id="link-news">News</a></li>

                <li><a asp-controller="Pages" asp-action="Partners"
                       class="gpi-nav__link" id="link-partners">Partners &amp; Clients</a></li>

                <li><a asp-controller="Pages" asp-action="Careers"
                       class="gpi-nav__link" id="link-careers">Careers</a></li>
            </ul>
        </nav>

        <!-- Actions -->
        <div class="gpi-header__actions">
            <button class="gpi-header__search-btn" id="searchOpen" aria-label="Open search">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16zM19 19l-4.35-4.35"
                          stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>

            <div class="gpi-lang">
                <button class="gpi-lang__btn" aria-label="Switch language">
                    <span>EN</span>
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                        <path d="M1.5 3.5l3.5 3 3.5-3" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            <a asp-controller="Pages" asp-action="Contact" class="gpi-btn-contact">Contact Us</a>

            <!-- Hamburger -->
            <button class="gpi-hamburger" id="gpiHamburger" aria-label="Toggle menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

    </div>
</header>




<!-- ════════════════════════════════════════
     SCRIPT
════════════════════════════════════════ -->
<script>
(function () {
    'use strict';

    const header      = document.getElementById('gpiHeader');
    const hamburger   = document.getElementById('gpiHamburger');
    const nav         = document.getElementById('gpiNav');
    const searchOpen  = document.getElementById('searchOpen');
    const searchClose = document.getElementById('searchClose');
    const overlay     = document.getElementById('searchOverlay');

    /* ── Scroll-reveal logic ──────────────────────────────── */
    /*
       • Below APPEAR_THRESHOLD  → header slides into view
       • Below SOLID_THRESHOLD   → switch to more opaque bg
       • Above APPEAR_THRESHOLD  → header hides again
    */
    const APPEAR_THRESHOLD = 80;   // px from top before header appears
    const SOLID_THRESHOLD  = 200;  // px from top when bg becomes fully opaque

    let lastScrollY = window.scrollY;
    let ticking     = false;

    function updateHeader() {
        const y = window.scrollY;

        if (y > APPEAR_THRESHOLD) {
            header.classList.add('is-visible');
        } else {
            header.classList.remove('is-visible');
        }

        if (y > SOLID_THRESHOLD) {
            header.classList.add('is-solid');
        } else {
            header.classList.remove('is-solid');
        }

        lastScrollY = y;
        ticking = false;
    }

    window.addEventListener('scroll', function () {
        if (!ticking) {
            requestAnimationFrame(updateHeader);
            ticking = true;
        }
    }, { passive: true });

    // Run once on load in case page is already scrolled
    updateHeader();

    /* ── Dropdown ─────────────────────────────────────────── */
    document.querySelectorAll('.gpi-nav__item--dropdown').forEach(function (item) {
        const trigger = item.querySelector('.gpi-nav__dropdown-trigger');

        function open()  { item.classList.add('is-open');    trigger.setAttribute('aria-expanded', 'true'); }
        function close() { item.classList.remove('is-open'); trigger.setAttribute('aria-expanded', 'false'); }
        function toggle(){ item.classList.contains('is-open') ? close() : open(); }

        // Desktop: hover
        item.addEventListener('mouseenter', function () {
            if (window.innerWidth > 960) open();
        });
        item.addEventListener('mouseleave', function () {
            if (window.innerWidth > 960) close();
        });

        // Mobile / keyboard: click
        trigger.addEventListener('click', toggle);

        // Close on Escape
        item.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') close();
        });
    });

    /* ── Hamburger / mobile nav ───────────────────────────── */
    hamburger.addEventListener('click', function () {
        const open = hamburger.classList.toggle('is-open');
        nav.classList.toggle('is-open', open);
        hamburger.setAttribute('aria-expanded', open);
    });

    /* ── Search overlay ──────────────────────────────────── */
    searchOpen.addEventListener('click', function () {
        overlay.classList.add('is-open');
        setTimeout(function () {
            const inp = overlay.querySelector('input');
            if (inp) inp.focus();
        }, 100);
    });

    function closeSearch() { overlay.classList.remove('is-open'); }
    searchClose.addEventListener('click', closeSearch);
    overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeSearch();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSearch();
    });

    /* ── Active link highlight ───────────────────────────── */
    const path = window.location.pathname;
    document.querySelectorAll('.gpi-nav__link[href]').forEach(function (a) {
        if (a.getAttribute('href') === path) a.classList.add('active');
    });
})();
</script>
