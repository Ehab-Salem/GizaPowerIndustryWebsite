<script>
    document.addEventListener("DOMContentLoaded", function () {
        const items = document.querySelectorAll(".footer-col");
        items.forEach((el, i) => {
            setTimeout(() => {
                el.classList.add("show");
            }, i * 150);
        });
    });
</script>

