                header.querySelector(".navbars").style.padding = "10px 40px";
                header.querySelector(".logo-img").style.height = "40px";
            } else {
                header.style.boxShadow = "0 2px 10px rgba(0,0,0,0.05)";
                header.querySelector(".navbars").style.padding = "15px 40px";
                header.querySelector(".logo-img").style.height = "50px";
            }
        });

        // 3. Mobile menu toggle
        const mobileToggle = document.getElementById('mobileToggle');
        const navMenu = document.getElementById('navMenu');
        mobileToggle.addEventListener('click', () => {
            navMenu.classList.toggle('active');
        });

        // 4. Handle About Us / News dropdown on mobile (click-to-toggle, uses .active)
        document.querySelectorAll('.nav-item-dropdown > a').forEach(link => {
            link.addEventListener('click', function (e) {
                if (link.id === 'businessTrigger') return; // skip Business Lines – handled separately
                if (window.innerWidth <= 992) {
                    e.preventDefault();
                    this.parentElement.classList.toggle('active');
                }
            });
        });
    </script>

    <script>
        // ===== METALS LIVE FEED & INTERACTION SCRIPT =====
        (function () {
            const widget = document.getElementById('metalsWidget');
            if (!widget) return;

            let closeTimer = null;
            function isMobile() { return window.innerWidth <= 992; }

            // Desktop Hover with Grace Period
            widget.addEventListener('mouseenter', () => {
                if (isMobile()) return;
                clearTimeout(closeTimer);
                widget.classList.add('dropdown-open');
            });

            widget.addEventListener('mouseleave', () => {
                if (isMobile()) return;
                clearTimeout(closeTimer);
                closeTimer = setTimeout(() => {
                    if (!widget.matches(':hover')) {
                        widget.classList.remove('dropdown-open');
                    }
                }, 200);
            });

            // Mobile / Click Toggle
            const pill = widget.querySelector('.metals-widget-pill');
            if (pill) {
                pill.addEventListener('click', (e) => {
                    if (isMobile()) {
                        e.stopPropagation();
                        widget.classList.toggle('dropdown-open');
                    }
                });
            }

            document.addEventListener('click', (e) => {
                if (!widget.contains(e.target)) {
                    widget.classList.remove('dropdown-open');
                }
            });

            function formatNum(value, digits) {
                return Number(value).toLocaleString('en-US', {
                    minimumFractionDigits: digits,
                    maximumFractionDigits: digits
                });
            }

            function paint(el, text, up) {
                if (!el) return;
                el.textContent = text;
                el.classList.remove('up', 'down');
                if (up === true) el.classList.add('up');
                if (up === false) el.classList.add('down');
            }

            function flashLast(cell, up) {
                if (!cell) return;
                cell.classList.remove('flash-up', 'flash-down');
                cell.classList.add(up ? 'flash-up' : 'flash-down');
                setTimeout(() => cell.classList.remove('flash-up', 'flash-down'), 700);
            }

            function updateRow(prefix, quote, digits) {
                if (!quote) return;
                const up = quote.change >= 0;
                const lastEl = document.getElementById(prefix + 'Last');
                const prevText = lastEl && lastEl.dataset.value;
                paint(lastEl, formatNum(quote.price, digits), up);
                if (lastEl) lastEl.dataset.value = String(quote.price);
                if (prevText && prevText !== String(quote.price)) {
                    flashLast(lastEl, Number(quote.price) >= Number(prevText));
                }
                paint(document.getElementById(prefix + 'Prev'), formatNum(quote.open, digits));
                paint(document.getElementById(prefix + 'High'), formatNum(quote.high ?? quote.price, digits));
                paint(document.getElementById(prefix + 'Low'), formatNum(quote.low ?? quote.price, digits));
                paint(document.getElementById(prefix + 'Chg'), (up ? '' : '') + formatNum(quote.change, digits), up);
                paint(document.getElementById(prefix + 'ChgPct'), (up ? '' : '') + formatNum(quote.changePercent, 2) + '%', up);
                paint(document.getElementById(prefix + 'Time'), quote.time || quote.date || '');
            }

            function updatePill(priceId, indId, quote, digits) {
                if (!quote) return;
                const pEl = document.getElementById(priceId);
                const indEl = document.getElementById(indId);
                if (pEl) pEl.textContent = formatNum(quote.price, digits);
                if (indEl) {
                    const up = quote.change >= 0;
                    indEl.className = 'pill-indicator ' + (up ? 'up' : 'down');
                    indEl.textContent = up ? '▲' : '▼';
                }
            }

            async function fetchMetalsData() {
                try {
                    const res = await fetch('/api/metals');
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data || !data.success) return;
                    updatePill('pillCuPrice', 'pillCuInd', data.copper, 4);
                    updatePill('pillAlPrice', 'pillAlInd', data.aluminum, 2);
                    updatePill('pillPbPrice', 'pillPbInd', data.lead, 2);
                    updateRow('cu', data.copper, 4);
                    updateRow('al', data.aluminum, 2);
                    updateRow('pb', data.lead, 2);
                    const upd = document.getElementById('metalsUpdated');
                    if (upd && data.lastUpdated) upd.textContent = data.lastUpdated;
                } catch (e) {
                    console.log('Metals live feed unavailable');
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fetchMetalsData);
            } else {
                fetchMetalsData();
            }
            setInterval(fetchMetalsData, 30000);
        })();
    </script>
