    <script>
        // Force the header to stay fixed regardless of CSS conflicts
        (function() {
            var header = document.getElementById('headers');
            if (header) {
                header.style.position = 'fixed';
                header.style.top = '0';
                header.style.left = '0';
                header.style.right = '0';
                header.style.width = '100%';
                header.style.zIndex = '9999';
            }
        })();
    </script>

    <script>
        // Business Lines mega-panel (unchanged logic, already hover-intent safe)
        (function() {
          const dropdown = document.getElementById('businessDropdown');
          const trigger = document.getElementById('businessTrigger');
          const categories = document.querySelectorAll('.panel-category');
          const contentPages = document.querySelectorAll('.content-page');
          let hoverTimeout = null;

          function isMobile() {
            return window.innerWidth <= 992;
          }

          // ---------- DESKTOP : HOVER OPENS THE PANEL ----------
          trigger.addEventListener('mouseenter', () => {
            if (!isMobile()) {
              clearTimeout(hoverTimeout);
              dropdown.classList.add('active');
            }
          });

          dropdown.addEventListener('mouseenter', () => {
            if (!isMobile()) {
              clearTimeout(hoverTimeout);
              dropdown.classList.add('active');
            }
          });

          dropdown.addEventListener('mouseleave', () => {
            if (!isMobile()) {
              hoverTimeout = setTimeout(() => {
                if (!dropdown.matches(':hover')) {
                  dropdown.classList.remove('active');
                }
              }, 200);
            }
          });

          // ---------- CLICK ON TRIGGER JUST NAVIGATES (no JS needed) ----------
          // (It's a normal link now – no preventDefault)

          // ---------- SIDEBAR CATEGORIES : HOVER SWITCHES PANEL, CLICK NAVIGATES ----------
          categories.forEach(cat => {
            function activate() {
              const target = cat.getAttribute('data-target');
              categories.forEach(c => c.classList.remove('active'));
              contentPages.forEach(p => p.classList.remove('active'));
              cat.classList.add('active');
              document.getElementById('content-' + target).classList.add('active');
            }

            cat.addEventListener('mouseenter', () => {
              if (!isMobile()) activate();
            });

            // On desktop, just activate before navigation (no preventDefault)
            cat.addEventListener('click', (e) => {
              if (!isMobile()) {
                activate();
                // let the link work normally
              }
            });
          });

          // ---------- CLOSE PANEL IF CLICKING OUTSIDE ----------
          document.addEventListener('click', function(e) {
            if (!dropdown.contains(e.target)) {
              dropdown.classList.remove('active');
            }
          });

        })();
    </script>

    <script>
        // ===== NEW: Hover-intent fix for the simple dropdowns (About Us / News) =====
        // Same grace-period pattern as the Business Lines mega-panel above, so the
        // menu no longer disappears the instant the mouse crosses the gap on its
        // way down from the nav link to the dropdown items.
        (function () {
            const simpleDropdowns = document.querySelectorAll('.nav-item-dropdown:not(#businessDropdown)');

            function isMobile() {
                return window.innerWidth <= 992;
            }

            simpleDropdowns.forEach(function (dropdown) {
                let closeTimer = null;

                function openMenu() {
                    if (isMobile()) return;
                    clearTimeout(closeTimer);
                    // close any other open simple dropdowns first
                    simpleDropdowns.forEach(d => {
                        if (d !== dropdown) d.classList.remove('dropdown-open');
                    });
                    dropdown.classList.add('dropdown-open');
                }

                function scheduleClose() {
                    if (isMobile()) return;
                    clearTimeout(closeTimer);
                    closeTimer = setTimeout(() => {
                        if (!dropdown.matches(':hover')) {
                            dropdown.classList.remove('dropdown-open');
                        }
                    }, 250); // grace period so a fast diagonal move doesn't kill it
                }

                dropdown.addEventListener('mouseenter', openMenu);
                dropdown.addEventListener('mouseleave', scheduleClose);
            });

            // Close on outside click (desktop)
            document.addEventListener('click', function (e) {
                simpleDropdowns.forEach(function (dropdown) {
                    if (!dropdown.contains(e.target)) {
                        dropdown.classList.remove('dropdown-open');
                    }
                });
            });
        })();
    </script>

    <script>
