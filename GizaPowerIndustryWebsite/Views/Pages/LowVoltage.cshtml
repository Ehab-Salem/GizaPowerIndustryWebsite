<script>
        function parseInsulationAndArmor(short) {
        // Default values
        let insulation = 'PVC';
        let armor = 'Unarmored';

        // Pattern: "1 CORE CU-PVC-PVC" or "Multi CORES AL-XLPE-SWA-PVC"
        if (short && (short.startsWith('1 CORE') || short.startsWith('Multi CORES'))) {
            // Split by spaces, last part is "XX-YY-ZZ" (or "XX-YY-ZZ-??" sometimes)
            const parts = short.split(' ');
            const code = parts[parts.length - 1];  // e.g. "CU-PVC-PVC"
            const segments = code.split('-');      // ['CU','PVC','PVC']

            // Insulation is the second segment (PVC or XLPE)
            if (segments.length >= 2) {
                const ins = segments[1].toUpperCase();
                if (ins === 'XLPE') insulation = 'XLPE';
                else insulation = 'PVC';  // default to PVC for any other variation
            }

            // Armoring is the third segment (PVC, ATA, AWA, STA, SWA)
            if (segments.length >= 3) {
                const arm = segments[2].toUpperCase();
                if (arm === 'PVC') armor = 'Unarmored';
                else armor = 'Armored';  // anything else (ATA, AWA, STA, SWA) is armored
            }
        }
        // else: for non-sheathed cables (e.g. "300-500 V Single"), keep defaults PVC / Unarmored

        return { insulation, armor };
    }
        /* ===== Collapse / Expand Filter Group ===== */
    function toggleGroup(header) {
        const group = header.closest('.filter-group');
        if (!group) return;
        group.classList.toggle('collapsed');
    }

    /* ===== Show More / Show Less (if needed) ===== */
    function toggleShowMore(link) {
        const container = link.closest('.filter-options');
        const extras = container.querySelector('.extra-options');
        if (!extras) return;
        if (extras.style.display === 'none' || extras.style.display === '') {
            extras.style.display = 'block';
            link.textContent = '− Show Less';
        } else {
            extras.style.display = 'none';
            link.textContent = '+ Show More';
        }
    }

    /* ===== Single selection inside each filter group ===== */
    document.addEventListener('change', function(e) {
        if (!e.target.matches('.filter-option input[type="checkbox"]')) return;
        const group = e.target.closest('.filter-group');
        if (!group) return;
        // Uncheck all other checkboxes inside the same group
        const allCheckboxes = group.querySelectorAll('.filter-option input[type="checkbox"]');
        allCheckboxes.forEach(cb => {
            if (cb !== e.target) cb.checked = false;
        });
        updateClearButton();
        filterProducts();
    });

    /* ===== Clear All filters ===== */
    function updateClearButton() {
        const anyChecked = document.querySelectorAll('.filter-option input[type="checkbox"]:checked').length > 0;
        const clearBtn = document.getElementById('clearAllFilters');
        if (clearBtn) {
            clearBtn.style.display = anyChecked ? 'inline-block' : 'none';
        }
    }

    document.getElementById('clearAllFilters')?.addEventListener('click', function() {
        document.querySelectorAll('.filter-option input[type="checkbox"]').forEach(cb => cb.checked = false);
        updateClearButton();
        filterProducts();
    });

    /* ===== Product filtering ===== */
    function filterProducts() {
        const selectedFilters = {};
        document.querySelectorAll('.filter-option input[type="checkbox"]:checked').forEach(cb => {
            const filterType = cb.getAttribute('data-filter');
            const value = cb.value;
            selectedFilters[filterType] = value;
        });

        const rows = document.querySelectorAll('.product-row');
        rows.forEach(row => {
            let visible = true;

            // Existing filters
            if (selectedFilters['voltage'] && row.getAttribute('data-voltage') !== selectedFilters['voltage']) visible = false;
            if (selectedFilters['degree'] && row.getAttribute('data-degree') !== selectedFilters['degree']) visible = false;
            if (selectedFilters['core'] && row.getAttribute('data-core') !== selectedFilters['core']) visible = false;
            if (selectedFilters['conductor'] && row.getAttribute('data-conductor') !== selectedFilters['conductor']) visible = false;

            // New filters – parse from the short name
            if (selectedFilters['insulation'] || selectedFilters['armor']) {
                const short = row.getAttribute('data-short');
                const { insulation, armor } = parseInsulationAndArmor(short);
                if (selectedFilters['insulation'] && insulation !== selectedFilters['insulation']) visible = false;
                if (selectedFilters['armor'] && armor !== selectedFilters['armor']) visible = false;
            }

            row.style.display = visible ? 'flex' : 'none';
        });
    }

    // Initial state
    document.addEventListener('DOMContentLoaded', function() {
        updateClearButton();
        filterProducts(); // show all by default
    });

    /* ===== Mobile Sidebar Toggle ===== */
    function openMobileSidebar() {
        document.getElementById('filterSidebar')?.classList.add('open');
    }
    function closeMobileSidebar() {
        document.getElementById('filterSidebar')?.classList.remove('open');
    }

    /* ===== View Toggle (List / Grid) ===== */
    function setView(mode) {
        const list = document.getElementById('productList');
        const listBtn = document.getElementById('listViewBtn');
        const gridBtn = document.getElementById('gridViewBtn');

        if (mode === 'grid') {
            list.classList.add('grid-view');
            gridBtn.classList.add('active');
            listBtn.classList.remove('active');
        } else {
            list.classList.remove('grid-view');
            listBtn.classList.add('active');
            gridBtn.classList.remove('active');
        }
    }
</script>