                    @foreach (var product in products)
                    {
                        // Determine data attributes from the product name
                        string voltage = "", degree = "", core = "", conductor = "";
                        var name = product.Name;

                        if (name.Contains("300/500")) voltage = "300/500V";
                        else if (name.Contains("450/750")) voltage = "450/750V";
                        else if (name.Contains("0.6 / 1") || name.Contains("0.6/1")) voltage = "0.6/1kV";

                        if (name.Contains("Copper")) conductor = "Copper";
                        else if (name.Contains("Aluminum") || name.Contains("Aluminium")) conductor = "Aluminum";

                        if (name.Contains("70º") || name.Contains("70°")) degree = "70°C";
                        else if (name.Contains("90º") || name.Contains("90°")) degree = "90°C";

                        if (name.StartsWith("Single") || name.Contains("Single Core")) core = "Single";
                        else if (name.StartsWith("Multi") || name.Contains("Multi Core")) core = "Multi";

                        <div class="product-row"
                             data-voltage="@voltage"
                             data-degree="@degree"
                             data-conductor="@conductor"
                             data-short="@product.Short"
                             data-core="@core">
