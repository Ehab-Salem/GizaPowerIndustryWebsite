@{
    ViewData["Title"] = "Cables & Wires Products";
}

<style>
    .main-content {
        padding-top: 90px; /* adjust this value as needed */
    }
    .products-page {
        display: flex;
        gap: 30px;
        padding: 40px 0;
        align-items: flex-start;
    }

    /* ===== SIDEBAR ===== */
    .filter-sidebar {
        width: 280px;
        flex-shrink: 0;
        background: #f8f9fa;
        padding: 25px;
        border-radius: 6px;
    }

        .filter-sidebar h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 20px;
        }

    .filter-group {
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 15px;
        margin-bottom: 15px;
    }

    .filter-group-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        font-weight: 600;
        color: #444;
        margin-bottom: 12px;
    }

        .filter-group-header .toggle-icon {
            font-size: 1.2rem;
            line-height: 1;
            transition: transform 0.2s;
        }

    .filter-group.collapsed .toggle-icon {
        transform: rotate(-90deg);
    }

    .filter-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .filter-group.collapsed .filter-options {
        display: none;
    }

    .filter-option {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.92rem;
        color: #555;
        cursor: pointer;
        flex-direction: row-reverse;
    }

        .filter-option input {
            margin-top: 3px;
            cursor: pointer;
        }

    .show-more {
        color: #B82025;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-top: 5px;
    }

    /* ===== MAIN LIST ===== */
    .products-main {
        flex: 1;
    }

    .products-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 10px;
    }

        .products-toolbar h2 {
            color: #B82025;
            font-size: 1.3rem;
            font-weight: 700;
            margin: 0;
        }

    .toolbar-controls {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .toolbar-controls label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #555;
            margin-right: 5px;
        }

        .toolbar-controls select {
            padding: 6px 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.9rem;
        }

    .view-toggle {
        display: flex;
        gap: 5px;
    }

        .view-toggle button {
            width: 38px;
            height: 38px;
            border: 1px solid #ccc;
            background: #fff;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .view-toggle button.active {
                background: #06283F;
                color: #fff;
                border-color: #06283F;
            }

    /* Product rows */
    .product-list {
        display: flex;
        flex-direction: column;
    }

    .product-row {
        display: flex;
        align-items: center;
        gap: 25px;
        padding: 18px 0;
        border-bottom: 1px solid #eee;
    }

        .product-row img {
            width: 100px;
            height: 70px;
            object-fit: cover;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .product-row .product-name {
            flex: 1;
            color: #06283F;
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
        }

        .product-row .btn-spec {
            border: 1px solid #ccc;
            border-radius: 4px;
            background: #fff;
            padding: 10px 18px;
            font-size: 0.85rem;
            color: #555;
            text-decoration: none;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

    /* Grid view */
    .product-list.grid-view {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

        .product-list.grid-view .product-row {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            border: 1px solid #eee;
            border-radius: 6px;
            padding: 20px;
        }

            .product-list.grid-view .product-row img {
                width: 100%;
                height: 140px;
            }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .products-page {
            flex-direction: column;
        }

        .filter-sidebar {
            width: 100%;
        }

        .product-list.grid-view {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .product-row {
            flex-wrap: wrap;
        }

            .product-row .btn-spec {
                width: 100%;
                justify-content: center;
            }

        .product-list.grid-view {
            grid-template-columns: 1fr;
        }

        .products-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<style>
    /* ===== FILTER SIDEBAR – Enhanced ===== */
    /* … keep all your existing styles above, then replace the filter-option part … */

    .filter-option {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.92rem;
        color: #374151;
        cursor: pointer;
        flex-direction: row;
        margin: 0;
        min-height: 2.25rem; /* ensures uniform row height, checkboxes align */
    }

        /* Checkbox – fixed size, never shrinks */
        .filter-option input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid #d1d5db;
            border-radius: 4px;
            margin: 0;
            cursor: pointer;
            position: relative;
            transition: all 0.2s;
            flex-shrink: 0; /* critical – prevents shrinking */
        }

            .filter-option input[type="checkbox"]:checked {
                background: #B82025;
                border-color: #B82025;
            }

                .filter-option input[type="checkbox"]:checked::after {
                    content: "";
                    position: absolute;
                    left: 5px;
                    top: 2px;
                    width: 5px;
                    height: 10px;
                    border: solid #fff;
                    border-width: 0 2px 2px 0;
                    transform: rotate(45deg);
                }

        /* Label text – wraps and takes available space */
        .filter-option .option-label {
            flex: 1 1 auto;
            min-width: 0;
            line-height: 1.4;
        }

        /* Count – stuck to the right, never wraps */
        .filter-option .count {
            flex: 0 0 auto;
            color: #9ca3af;
            font-size: 0.8rem;
            white-space: nowrap;
            margin-left: auto;
        }
</style>

