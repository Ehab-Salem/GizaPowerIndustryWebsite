                            <a asp-controller="Pages" asp-action="@product.Action"
                               asp-route-Short="@product.Short"
                               asp-route-img="@product.Img"
                               class="product-name">@product.Name</a>
                            <a href="~/assets/3DImages/low voltage/@product.Pdf" class="btn-spec" target="_blank">
                                ⭳ Specifications PDF
                            </a>
                        </div>
                    }
                </div>
