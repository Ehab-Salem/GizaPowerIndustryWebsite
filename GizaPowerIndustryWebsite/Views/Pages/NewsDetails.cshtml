@{
    ViewData["Title"] = "News Details";
}
<!-- News Detail Content -->
<section class="news-detail-section" style="    margin-top: 50px !important;">
    <div class="container news-detail-container">
        <div class="news-detail-header-group">
            <h1 class="news-detail-title">GPI Acquires BASEC Certification for Medium Voltage Cables</h1>
            <div class="news-detail-meta">
                <span class="news-detail-date">23 Nov 2025</span>
                <span class="meta-dot"></span>
                <span class="news-detail-badge-pill">Certifications</span>
            </div>
        </div>

        <div class="news-detail-featured-image-container">
            <img src="~/assets/images/news-detail-featured.jpg" alt="GPI Acquires BASEC Certification"
                 class="news-detail-main-img">
            <div class="news-detail-image-overlay"></div>
        </div>

        <div class="news-detail-layout">
            <!-- Main Article Content -->
            <article class="news-detail-main">
                <div class="news-detail-content">
                    <h2>Introduction</h2>
                    <p>
                        Giza Power Industry (GPI) is proud to announce the successful acquisition of the BASEC
                        certification for its Medium Voltage (MV) cable range. This achievement showcases GPI's
                        unwavering commitment to delivering globally certified, high-performance cable solutions
                        that
                        meet the highest safety and quality benchmarks.
                    </p>

                    <h2>What Does This Certification Mean?</h2>
                    <p>
                        BASEC (British Approvals Service for Cables) is one of the world's most recognized and
                        respected certification bodies, specializing in rigorous testing and approval of cable
                        quality.
                    </p>
                    <p>
                        GPI's MV cables underwent extensive evaluation covering electrical performance, material
                        durability, construction integrity, and long-term operational reliability.
                    </p>
                    <p>
                        Achieving this certification demonstrates that GPI's cables consistently meet or exceed
                        international manufacturing standards.
                    </p>

                    <h2>Strengthening Global Market Presence</h2>
                    <p>
                        With this certification, GPI reinforces its strong positioning in the European, Middle
                        Eastern, and African markets—especially the United Kingdom, where BASEC compliance is a
                        critical requirement.
                    </p>
                    <p>
                        This milestone strengthens customer confidence, expands export opportunities, and reflects
                        GPI's dedication to manufacturing excellence.
                    </p>
                    <h2>GPI's Commitment to Quality</h2>
                    <p>
                        GPI continues to invest heavily in state-of-the-art production lines, comprehensive quality
                        labs, and continuous improvement programs.
                    </p>
                    <p>
                        Through stringent testing protocols—including electrical, mechanical, and environmental
                        tests—GPI ensures that every meter of cable delivered to customers aligns with global safety
                        and performance standards.
                    </p>

                    <h2 style="color: #B82025;">Looking Ahead</h2>
                    <p>
                        This certification is not the end—it's a key milestone in GPI's strategy to expand its
                        international footprint and deliver advanced, sustainable, and highly reliable power
                        solutions.
                    </p>
                    <p>
                        By integrating world-class quality assurance systems and pioneering industry practices, GPI
                        aims to continue shaping the future of the cable manufacturing sector.
                    </p>
                </div>
            </article>

            <!-- Related News Sidebar -->
            <aside class="news-detail-sidebar">
                <h3 class="sidebar-title-red">Related News</h3>

                <div class="related-news-list">
                    <article class="related-news-item">
                        <div class="related-news-image">
                            <img src="~/assets/images/latest-news-side-1.jpg" alt="News">
                        </div>
                        <div class="related-news-content">
                            <span class="article-date">23 Nov 2025</span>
                            <h4 class="related-news-title">
                                GPI Launches New Lighting Division for Indoor & Outdoor
                            </h4>
                        </div>
                    </article>

                    <article class="related-news-item">
                        <div class="related-news-image">
                            <img src="~/assets/images/latest-news-side-2.jpg" alt="News">
                        </div>
                        <div class="related-news-content">
                            <span class="article-date">15 Dec 2025</span>
                            <h4 class="related-news-title">
                                GPI Reduces Its Carbon Footprint by 18% Through Advanced
                            </h4>
                        </div>
                    </article>

                    <article class="related-news-item">
                        <div class="related-news-image">
                            <img src="~/assets/images/latest-news-side-3.png" alt="News">
                        </div>
                        <div class="related-news-content">
                            <span class="article-date">28 Jan 2026</span>
                            <h4 class="related-news-title">
                                GPI Exports Expand to 25 Countries Across the EMEA Region
                            </h4>
                        </div>
                    </article>
                </div>
            </aside>
        </div>
    </div>
</section>
