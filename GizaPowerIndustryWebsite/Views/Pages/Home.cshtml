@{
    ViewData["Title"] = "Home";
}

<style>
    /* ===== Redesigned Hero Section ===== */
    .hero-redesigned {
        position: relative;
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        margin-top: 70px;
    }

    /* Background image layer */
    .hero-bg-image {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

        .hero-bg-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .hero-bg-overlay {
        position: absolute;
        inset: 0;
        /* Dark gradient from left for text readability, lighter on the right for the image to show */
        background: linear-gradient( to right, rgba(6, 40, 63, 0.88) 0%, rgba(6, 40, 63, 0.72) 35%, rgba(6, 40, 63, 0.35) 65%, rgba(6, 40, 63, 0.15) 100% );
    }

    /* Wrapper */
    .hero-redesigned-wrapper {
        position: relative;
        z-index: 2;
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        padding: 6rem 5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4rem;
    }

    /* Content area */
    .hero-redesigned-content {
        flex: 1 1 55%;
        max-width: 620px;
    }

    .hero-redesigned-text {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .hero-redesigned-title {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .hero-label {
        display: block;
        font-family: 'Cairo', 'Tajawal', 'Neulis Sans', sans-serif;
        font-weight: 800;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1.15;
        color: #ffffff;
        letter-spacing: -0.02em;
    }

    .hero-tagline {
        display: block;
        font-family: 'Cairo', 'Tajawal', 'Neulis Sans', sans-serif;
        font-weight: 400;
        font-size: clamp(1rem, 1.8vw, 1.25rem);
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.75);
        letter-spacing: 0.01em;
    }

    .hero-redesigned-desc {
        font-size: 1rem;
        line-height: 1.8;
        color: rgba(255, 255, 255, 0.7);
        margin: 0;
        max-width: 480px;
    }

    /* CTA — Crafto-style: orange circle with arrow + text */
    .hero-cta-link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        margin-top: 0.5rem;
        transition: gap 0.3s ease;
    }

        .hero-cta-link:hover {
            gap: 1.1rem;
        }

    .hero-cta-circle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #a3191e;
        flex-shrink: 0;
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .hero-cta-circle img {
            width: 18px;
            height: 18px;
            filter: brightness(0) invert(1);
        }

    .hero-cta-link:hover .hero-cta-circle {
        background: #a3191e;
        transform: scale(1.08);
    }

    .hero-cta-text {
        font-weight: 600;
        font-size: 1rem;
        color: #ffffff;
        letter-spacing: 0.02em;
    }

    /* Floating video preview */
    .hero-video-float {
        flex: 0 0 auto;
        width: clamp(280px, 30vw, 420px);
        aspect-ratio: 4 / 3;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        position: relative;
    }

        .hero-video-float video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    /* ── Responsive ── */
    @@media (max-width: 1024px) {
        .hero-redesigned-wrapper {
            padding: 5rem 3rem;
            flex-direction: column;
            align-items: flex-start;
            gap: 2.5rem;
        }

        .hero-redesigned-content {
            max-width: 100%;
        }

        .hero-video-float {
            width: min(100%, 400px);
        }
    }

    @@media (max-width: 768px) {
        .hero-redesigned {
            min-height: 100svh;
        }

        .hero-redesigned-wrapper {
            padding: 4rem 1.5rem;
            gap: 2rem;
        }

        .hero-label {
            font-size: clamp(1.6rem, 6vw, 2.2rem);
        }

        .hero-video-float {
            width: 100%;
            border-radius: 14px;
        }
    }

    @@media (max-width: 480px) {
        .hero-redesigned-wrapper {
            padding: 3.5rem 1.25rem;
        }

        .hero-cta-circle {
            width: 42px;
            height: 42px;
        }
    }

    /* ===== Hero Title Animation ===== */
    .hero-title {
        overflow: hidden; /* optional, keeps lines clean */
    }

    .reveal-line {
        display: block; /* each line occupies its own block */
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }

        /* Stagger the lines */
        .reveal-line:nth-child(1) {
            animation-delay: 0.1s;
        }

        .reveal-line:nth-child(2) {
            animation-delay: 0.4s;
        }

        .reveal-line:nth-child(3) {
            animation-delay: 0.7s;
        }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .partner-cards {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: stretch;
        gap: 20px;
        margin-top: 40px;
        padding-top: 15px;
        padding-bottom: 15px;
        width: 100%;
    }

    .partner-card {
        background: #fff;
        border-radius: 20px;
        padding: 20px;
        min-height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #ececec;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        transition: all 0.4s ease;
        position: relative;
        flex: 1 1 calc(25% - 20px);
        min-width: 160px;
        max-width: 250px;
    }

        .partner-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 135deg, rgba(200,0,0,0.05), rgba(255,255,255,0) );
            opacity: 0;
            transition: 0.4s;
            border-radius: 20px;
        }

        .partner-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            border-color: #c8102e;
        }

            .partner-card:hover::before {
                opacity: 1;
            }

    .partner-logo-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100px;
    }

        .partner-logo-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            transition: all 0.4s ease;
            image-rendering: high-quality;
        }

    /* Main Logo */
    .logo-main {
        opacity: 1;
        transform: scale(1);
    }

    /* Colored Logo */
    .logo-alternate {
        opacity: 0;
        transform: scale(0.9);
        display: none;
    }

    /* Hover Effect */
    .partner-card:hover .logo-main {
        transform: scale(1.05);
    }

    /* Business Visual Height Fix */
    .business-visual {
        width: 100%;
        max-height: 450px;
        overflow: hidden;
        margin-top: 30px;
    }

        .business-visual img {
            width: 100%;
            height: 100%;
            max-height: 450px;
            object-fit: cover;
            object-position: center;
        }
    /* ── Partner Logo Scroll Strip ── */
    .partner-scroll-section {
        position: relative;
        width: 100%;
        padding: 20px 0;
        overflow: hidden;
    }

    /* Scroll buttons */
    .partner-scroll-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #06283F;
        border: none;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(6,40,63,0.25);
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .partner-scroll-btn:hover {
            background: #B82025;
            transform: translateY(-50%) scale(1.08);
        }

    .partner-scroll-left {
        left: 12px;
    }

    .partner-scroll-right {
        right: 12px;
    }

    /* Scrollable wrapper */
    .partner-scroll-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding: 16px 64px;
    }

        .partner-scroll-wrapper::-webkit-scrollbar {
            display: none;
        }

    /* Track — all cards in one row */
    .partner-scroll-track {
        display: flex;
        gap: 20px;
        width: max-content;
        align-items: center;
    }

    /* Individual logo card */
    .partner-logo-card {
        flex: 0 0 auto;
        width: 160px;
        height: 100px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #E6EAEC;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        transition: all 0.3s ease;
    }

        .partner-logo-card:hover {
            border-color: #B82025;
            box-shadow: 0 8px 24px rgba(184,32,37,0.12);
            transform: translateY(-4px);
        }

        .partner-logo-card img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            filter: grayscale(100%);
            opacity: 0.65;
            transition: all 0.3s ease;
        }

        .partner-logo-card:hover img {
            filter: grayscale(0%);
            opacity: 1;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .partner-logo-card {
            width: 120px;
            height: 80px;
            padding: 12px;
        }

        .partner-scroll-wrapper {
            padding: 12px 52px;
        }
    }

    /* ===== Hero Video Text & CTA Overlay ===== */
    /* =========================================
       VIDEO INTRO SEQUENCE
       Title → Subtitle → Button → Video
    ========================================= */
    /* ===== GUARANTEED FULL-VIEWPORT VIDEO ===== */
    .video-section {
        position: relative;
        width: 100vw !important; /* force full viewport width */
        max-width: none !important; /* override any max-width */
        margin-left: calc(-50vw + 50%) !important;
        margin-right: calc(-50vw + 50%) !important;
        height: 100vh !important;
        min-height: 600px !important;
        overflow: hidden;
        background: #000;
        margin-top: 70px !important; /* keep your top offset */
        box-sizing: border-box;
    }

        .video-section .section-video {
            position: absolute;
            inset: 0;
            width: 100% !important;
            height: 100% !important;
            max-width: none !important;
            object-fit: cover !important;
            display: block;
            z-index: 1;
            /* Reset any transform from animation that might interfere */
            transform: scale(1) !important;
        }
    /* Overlay */
    .video-overlay {
        position: absolute;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000000;
        animation: overlayDisappear 0.9s ease forwards;
        animation-delay: 4.1s;
        pointer-events: none;
    }

    /* Main content */
    .video-hero-overlay-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        width: 90%;
        max-width: 1000px;
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        /* IMPORTANT:
           No animation on the whole container */
        animation: none;
    }

    /* =========================================
       1. TITLE (Split Words & Characters Effect)
    ========================================= */

    .video-hero-title {
        font-family: 'Neulis Sans', 'Cairo', 'Inter', sans-serif;
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 800;
        line-height: 1.2;
        color: #ffffff;
        margin: 0 0 1.25rem 0;
        letter-spacing: 0.01em;
        text-align: center;
        text-transform: uppercase;
        perspective: 1000px;
    }

    .rs_splitted_words {
        position: relative;
        display: inline-block;
        white-space: nowrap;
        margin: 0 0.08em;
    }

    .rs_splitted_words.word-a {
        margin: 0 0.04em;
    }

    .rs_splitted_chars {
        position: relative;
        display: inline-block;
        transform-origin: 50% 50%;
        color: #ffffff;
        opacity: 0;
        transform: translateY(30px) rotateX(-50deg);
        filter: blur(3px);
        animation: rsCharReveal 0.65s cubic-bezier(0.2, 0.8, 0.25, 1) forwards;
    }

    @@keyframes rsCharReveal {
        0% {
            opacity: 0;
            transform: translateY(30px) rotateX(-50deg);
            filter: blur(3px);
        }
        100% {
            opacity: 1;
            transform: translateY(0px) rotateX(0deg);
            filter: blur(0px);
        }
    }

    .video-hero-title-subline {
        display: block;
        font-size: clamp(1.05rem, 2vw, 1.55rem);
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: 0.03em;
        margin-top: 0.5rem;
    }

    /* =========================================
       2. SUBTITLE
    ========================================= */

    .video-hero-subtitle {
        font-family: 'Cairo', 'Tajawal', sans-serif;
        font-size: clamp(0.9rem, 1.6vw, 1.1rem);
        font-weight: 400;
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.92);
        max-width: 820px;
        margin: 0 auto 2rem auto;
        text-align: center;
        letter-spacing: 0.01em;
        opacity: 0;
        transform: translateY(40px);
        animation: heroSubtitleIn 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
        animation-delay: 1.35s;
    }

    /* =========================================
       3. BUTTON
    ========================================= */

    .video-hero-btn {
        display: inline-block;
        background-color: #b82025;
        color: #ffffff !important;
        font-family: 'Neulis Sans', 'Cairo', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        padding: 0.9rem 2.5rem;
        border-radius: 4px;
        text-decoration: none;
        box-shadow: 0 4px 15px rgba(184, 32, 37, 0.3);
        border: none;
        opacity: 0;
        transform: translateY(35px) scale(0.95);
        animation: heroButtonIn 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
        animation-delay: 2.4s;
        transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }

        .video-hero-btn:hover {
            background-color: #8f1519;
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 6px 20px rgba(184, 32, 37, 0.5);
            color: #ffffff !important;
        }

    /* =========================================
       4. OVERLAY DISAPPEARS
    ========================================= */

    .video-overlay {
        animation: overlayDisappear 0.9s ease forwards;
        animation-delay: 4.1s;
        pointer-events: none;
    }

    /* =========================================
       ANIMATIONS
    ========================================= */

    @@keyframes heroTitleIn {
        0%

    {
        opacity: 0;
        transform: translateY(50px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }


    @@keyframes heroSubtitleIn {
        0%

    {
        opacity: 0;
        transform: translateY(40px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }

    }


    @@keyframes heroButtonIn {
        0%

    {
        opacity: 0;
        transform: translateY(35px) scale(0.95);
    }

    100% {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }


    /* Overlay fades away */
    @@keyframes overlayDisappear {
        0%

    {
        opacity: 1;
        visibility: visible;
    }

    70% {
        opacity: 1;
    }

    100% {
        opacity: 0;
        visibility: hidden;
    }

    }


    /* Video becomes visible */
    @@keyframes videoReveal {
        0%

    {
        opacity: 0;
        transform: scale(1.03);
    }

    100% {
        opacity: 1;
        transform: scale(1);
    }

    }
</style>
<style>
    .bl-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .bl-card {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        background: #fff;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .bl-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.15);
        }

    .bl-image {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

        .bl-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .bl-card:hover .bl-image img {
        transform: scale(1.07);
    }

    .bl-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 40%, rgba(6,40,63,0.6) 100%);
    }

    .bl-tag {
        position: absolute;
        top: 15px;
        left: 15px;
        background: #B82025;
        color: #fff;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 4px 10px;
        border-radius: 20px;
        letter-spacing: 1px;
    }

    .bl-body {
        padding: 25px 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .bl-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #06283F;
        margin: 0 0 12px;
    }

    .bl-desc {
        font-size: 16px;
        color: #666;
        line-height: 1.6;
        flex: 1;
        margin: 0 0 20px;
        font-weight: 600 !imporant;
    }

    .bl-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #B82025;
        color: #fff;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        font-size: 0.9rem;
        align-self: flex-start;
        transition: background 0.2s ease, gap 0.2s ease;
    }

        .bl-btn:hover {
            background: #8f1519;
            color: #fff;
            gap: 14px;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1200px) {
        .bl-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .bl-grid {
            grid-template-columns: 1fr;
        }

        .bl-image {
            height: 180px;
        }
    }
</style>
<style>
    <style >
    /* ── 1. CONTAINER & GRID LAYOUT ── */
    .gpi-advantage .container {
        /*   max-width: 1200px; */
        margin: 0 auto;
        padding: 0 20px;
    }

    .advantage-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        margin-top: 0;
        contain: layout style;
    }

    .advantage-col {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* ── 2. CARD BASE ── */
    .advantage-card {
        border-radius: 16px;
        padding: 28px 24px;
        transition: transform 0.25s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 180px;
        contain: content;
        will-change: transform;
        backface-visibility: hidden;
    }

        .advantage-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
        }

        .advantage-card h3 {
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 12px 0;
            letter-spacing: 0.3px;
        }

        .advantage-card p {
            font-size: 16px;
            line-height: 1.6;
            margin: 0;
            opacity: 0.92;
        }

    /* ── 3. SOLID COLOR CARDS ── */
    .adv-navy {
        background: #06283F;
        color: #fff;
    }

        .adv-navy h3 {
            color: #fff;
        }

    .adv-red {
        background: #B82025;
        color: #fff;
    }

        .adv-red h3 {
            color: #fff;
        }

    .adv-grey {
        background: #4A4A4A;
        color: #fff;
    }

        .adv-grey h3 {
            color: #fff;
        }

    .adv-dark-red {
        background: #8F1519;
        color: #fff;
    }

        .adv-dark-red h3 {
            color: #fff;
        }

    .adv-dark-navy {
        background: #041E30;
        color: #fff;
    }

        .adv-dark-navy h3 {
            color: #fff;
        }

    /* ── 4. IMAGE CARDS (middle column) ── */
    .adv-image {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        padding: 0;
        min-height: 260px;
        flex: 1;
        background: #06283F;
    }

        .adv-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            inset: 0;
            display: block;
            transition: transform 0.5s ease;
            will-change: transform;
            backface-visibility: hidden;
        }

        .adv-image:hover img {
            transform: scale(1.04);
        }

    .adv-overlay {
        position: absolute;
        inset: 0;
        opacity: 0.70;
        z-index: 1;
        transition: opacity 0.3s ease;
    }



    .overlay-navy {
        background: linear-gradient(135deg, rgba(6, 40, 63, 0.88), rgba(4, 30, 48, 0.80));
    }

    .adv-image:hover .adv-overlay {
        opacity: 0.55;
    }

    .adv-content {
        position: relative;
        z-index: 2;
        padding: 30px 26px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        height: 100%;
        min-height: 260px;
        color: #fff;
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    }

        .adv-content h3 {
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0 0 10px 0;
            color: #fff;
        }

        .adv-content p {
