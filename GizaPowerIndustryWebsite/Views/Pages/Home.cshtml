<script>

    // Partner Logos Scroll Functionality
    document.addEventListener('DOMContentLoaded', function () {
    // ── Partner logo strip: seamless loop + auto-scroll + manual buttons ──
    const partnerWrapper = document.getElementById("partnerScrollWrapper");

    if (partnerWrapper) {
        const partnerTrack = document.getElementById("partnerScrollTrack");

        // 1. Clone all cards for seamless loop
        const originalCards = Array.from(
            partnerTrack.querySelectorAll(".partner-logo-card")
        );
        originalCards.forEach(card => {
            const clone = card.cloneNode(true);
            clone.setAttribute("aria-hidden", "true");
            partnerTrack.appendChild(clone);
        });

        const scrollSpeed  = 0.7;   // px per tick
        const tickInterval = 16;    // ms (~60fps)
        const scrollAmount = 500;   // px per button click
        let isPaused           = false;
        let isManualScrolling  = false;
        let manualTimeout      = null;
        let autoTimer          = null;

        // 2. Auto-scroll loop
        function startPartnerAutoScroll() {
            autoTimer = setInterval(() => {
                if (isPaused || isManualScrolling) return;

                partnerWrapper.scrollLeft += scrollSpeed;

                // Seamless jump at midpoint
                const halfWidth = partnerTrack.scrollWidth / 2;
                if (partnerWrapper.scrollLeft >= halfWidth) {
                    partnerWrapper.scrollLeft -= halfWidth;
                }
            }, tickInterval);
        }

        startPartnerAutoScroll();

        // 3. Manual buttons
        function manualPartnerScroll(direction) {
            isManualScrolling = true;
            clearTimeout(manualTimeout);
            partnerWrapper.scrollBy({ left: direction * scrollAmount, behavior: "smooth" });
            manualTimeout = setTimeout(() => {
                isManualScrolling = false;
            }, 1500);
        }

        document.querySelector(".partner-scroll-left")
            ?.addEventListener("click", () => manualPartnerScroll(-1));
        document.querySelector(".partner-scroll-right")
            ?.addEventListener("click", () => manualPartnerScroll(1));

        // 4. Pause on hover / touch
        partnerWrapper.addEventListener("mouseenter", () => isPaused = true);
        partnerWrapper.addEventListener("mouseleave", () => isPaused = false);
        partnerWrapper.addEventListener("touchstart", () => {
            isPaused = true;
        }, { passive: true });
        partnerWrapper.addEventListener("touchend", () => {
            setTimeout(() => isPaused = false, 1000);
        }, { passive: true });
    }
    });

    // ── About Us Stats Number Counter Animation (Independent) ──
    (function () {
        function initCounters() {
            const statNumbers = document.querySelectorAll('.stats-row .stat-number');
            if (!statNumbers.length) return;

            function animateCounter(target) {
                if (target.dataset.animated === "true") return;
                target.dataset.animated = "true";

                const finalVal = parseInt(target.getAttribute('data-target'), 10) || 0;
                const suffix = target.getAttribute('data-suffix') || '';
                const duration = 1800; // ms
                const startTime = performance.now();

                function updateCount(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // Ease out cubic
                    const easeOut = 1 - Math.pow(1 - progress, 3);
                    const currentVal = Math.floor(easeOut * finalVal);
                    target.textContent = currentVal + suffix;

                    if (progress < 1) {
                        requestAnimationFrame(updateCount);
                    } else {
                        target.textContent = finalVal + suffix;
                    }
                }

                requestAnimationFrame(updateCount);
            }

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            animateCounter(entry.target);
                            obs.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.15 });

                statNumbers.forEach(stat => observer.observe(stat));
            } else {
                // Fallback for older browsers
                statNumbers.forEach(animateCounter);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initCounters);
        } else {
            initCounters();
        }
    })();

    // Initialize Split Hero Title Character Cascades
    (function () {
        function initSplitTitle() {
            const chars = document.querySelectorAll('#splitHeroTitle .rs_splitted_chars');
            chars.forEach((char, index) => {
                char.style.animationDelay = `${0.2 + index * 0.024}s`;
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSplitTitle);
        } else {
            initSplitTitle();
        }
    })();
</script>
