@{
    ViewData["Title"] = "Quality Assurance";
}

 <!-- Breadcrumb -->
<section class="qa-breadcrumb">
    <div class="container-fluid">
        <nav class="breadcrumb-nav">
            <a href="index.html">Home</a>
            <i class="fas fa-chevron-right"></i>
            <a href="sustainability.html">Sustainability Centre</a>
            <i class="fas fa-chevron-right"></i>
            <span class="current">Quality Assurance & Certifications</span>
        </nav>
    </div>
</section>

<!-- Hero Section -->
<section class="qa-hero">
    <div class="container-fluid">
        <div class="qa-hero-content">
            <div class="qa-hero-left">
                <h1 class="qa-hero-title">
                    QUALITY ASSURANCE<br>
                    <span class="qa-hero-title-red">& CERTIFICATIONS</span>
                </h1>
            </div>
            <div class="qa-hero-right">
                <p class="qa-intro-text">
                    Quality is at the heart of everything we do at GPI. Our commitment to quality is reflected in
                    our rigorous standards and continuous improvement practices.
                </p>
                <a href="#" class="btn-know-more">
                    <span style="padding-right: 30px;">Know More</span>
                    <div class="icon-circle">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                </a>
            </div>
        </div>

        <div class="qa-hero-image-container">
            <img src="~/assets/images/pillar-globe-plant.jpg" alt="Quality Assurance & Certifications">
            <div class="qa-hero-image-overlay"></div>
            <div class="outline-text-sustainability">SUSTAINABILITY</div>
        </div>
    </div>
</section>

<!-- Standards Statement Section -->
<section class="qa-standards">
    <div class="container">
        <div class="qa-standards-content">
            <p class="qa-standards-text">
                Quality is at the heart of everything we do. Our products comply with international standards
                including
                <strong>ISO, KEMA, CPRI, BASEC, IEC, BS, ASTM,</strong> and more.
            </p>
        </div>
    </div>
</section>

<!-- Key Elements Section -->
<section class="qa-key-elements">
    <div class="container-fluid">
        <div class="qa-key-elements-header">
            <p class="qa-key-elements-label">Sustainability</p>
            <h2 class="qa-key-elements-title">
                Key Elements of Our<br><strong>Quality Assurance Practices</strong>
            </h2>
        </div>

        <div class="qa-elements-stack">
            <!-- Card 1: Stringent Quality Control -->
            <div class="qa-element-card qa-card-navy">
                <div class="qa-card-content">
                    <div class="qa-card-text">
                        <h3>STRINGENT QUALITY<br>CONTROL</h3>
                        <p>
                            Thanks to our quality labs, every product undergoes thorough testing and inspection to
                            meet the highest industry standards. Our quality labs include:
                        </p>

                        <div class="qa-labs-grid">
                            <div class="lab-item">
                                <img src="~/assets/images/qa-icon-g.png" alt="icon" class="lab-icon">
                                <span>Electrical Lab For Low Voltage Cables Up To 0.61/ KV</span>
                            </div>
                            <div class="lab-item">
                                <img src="~/assets/images/qa-icon-g.png" alt="icon" class="lab-icon">
                                <span>Electrical Lab For Medium Voltage Cables Up To 36 KV</span>
                            </div>
                            <div class="lab-item">
                                <img src="~/assets/images/qa-icon-g.png" alt="icon" class="lab-icon">
                                <span>Electrical Lab For High And Extra High Voltage Cables Up To 220 KV</span>
                            </div>
                            <div class="lab-item">
                                <img src="~/assets/images/qa-icon-g.png" alt="icon" class="lab-icon">
                                <span>
                                    Physical Lab ( Tensile Test , Dimensions Test , Hot Set Test ,
                                    .............Etc.)
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="qa-card-visual">
                        <img src="~/assets/images/qa-workers-laptop.jpg" alt="Quality Control Visual">
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Certifications Section -->
<section class="qa-certifications">
    <div class="container-fluid" style="padding: 0 60px;">
        <div class="qa-certifications-header">
            <p class="qa-certifications-label">Our Certifications</p>
            <h2 class="qa-certifications-title">Awarded Quality -<br><strong>Related Certifications</strong></h2>
        </div>

        <div class="qa-certifications-grid">
            <!-- Certificate Card 1 -->
            <div class="qa-cert-card">
                <img src="~/assets/images/qa-cert-statement.png" alt="Verification Statement" class="cert-bg">
                <div class="cert-content-overlay">
                    <div class="cert-body">
                        <h3>Verification Statement for our first Greenhouse Gas (GHG)</h3>
                        <p>
                            This important verification was carried out by the Egyptian Organization for
                            Standardization and Quality (EOS), acting as the...
                        </p>
                        <div class="cert-footer">
                            <span class="cert-year">2024</span>
                            <a href="#" class="cert-btn">
                                <img src="~/assets/images/qa-arrow-diagonal.png" alt="Know More">
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate Card 2 -->
            <div class="qa-cert-card">
                <img src="~/assets/images/qa-cert-statement.png" alt="Verification Statement" class="cert-bg">
                <div class="cert-content-overlay">
                    <div class="cert-body">
                        <h3>Verification Statement for our first Greenhouse Gas (GHG)</h3>
                        <p>
                            Validation/Verification Body: EPU-VVB is a formal confirmation by Giza Power Industry
                            (GPI) during the specified period.
                        </p>
                        <div class="cert-footer">
                            <span class="cert-year">2024</span>
                            <a href="#" class="cert-btn">
                                <img src="~/assets/images/qa-arrow-diagonal.png" alt="Know More">
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate Card 3 -->
            <div class="qa-cert-card">
                <img src="~/assets/images/qa-cert-statement.png" alt="Verification Statement" class="cert-bg">
                <div class="cert-content-overlay">
                    <div class="cert-body">
                        <h3>Emission Reduction Target for the Year 2025</h3>
                        <p>
                            Certified targets for reducing our carbon footprint and contributing to global
                            sustainability goals.
                        </p>
                        <div class="cert-footer">
                            <span class="cert-year">2025</span>
                            <a href="#" class="cert-btn">
                                <img src="~/assets/images/qa-arrow-diagonal.png" alt="Know More">
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Certificate Card 4 -->
            <div class="qa-cert-card">
                <img src="~/assets/images/qa-cert-statement.png" alt="Verification Statement" class="cert-bg">
                <div class="cert-content-overlay">
                    <div class="cert-body">
                        <h3>Annual Progress Report on Sustainability Initiatives</h3>
                        <p>
                            Comprehensive report detailing our progress in implementing sustainable business
                            practices.
                        </p>
                        <div class="cert-footer">
                            <span class="cert-year">2023</span>
                            <a href="#" class="cert-btn">
                                <img src="~/assets/images/qa-arrow-diagonal.png" alt="Know More">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>