@{
    ViewData["Title"] = "Products";
}

<style>
    /* ===== Business Lines Intro Card ===== */
    .business-lines-intro {
        padding: 20px 0 40px; /* reduces space around the card */
    }

    .intro-card {
        position: relative;
        max-width: 800px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 36px 40px;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    }

    .intro-accent {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 4px;
        background: #a3191e;
        border-radius: 0 0 4px 4px;
    }

    .intro-text {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #4b5563;
        margin: 0;
    }

        .intro-text strong {
            color: #06283f;
        }

        .intro-text span {
            font-weight: 600;
            color: #a3191e;
            white-space: nowrap;
        }

    /* ===== Section Label above the product grid ===== */
    .section-label {
        font-size: 2rem;
        font-weight: 800;
        color: #06283f;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


    .business-links {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 14px;
    margin-top: 8px;
}

.business-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #a3191e;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    padding: 7px 12px;
    border-radius: 8px;
    transition: all 0.25s ease;
    position: relative;
}

.business-link::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 3px;
    height: 1px;
    background: #a3191e;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
}

.business-link i {
    font-size: 11px;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.25s ease;
}

.business-link:hover {
    color: #06283f;
    background: rgba(163, 25, 30, 0.06);
}

.business-link:hover::after {
    transform: scaleX(1);
}

.business-link:hover i {
    opacity: 1;
    transform: translate(0, 0);
}

    /* ===== Ensure the product cards have no extra styling ===== */
    /* (no changes needed – the existing interactive-banner-style-03 works fine) */
</style>
