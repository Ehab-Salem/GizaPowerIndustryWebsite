@{
    ViewData["Title"] = "CablesWires";
}
<div class="main-content">
    <!-- start page title -->
    <section class="page-title-big-typography ipad-top-space-margin cover-background background-position-center-bottom position-relative big-section"
             style="background-image:url('@Url.Content("~/assets/GPI Website Visuals/Business Lines/Cables/GPI Cables & Wires.jpg")')">
        <div class="opacity-extra-medium bg-dark-slate-blue"></div>

        <div class="container">
            <div class="row align-items-center justify-content-center">
                <!-- <div class="col-lg-6 col-md-8 position-relative text-center page-title-extra-large"
                     data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-600 text-white mb-15px" local="FiberOpticProducts"> GPI <br /> Cables & Wires </h1>
                    <h2 class="mb-0 text-white">STARTED AS GIZA CABLES OVER IN 1984, WE HAVE GROWN INTO GIZA POWER INDUSTRY (GPI), A REGIONAL, DIVERSIFIED INTEGRATED CABLE SOLUTIONS PROVIDER.</h2>
                </div> -->
            </div>
        </div>
    </section>
    <div class="container mt-3">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-12 col-md-8 position-relative text-center page-title-extra-large" data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-800 mb-15px" style="color: #06283F !important">Cables & Wires</h1>
                    <h2 class="mb-0" style="color: #06283F !important">GPI’s Cables portfolio provides a comprehensive range of integrated cable solutions that comply with international standards and are recognized locally and globally. </h2>
                </div>
            </div>
        </div>
    <!-- start page title -->
    <section class="ipad-top-space-margin md-pt-0 pt-0 pb-0">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-12 text-center position-relative page-title-double-large">
                    <div class="d-flex flex-column justify-content-center extra-very-small-screen">
                        <h2 class="text-dark-gray d-inline-block fw-400 ls-0px mb-0">
                            Built since 1984 on a total area of 81,745 m2 at the industrial area of Abo Rawash, GPI is today one of the best modern factories in the region to manufacture and supply electrical cables with cutting-edge technology and unparalleled quality serving diverse industries.
                            GPI’s Cables portfolio provides a comprehensive range of integrated cable solutions that comply with international standards and are recognized locally and globally. Thanks to our efficient manufacturing process and state-of-the-art quality labs, we boast our ability to provide reliable, cost-effective, high-quality products and innovative solutions for our customers. With a growing reach and an annual production capacity of approximately 25,000 tons, we offer power, special cables and OHTL conductors.
                        </h2>
                    </div>

                </div>
            </div>
        </div>
    </section>
    <!-- start section -->
    <section class="big-section" style="padding-top: 0px;padding-bottom: 4rem;">
        <div class="container">
            <div class="row row-cols-1 row-cols-xl-5 row-cols-lg-3 row-cols-sm-2 justify-content-center" data-anime='{ "el": "childs", "scale":[0.9,1], "opacity": [0,1], "duration": 500, "delay": 0, "staggervalue": 200, "easing": "easeOutQuad" }'>
                <div class="col text-center interactive-banner-style-01 lg-mb-30px">
                    <figure class="m-0 position-relative hover-box border-radius-6px overflow-hidden" style="height:100%">

                        <img src="~/assets/GPI Website Visuals/Business Lines/Cables/low-voltage.jpg" alt="" style="height:100%;    width: 100%;" />

                        <div class="position-absolute top-0px left-0px w-100 h-100 bg-gradient-dark-transparent opacity-5"></div>

                        <figcaption class="w-100 h-100 d-flex flex-column justify-content-end align-items-center p-30px">

                            <div class="position-relative z-index-1">
                                <span class="alt-font fs-18 fw-500 text-white d-block">
                                    Low Voltage Cables
                                </span>
                            </div>

                            <div class="box-overlay bg-dark-gray"></div>

                            <a asp-controller="Pages" asp-action="LowVoltage" class="stretched-link"></a>

                        </figcaption>

                    </figure>
                </div>
                <div class="col text-center interactive-banner-style-01 lg-mb-30px">
                    <figure class="m-0 position-relative hover-box border-radius-6px overflow-hidden" style="height:100%">
                        <img src="~/assets/GPI Website Visuals/Business Lines/Cables/medium-voltage.jpg" alt="" style="height:100%;width: 100%;" />
                        <div class="position-absolute top-0px left-0px w-100 h-100 bg-gradient-dark-transparent opacity-5"></div>
                        <figcaption class="w-100 h-100 d-flex flex-column justify-content-end align-items-center p-30px">
                            <div class="position-relative z-index-1">
                                <a href="#" class="alt-font fs-18 fw-500 lette text-white d-block w-220px">Medium Voltage Cables</a>
                            </div>
                            <div class="box-overlay bg-dark-gray"></div>
                            <a asp-controller="Pages" asp-action="MediumVoltage" class="stretched-link"></a>
                        </figcaption>
                    </figure>
                </div>
                <div class="col text-center interactive-banner-style-01 lg-mb-30px">
                    <figure class="m-0 position-relative hover-box border-radius-6px overflow-hidden" >
                        <img src="~/assets/GPI Website Visuals/Business Lines/Cables/high-voltage.jpg" alt="" style="width: 100%;" />
                        <div class="position-absolute top-0px left-0px w-100 h-100 bg-gradient-dark-transparent opacity-5"></div>
                        <figcaption class="w-100 h-100 d-flex flex-column justify-content-end align-items-center p-30px">
                            <div class="position-relative z-index-1">
                                <a href="#" class="alt-font fs-18 fw-500 lette text-white d-block">High Voltage Cables</a>
                            </div>
                            <div class="box-overlay bg-dark-gray"></div>
                            <a asp-controller="Pages" asp-action="HighVoltage" class="stretched-link"></a>
                        </figcaption>
                    </figure>
                </div>
                <div class="col text-center interactive-banner-style-01">
                    <figure class="m-0 position-relative hover-box border-radius-6px overflow-hidden" style="height:100%">
                        <img src="~/assets/GPI Website Visuals/Business Lines/Cables/overhead-conductors.jpg" alt="" style="height:100%;width: 100%;" />
                        <div class="position-absolute top-0px left-0px w-100 h-100 bg-gradient-dark-transparent opacity-5"></div>
                        <figcaption class="w-100 h-100 d-flex flex-column justify-content-end align-items-center p-30px">
                            <div class="position-relative z-index-1">
                                <a href="#" class="alt-font fs-18 fw-500 lette text-white d-block w-220px">Overhead Conductor</a>
                            </div>
                            <div class="box-overlay bg-dark-gray"></div>
                            <a asp-controller="Pages" asp-action="OverHead" class="stretched-link"></a>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </div>
    </section>
    <!-- end section -->
</div>
