                    </div><!-- end tab-content -->
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    (function() {
        const wrapper = document.querySelector('.tab-scroll-wrapper');
        if (!wrapper) return;

        const container = wrapper.querySelector('.tab-scroll-container');
        const leftBtn = wrapper.querySelector('.tab-scroll-arrow-left');
        const rightBtn = wrapper.querySelector('.tab-scroll-arrow-right');

        function updateArrows() {
            const maxScroll = container.scrollWidth - container.clientWidth;
            leftBtn.disabled = container.scrollLeft <= 0;
            rightBtn.disabled = container.scrollLeft >= maxScroll - 1;
        }

        leftBtn.addEventListener('click', () => {
            container.scrollBy({ left: -200, behavior: 'smooth' });
        });

        rightBtn.addEventListener('click', () => {
            container.scrollBy({ left: 200, behavior: 'smooth' });
        });

        container.addEventListener('scroll', updateArrows);
        window.addEventListener('resize', updateArrows);

        updateArrows();
    })();
</script>