                        <!-- SMART GRID -->
                        <div class="tab-pane fade" id="smart-grid" role="tabpanel">
                            <div class="row m-0">
                                <div class="col-12">
                                    <p style="font-size:1rem; color: var(--text-grey); line-height:1.8; background:#F9FAFB; padding:2rem; border-radius:12px; border-left:4px solid var(--gpi-red);">
                                        Designed for seamless integration into smart grid environments, the S34U18 CTVT supports real-time data
                                        exchange, remote diagnostics, and scalable deployment across urban and industrial networks. Its modular
                                        communication architecture ensures compatibility with evolving utility protocols, while its secure data
                                        handling and event logging enhance transparency and operational control for energy providers.
                                    </p>
                                </div>
