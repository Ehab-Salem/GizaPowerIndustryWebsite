                                    <a class="nav-link" data-bs-toggle="tab" href="#smart-grid" role="tab" aria-selected="false">SMART GRID</a>
                                </li>
                                <li class="nav-item text-center" role="presentation">
                                    <a class="nav-link" data-bs-toggle="tab" href="#security-standards" role="tab" aria-selected="false">SECURITY & STANDARDS</a>
                                </li>
                                <li class="nav-item text-center" role="presentation">
                                    <a class="nav-link" data-bs-toggle="tab" href="#dimensions" role="tab" aria-selected="false">Dimensions</a>
                                </li>
                            </ul>
                        </div>

                        <button class="tab-scroll-arrow tab-scroll-arrow-right" type="button" aria-label="Scroll right">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 18l6-6-6-6" />
                            </svg>
                        </button>
                    </div>

                    <div class="h-1px w-100 bg-extra-medium-gray sm-mt-10px" style="margin-bottom:15px"></div>

                    <div class="tab-content">
                        <!-- KEY FEATURES (active by default) -->
                        <div class="tab-pane fade show active" id="note" role="tabpanel">
                            <div class="row m-0">
                                <div class="col-12">
                                    <div class="row">
                                        <div class="col-lg-5 col-md-3 col-sm-4 pt-10px pb-10px xs-pb-0 text-dark-gray alt-font fw-600" style="color: #a3191e;">METER TYPE :</div>
                                        <div class="col-lg-7 col-md-9 col-sm-8 pt-10px pb-10px xs-pt-0">3-phase, 4-wire, transformer-operated</div>
                                    </div>
                                    <div class="row bg-very-light-gray">
                                        <div class="col-lg-5 col-md-3 col-sm-4 pt-10px pb-10px xs-pb-0 text-dark-gray alt-font fw-600" style="color: #a3191e;">MEASUREMENT:</div>
                                        <div class="col-lg-7 col-md-9 col-sm-8 pt-10px pb-10px xs-pt-0">Active & reactive energy (four quadrants), demand, instantaneous values</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-5 col-md-3 col-sm-4 pt-10px pb-10px xs-pb-0 text-dark-gray alt-font fw-600" style="color: #a3191e;">ACCURACY CLASS :</div>
