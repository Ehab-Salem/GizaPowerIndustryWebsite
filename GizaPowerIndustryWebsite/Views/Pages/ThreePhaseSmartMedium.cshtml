                                        <li>Secure firmware upgrade mechanism</li>
                                        <li>ECC256 encryption for public network communication</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- COMMUNICATION INTERFACES -->
                        <div class="tab-pane fade" id="COMMUNICATION" role="tabpanel">
                            <div class="row m-0">
                                <div class="col-12">
                                    <ul class="list-style-04">
                                        <li>Optical Port (IEC 62056-21)</li>
                                        <li>RS485 (RJ45)</li>
                                        <li>PLC+RF (G3/PRIME v1.4)</li>
