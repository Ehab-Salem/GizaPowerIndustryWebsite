<script>
        document.addEventListener("DOMContentLoaded", function () {
            // Intersection Observer for fade-in animations
            const elements = document.querySelectorAll(".fade-in");
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("show");
                    }
                });
            }, { threshold: 0.2 });

            elements.forEach(el => observer.observe(el));

            // Hero Slider Logic
            const slides = document.querySelectorAll(".hero-slide");
            const dots = document.querySelectorAll(".slider-dot");
            const prevBtn = document.querySelector(".prev-arrow");
            const nextBtn = document.querySelector(".next-arrow");
            const progressBar = document.querySelector(".slider-progress-bar");

            if (slides.length > 0) {
                let currentSlide = 0;
                const slideInterval = 6000; // 6 seconds per slide
                let progressInterval;
                let progressPercent = 0;
                const progressStepTime = 40; // Update progress every 40ms

                function showSlide(index) {
                    // Remove active class from all slides and dots
                    slides.forEach(slide => {
                        slide.classList.remove("active");
                    });
                    dots.forEach(dot => {
                        dot.classList.remove("active");
                    });

                    // Wrap index
                    if (index >= slides.length) {
                        currentSlide = 0;
                    } else if (index < 0) {
                        currentSlide = slides.length - 1;
                    } else {
                        currentSlide = index;
                    }

                    // Add active class to current slide and dot
                    slides[currentSlide].classList.add("active");
                    dots[currentSlide].classList.add("active");

                    // Reset progress bar
                    resetProgress();
                }

                function nextSlide() {
                    showSlide(currentSlide + 1);
                }

                function prevSlide() {
                    showSlide(currentSlide - 1);
                }

                function resetProgress() {
                    clearInterval(progressInterval);
                    progressPercent = 0;
                    if (progressBar) progressBar.style.width = "0%";

                    // Only start progress bar if autoplay is running
                    startProgress();
                }

                function startProgress() {
                    const totalSteps = slideInterval / progressStepTime;
                    progressInterval = setInterval(() => {
                        progressPercent += 100 / totalSteps;
                        if (progressBar) progressBar.style.width = Math.min(progressPercent, 100) + "%";

                        if (progressPercent >= 100) {
                            clearInterval(progressInterval);
                            nextSlide();
                        }
                    }, progressStepTime);
                }

                // Event Listeners for arrows
                if (nextBtn) {
                    nextBtn.addEventListener("click", () => {
                        nextSlide();
                    });
                }

                if (prevBtn) {
                    prevBtn.addEventListener("click", () => {
                        prevSlide();
                    });
                }

                // Event Listeners for dots
                dots.forEach(dot => {
                    dot.addEventListener("click", (e) => {
                        const targetIndex = parseInt(e.target.getAttribute("data-index"));
                        showSlide(targetIndex);
                    });
                });

                // Touch swipe support for mobile
                let touchStartX = 0;
                TouchSwipeHelper();

                function TouchSwipeHelper() {
                    const sliderContainer = document.querySelector(".hero-slider");
                    if (sliderContainer) {
                        sliderContainer.addEventListener("touchstart", (e) => {
                            touchStartX = e.changedTouches[0].screenX;
                        }, { passive: true });

                        sliderContainer.addEventListener("touchend", (e) => {
                            const touchEndX = e.changedTouches[0].screenX;
                            const swipeThreshold = 50;
                            if (touchStartX - touchEndX > swipeThreshold) {
                                nextSlide(); // Swiped left, show next
                            } else if (touchEndX - touchStartX > swipeThreshold) {
                                prevSlide(); // Swiped right, show prev
                            }
                        }, { passive: true });
                    }
                }

                // Initialize progress bar/autoplay
                startProgress();
            }
            // ── People strip: manual buttons + auto-scroll ──────────────────────
            // ── People strip: seamless loop + auto-scroll + manual buttons ──────
            const peopleWrapper = document.getElementById("peopleGridWrapper");

            if (peopleWrapper) {
                const peopleGrid = peopleWrapper.querySelector(".people-grid");

                // 1. Clone all cards and append them → creates seamless loop
                const originalCards = Array.from(peopleGrid.querySelectorAll(".people-card"));
                originalCards.forEach(card => {
                    const clone = card.cloneNode(true);
                    clone.setAttribute("aria-hidden", "true");
                    peopleGrid.appendChild(clone);
                });

                const scrollSpeed   = 0.8;   // px per tick — adjust for faster/slower
                const tickInterval  = 16;    // ms (~60fps)
                const scrollAmount  = 420;   // px per manual button click
                let   isPaused      = false;
                let   autoTimer     = null;
                let   isManualScrolling = false;
                let   manualTimeout = null;

                // 2. Auto-scroll loop
                function startAutoScroll() {
                    autoTimer = setInterval(() => {
                        if (isPaused || isManualScrolling) return;

                        peopleWrapper.scrollLeft += scrollSpeed;

                        // When we've scrolled past the original set, jump back silently
                        const halfWidth = peopleGrid.scrollWidth / 2;
                        if (peopleWrapper.scrollLeft >= halfWidth) {
                            // Instant jump — no visible flicker because second half is identical
                            peopleWrapper.scrollLeft -= halfWidth;
                        }
                    }, tickInterval);
                }

                startAutoScroll();

                // 3. Manual buttons — temporarily flag as manual, then resume auto
                function manualScroll(direction) {
                    isManualScrolling = true;
                    clearTimeout(manualTimeout);

                    peopleWrapper.scrollBy({ left: direction * scrollAmount, behavior: "smooth" });

                    // Resume auto-scroll 1.5s after user stops clicking
                    manualTimeout = setTimeout(() => {
                        isManualScrolling = false;
                    }, 1500);
                }

                document.querySelector(".scroll-left")?.addEventListener("click", () => {
                    manualScroll(-1);
                });

                document.querySelector(".scroll-right")?.addEventListener("click", () => {
                    manualScroll(1);
                });

                // 4. Pause on hover / touch
                peopleWrapper.addEventListener("mouseenter", () => isPaused = true);
                peopleWrapper.addEventListener("mouseleave", () => isPaused = false);
                peopleWrapper.addEventListener("touchstart",  () => {
                    isPaused = true;
                }, { passive: true });
                peopleWrapper.addEventListener("touchend", () => {
                    setTimeout(() => isPaused = false, 1000);
                }, { passive: true });
            }
            // ── Supply Chain tabs ────────────────────────
            const scTabs = document.querySelectorAll(".sc2-tab");

            if (scTabs.length) {
                scTabs.forEach(tab => {
                    tab.addEventListener("mouseenter", () => {
