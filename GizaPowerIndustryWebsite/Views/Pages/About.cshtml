@{
    ViewData["Title"] = "About";
}

<!-- ===== Style ===== -->
<style>
    #group-structure-custom {
        padding-top: 0;
        background: #fff;
        font-family: sans-serif;
    }
    /* Logo inside group-item title */
    .group-item .title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .title-logo {
        display: block;
        margin-top: 16px;
        height: 120px;
    }
    /* Layout */
    #group-structure-custom .container {
        display: grid;
        grid-template-columns: 40% 60%;
        gap: 40px;
    }

    /* Header */
    .group-header h2 {
        color: #06283F;
        font-size: 40px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .group-header .subtitle {
        color: #B82025;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .group-header p {
        color: #555;
        line-height: 1.8;
    }

    /* Items */
    .group-item {
        display: flex;
        gap: 30px;
        margin-bottom: 25px;
        align-items: center;
    }

        .group-item .title {
            width: 30%;
            color: #B82025;
            font-weight: 600;
            font-size: 18px;
        }

        .group-item .desc {
            width: 70%;
            color: #555;
            line-height: 1.8;
        }

    /* Separator */
    .separator {
        height: 1px;
        background: #ddd;
        margin: 20px 0;
    }

    /* Fade Animation */
    .fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease;
    }

        .fade-in.show {
            opacity: 1;
            transform: translateY(0);
        }

    /* Delay effect */
    .group-item:nth-child(1) {
        transition-delay: 0.1s;
    }

    .group-item:nth-child(3) {
        transition-delay: 0.2s;
    }

    .group-item:nth-child(5) {
        transition-delay: 0.3s;
    }

    .group-item:nth-child(7) {
        transition-delay: 0.4s;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        #group-structure-custom .container {
            grid-template-columns: 1fr;
        }

        .group-item {
            flex-direction: column;
        }

            .group-item .title,
            .group-item .desc {
                width: 100%;
            }
    }

    .org-structure {
        margin-top: 40px;
    }

    /* Base box */
    .org-box {
        text-align: center;
        color: #fff;
        padding: 18px;
        border-radius: 8px;
        font-weight: 600;
        margin-bottom: 15px;
    }

        /* Colors */
        .org-box.navy {
            background: #06283F;
            font-size: 22px;
        }

        .org-box.red {
            background: #B82025;
        }

        .org-box.main {
            font-size: 20px;
        }

        .org-box.small {
            font-size: 16px;
            flex: 1;
            background: #182a3f;
        }

    /* Bottom row */
    .org-row {
        display: flex;
        gap: 15px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .org-row {
            flex-direction: column;
        }
    }

    /* Animation (reuse fade-in) */
    .fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition: 0.8s ease;
    }

        .fade-in.show {
            opacity: 1;
            transform: translateY(0);
        }
    /* People Scroll*/
    /* Add this to your CSS */
    /* People Scroll */
    .people-section-scroll {
        position: relative;
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        padding: 40px 0;
        overflow: hidden;
    }

    .people-scroll-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #B82025;
        border: none;
        color: #fff;
        font-size: 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(184,32,37,0.3);
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .people-scroll-btn:hover {
            background: #8a1419;
            transform: translateY(-50%) scale(1.08);
        }

        .people-scroll-btn.scroll-left {
            left: 20px;
        }

        .people-scroll-btn.scroll-right {
            right: 20px;
        }

    .people-grid-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding: 20px 80px; /* room for the buttons */
    }

        .people-grid-wrapper::-webkit-scrollbar {
            display: none;
        }

    .people-grid {
        display: flex;
        gap: 60px; /* fixed px gap – cleaner than 13% in flex */
        width: max-content;
        align-items: flex-start;
    }

    .people-card {
        flex: 0 0 auto;
    }
    /* ── History Section Base Styles ── */
    .our-history-modern {
        /* padding: 10px 0; */
        background: #F7F8F8;
    }

    .history-header {
        max-width: 860px;
        margin: 0 auto 20px;
        padding: 0 20px;
    }

    /* Title */
    .history-main-title {
        font-size: clamp(1.75rem, 4vw, 3rem);
        color: #06283F;
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        text-transform: uppercase;
    }

        .history-main-title span {
            color: #B82025;
        }

    .history-intro {
        font-size: clamp(0.9rem, 1.5vw, 1.0625rem);
        color: #586F7E;
        line-height: 1.75;
        max-width: 800px;
        margin: 0 auto 1.5rem;
    }

    /* Timeline wrapper */
    .timeline-modern {
        position: relative;
        max-width: 1140px;
        margin: 50px auto 70px;
        padding: 0 20px;
    }

        /* Center vertical red line */
        .timeline-modern::before {
            content: "";
            position: absolute;
            left: 50%;
            width: 3px;
            height: 100%;
            background: #B82025;
            transform: translateX(-50%);
            top: 0;
            z-index: 1;
        }

    /* Milestone Row (Card on one side, Image on the other) */
    .timeline-item {
        width: 100% !important;
        max-width: 100% !important;
        display: grid !important;
        grid-template-columns: 1fr 1fr !important;
        gap: 80px !important;
        align-items: center !important;
        position: relative !important;
        margin-bottom: 60px !important;
        box-sizing: border-box !important;
        left: auto !important;
        right: auto !important;
        float: none !important;
        padding: 0 !important;
    }

        /* ODD: Card on LEFT, Image on RIGHT */
        .timeline-item:nth-child(odd) .timeline-card {
            grid-column: 1 !important;
            grid-row: 1 !important;
        }

        .timeline-item:nth-child(odd) .timeline-year-img {
            grid-column: 2 !important;
            grid-row: 1 !important;
        }

        /* EVEN: Image on LEFT, Card on RIGHT */
        .timeline-item:nth-child(even) .timeline-year-img {
            grid-column: 1 !important;
            grid-row: 1 !important;
        }

        .timeline-item:nth-child(even) .timeline-card {
            grid-column: 2 !important;
            grid-row: 1 !important;
        }

    /* Timeline Bullseye Center Dot */
    .timeline-dot {
        width: 22px !important;
        height: 22px !important;
        border-radius: 50% !important;
        background: #B82025 !important;
        border: 4px solid #fff !important;
        box-shadow: 0 0 0 2.5px #B82025 !important;
        position: absolute !important;
        left: 50% !important;
        top: 50% !important;
        transform: translate(-50%, -50%) !important;
        z-index: 3 !important;
        margin: 0 !important;
    }

    /* Timeline Image */
    .timeline-year-img {
        width: 100% !important;
        height: 260px !important;
        object-fit: cover !important;
        border-radius: 18px !important;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1) !important;
        display: block !important;
        transition: transform 0.4s ease, box-shadow 0.4s ease !important;
        margin: 0 !important;
    }

    .timeline-item:hover .timeline-year-img {
        transform: scale(1.02) !important;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.15) !important;
    }

    /* Timeline Card */
    .timeline-card {
        background: #ffffff !important;
        border: 1px solid #f0f2f5 !important;
        padding: 32px 36px !important;
        border-radius: 18px !important;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05) !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease !important;
        display: flex !important;
        flex-direction: column !important;
        width: auto !important;
        margin: 0 !important;
    }

    .timeline-card:hover {
        transform: translateY(-3px) !important;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08) !important;
    }

    /* Year (Red, bold, right-aligned) */
    .timeline-card h4 {
        color: #B82025 !important;
        font-weight: 800 !important;
        font-size: 1.4rem !important;
        margin: 0 0 8px 0 !important;
        text-align: left !important;
    }

    /* Title (Navy blue, bold, right-aligned) */
    .timeline-card h5 {
        color: #06283F !important;
        font-weight: 700 !important;
        margin: 0 0 14px 0 !important;
        font-size: 1.25rem !important;
        text-align: left !important;
    }

    /* Paragraph */
    .timeline-card p {
        color: #555555 !important;
        font-size: 14.5px !important;
        text-align: left !important;
        line-height: 1.7 !important;
        margin: 0 !important;
    }

    /* Animation */
    .fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition: 0.8s;
    }

        .fade-in.show {
            opacity: 1;
            transform: translateY(0);
        }

    /* ── People-Centric Approach - Smaller Circle Images ── */
    .portrait-circle {
        width: 140px !important;
        height: 140px !important;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
        transition: transform 0.3s ease;
        position: relative;
    }

    .portrait-circle:hover {
        transform: scale(1.06);
    }

    .portrait-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .portrait-circle.bg-red {
        background-color: #B82025;
    }

    /* ── Leadership Philosophy - Smaller Images ── */
    .commitments-grid-asymmetric .image-card-v2 {
        max-height: 300px;
        padding: 0;
        overflow: hidden;
    }

    .commitments-grid-asymmetric .image-card-v2 img.main-img {
        width: 100%;
        height: 100%;
        max-height: 300px;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .commitments-grid-asymmetric .image-card-v2:hover img.main-img {
        transform: scale(1.04);
    }

    /* ── Responsive — Timeline ── */

    /* Tablets */
    @@media (max-width: 992px) {
        .our-history-modern {
            padding: 40px 0;
        }

        .timeline-modern {
            max-width: 100%;
            padding: 0 15px;
        }

        .timeline-item {
            gap: 40px;
        }

        .timeline-year-img {
            height: 200px !important;
        }

        .timeline-card {
            padding: 24px 26px;
        }

        .timeline-card h4 {
            font-size: 1.2rem;
        }

        .timeline-card h5 {
            font-size: 1.1rem;
        }

        .timeline-card p {
            font-size: 13.5px;
        }
    }

    /* Mobile — single column */
    /* Mobile — single column */
    @@media (max-width: 768px) {
        .our-history-modern

    {
        padding: 40px 0;
    }

    .timeline-modern {
        padding: 0 16px;
        margin: 24px auto 40px;
    }

        .timeline-modern::before {
            left: 20px;
            transform: none;
        }

    .timeline-item {
        grid-template-columns: 1fr !important;
        gap: 14px !important;
        padding-left: 45px !important;
        margin-bottom: 35px !important;
    }

        .timeline-item:nth-child(odd) .timeline-year-img,
        .timeline-item:nth-child(even) .timeline-year-img {
            grid-column: 1 !important;
            grid-row: 1 !important;
            height: 180px !important;
        }

        .timeline-item:nth-child(odd) .timeline-card,
        .timeline-item:nth-child(even) .timeline-card {
            grid-column: 1 !important;
            grid-row: 2 !important;
            padding: 20px !important;
        }

    .timeline-dot {
        left: 20px !important;
        top: 24px !important;
        transform: translate(-50%, 0) !important;
    }

    .timeline-card h4,
    .timeline-card h5 {
        text-align: left;
    }

    }

    /* Premium Hero Slider Styles */
    .hero-slider {
        position: relative;
        width: 100%;
        height: 500px;
        border-radius: 40px;
        overflow: hidden;
        background-color: #06283F; /* Fallback brand dark navy */
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    .hero-slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transform: scale(1.08);
        transition: opacity 1.2s cubic-bezier(0.4, 0, 0.2, 1), transform 1.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 1.2s;
        pointer-events: none;
    }

        .hero-slide.active {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
            pointer-events: auto;
        }

        .hero-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            border-radius: 40px;
        }

    /* Navigation Arrows */
    .slider-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(6, 40, 63, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        width: 54px;
        height: 54px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .hero-slider:hover .slider-arrow {
        opacity: 1;
        pointer-events: auto;
    }

    .slider-arrow:hover {
        background: #B82025; /* Brand Red */
        border-color: #B82025;
        box-shadow: 0 0 20px rgba(184, 32, 37, 0.4);
        transform: translateY(-50%) scale(1.05);
    }

    .slider-arrow:active {
        transform: translateY(-50%) scale(0.95);
    }

    .prev-arrow {
        left: 24px;
    }

    .next-arrow {
        right: 24px;
    }

    /* Navigation Dots */
    .slider-dots {
        position: absolute;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 10;
        background: rgba(6, 40, 63, 0.3);
        padding: 8px 16px;
        border-radius: 30px;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .slider-dot {
        width: 12px;
        height: 12px;
        border: 2px solid rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        background: transparent;
        cursor: pointer;
        padding: 0;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .slider-dot:hover {
            background: rgba(255, 255, 255, 0.8);
            border-color: rgba(255, 255, 255, 0.8);
        }

        .slider-dot.active {
            width: 32px;
            border-radius: 6px;
            background: #B82025; /* Brand Red */
            border-color: #B82025;
        }

    /* Progress Bar */
    .slider-progress-bar {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 5px;
        background: #B82025; /* Brand Red */
        width: 0%;
        z-index: 12;
        box-shadow: 0 0 10px rgba(184, 32, 37, 0.5);
    }

    /* Responsive Heights */
    @@media (max-width: 992px) {
        .hero-slider {
            height: 400px;
        }

        .slider-arrow {
            width: 46px;
            height: 46px;
            opacity: 1; /* Keep them visible on touch devices */
            pointer-events: auto;
        }

        .prev-arrow {
            left: 16px;
        }

        .next-arrow {
            right: 16px;
        }
    }

    @@media (max-width: 768px) {
        .hero-slider {
            height: 300px;
            border-radius: 24px;
        }

        .hero-slide img {
            border-radius: 24px;
        }

        .slider-arrow {
            display: none; /* Hide arrows on small mobile devices to save space, rely on swipe and dots */
        }

        .slider-dots {
            bottom: 16px;
            padding: 6px 12px;
        }

        .slider-dot {
            width: 8px;
            height: 8px;
        }

            .slider-dot.active {
                width: 24px;
            }
    }
</style>
<style>
    /* ── Section shell ─────────────────────────────────────────── */
    #supplychain {
        /* padding: 0 0 25px; */
    }

        /* Intro block – same rhythm as every other section heading */
        #supplychain .container {
            /* padding-top: 80px; */
            padding-bottom: 48px;
        }

        #supplychain .about-text-regular {
            max-width: 760px;
            color: #586F7E;
            line-height: 1.75;
            margin-bottom: 0;
        }

    /* ── Tab panel wrapper – aligned to the page grid ──────────── */
    .sc2-tabs-wrapper {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 25px;
        background: transparent;
    }

    .sc2-tabs {
        display: flex;
        align-items: stretch;
        height: 480px;
        border-radius: 24px;
        overflow: hidden;
        background: #06283F; /* fallback */
        box-shadow: 0 18px 48px rgba(6, 40, 63, .16);
    }

    /* ── Single tab ────────────────────────────────────────────── */
    .sc2-tab {
        position: relative;
        display: flex; /* lets the inner panel stretch to full height */
        flex-direction: column;
        flex: 1 1 0;
        min-width: 96px;
        cursor: pointer;
        overflow: hidden;
        transition: flex .65s cubic-bezier(.4, 0, .2, 1);
    }

        .sc2-tab.active {
            flex: 5 1 0;
        }

        .sc2-tab:focus-visible {
            outline: none;
            box-shadow: inset 0 0 0 3px #B82025;
        }

    /* Background image */
    .sc2-tab-bg {
        position: absolute;
        inset: 0;
    }

        .sc2-tab-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: saturate(.75);
            transition: transform .65s ease, filter .65s ease;
        }

    .sc2-tab.active .sc2-tab-bg img {
        transform: scale(1.04);
        filter: saturate(1);
    }

    /* Overlay */
    .sc2-tab-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(to top, rgba(6, 40, 63, .95) 0%, rgba(6, 40, 63, .60) 50%, rgba(6, 40, 63, .20) 100%);
        transition: background .4s ease;
    }

    .sc2-tab.active .sc2-tab-overlay {
        background: linear-gradient(to top, rgba(6, 40, 63, .97) 0%, rgba(6, 40, 63, .55) 45%, rgba(184, 32, 37, .15) 100%);
    }

    /* Inner layout */
    .sc2-tab-inner {
        position: relative;
        z-index: 2;
        flex: 1; /* fills the tab height on every breakpoint */
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 40px 36px;
        box-sizing: border-box;
    }

    /* ── COLLAPSED STATE — centred number + vertical label ─────── */
    .sc2-tab-collapsed {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        padding: 24px 0;
        opacity: 1;
        transition: opacity .3s ease;
    }

    .sc2-tab.active .sc2-tab-collapsed {
        display: none;
    }

    .sc2-tab-num {
        position: relative;
        padding-bottom: 14px;
        font-size: 13px;
        font-weight: 800;
        color: #F0575D; /* lifted brand red for contrast on dark imagery */
        letter-spacing: 2px;
    }

        .sc2-tab-num::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: 0;
            width: 22px;
            height: 2px;
            transform: translateX(-50%);
            background: #F0575D;
            opacity: .65;
        }

    .sc2-tab-short {
        font-size: 13px;
        font-weight: 700;
        color: rgba(255, 255, 255, .82);
        text-align: center;
        line-height: 1.2;
        letter-spacing: .16em;
        text-transform: uppercase;
        white-space: nowrap;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        transform: rotate(180deg);
        transition: color .3s ease;
    }

    .sc2-tab:hover .sc2-tab-short {
        color: #fff;
    }

    /* ── EXPANDED STATE ────────────────────────────────────────── */
    .sc2-tab-expanded {
        display: none;
        flex-direction: column;
        max-width: 480px;
        opacity: 0;
        transform: translateY(16px);
        transition: opacity .4s ease .2s, transform .4s ease .2s;
    }

    .sc2-tab.active .sc2-tab-expanded {
        display: flex;
        opacity: 1;
        transform: translateY(0);
    }

    .sc2-tab-tag {
        font-size: 11px;
        font-weight: 700;
        color: #F0575D;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 12px;
    }

    .sc2-tab-title {
        margin: 0 0 18px 0;
        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 900;
        line-height: 1.1;
        color: #fff;
        text-transform: uppercase;
    }

    .sc2-tab-desc {
        max-width: 400px;
        margin: 0 0 28px 0;
        font-size: .875rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, .8);
    }

    .sc2-tab-stat {
        display: flex;
        align-items: baseline;
        gap: 12px;
        max-width: 400px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, .15);
    }

    .sc2-tab-stat-num {
        font-size: 1.75rem;
        font-weight: 900;
        line-height: 1;
