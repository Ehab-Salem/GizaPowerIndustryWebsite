<div class="main-content">
    <section class="page-title-big-typography mt-0 ipad-top-space-margin cover-background background-position-center-bottom position-relative big-section"
             style="background-image: url('@Url.Content("~/assets/GPI Website Visuals/Business Lines/Banner-GPI-Lighting.jpg")')">
        <div class="opacity-extra-medium bg-dark-slate-blue"></div>
        <div class="container">
            <!-- <div class="row align-items-center justify-content-center">
                <div class="col-lg-12 col-md-8 position-relative text-center page-title-extra-large" data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-600 text-white mb-15px">GPI Lighting</h1>
                    <h2 class="mb-0 text-white">
                        OPTIMAL LIGHTING SOLUTIONS TO CREATE ENERGY-EFFICIENT AND AESTHETICALLY PLEASING ENVIRONMENTS
                    </h2>
                </div>
            </div> -->
        </div>
    </section>
    <div class="container mt-3">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-12 col-md-8 position-relative text-center page-title-extra-large" data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-800 mb-15px" style="color: #06283F !important">GPI Lighting</h1>
                    <h2 class="mb-0" style="color: #06283F !important">Optimal lighting solutions to create energy-efficient and aesthetically pleasing environments</h2>
                </div>
            </div>
        </div>
    <section class="ipad-top-space-margin md-pt-0 pt-0 pb-0">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-12 text-center position-relative page-title-double-large">
                    <div class="d-flex flex-column justify-content-center extra-very-small-screen">
                        <h2 class="text-dark-gray d-inline-block fw-400 ls-0px mb-0">
                            At GPI, our Lighting division offers a comprehensive range of innovative and dependable indoor and outdoor lighting solutions designed to meet the highest standards of quality and efficiency. We are dedicated to creating well-engineered, cost-effective, and energy-efficient LED lighting products that are easy for distributors to sell, electricians to install, and end-users to benefit from.
                            Our cutting-edge manufacturing technologies enable us to deliver products that help businesses and communities enhance efficiency, reduce costs, and contribute to a greener environment.
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="big-section" style="padding-top: 0px;padding-bottom: 4rem;">
        <div class="container">
            <div class="row row-cols-1 row-cols-lg-4 row-cols-md-2 g-3 justify-content-center" data-anime='{"el": "childs", "translateY": [0, 0], "perspective": [1000,1200], "scale": [1.1, 1], "rotateX": [50, 0], "opacity": [0,1], "duration": 800, "delay": 200, "staggervalue": 300, "easing": "easeOutQuad" }'>
                <!-- start interactive banner item -->
                <div class="col interactive-banner-style-03 transition-inner-all">
                    <div class="position-relative overflow-hidden border-radius-6px last-paragraph-no-margin">
                        <figure class="m-0">
                            @* asp-controller="Pages" asp-action="Polarix" *@
                            <a  class="h-100 w-100 d-inline-block bg-transparent">
                                <div class="position-absolute top-0px left-0px w-100 h-100 z-index-1"></div>
                                <img src="~/assets/GPI Website Visuals/Business Lines/polarix.jpg" alt="" />
                                <figcaption class="d-flex flex-column w-100 h-100 p-60px lg-p-35px z-index-1 bg-transparent">
                                    <a asp-controller="Pages" asp-action="Polarix" class="align-self-start fs-24 fw-600 ls-1px text-uppercase text-white">
                                        Polarix
                                    </a>
                                </figcaption>
                            </a>
                        </figure>
                    </div>
                </div>

                <div class="col interactive-banner-style-03 transition-inner-all">
                    <div class="position-relative overflow-hidden border-radius-6px last-paragraph-no-margin">
                        <figure class="m-0">
                            @* asp-controller="Pages" asp-action="Aura" *@
                            <a  class="h-100 w-100 d-inline-block bg-transparent">
                                <div class="position-absolute top-0px left-0px w-100 h-100 z-index-1"></div>
                                <img src="~/assets/GPI Website Visuals/Business Lines/aura.jpg" alt="" />
                                <figcaption class="d-flex flex-column w-100 h-100 p-60px lg-p-35px z-index-1 bg-transparent">
                                    <a asp-controller="Pages" asp-action="Aura" class="align-self-start fs-24 fw-600 ls-1px text-uppercase text-white">Aura</a>
                                </figcaption>
                            </a>
                        </figure>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
