@{
    ViewData["Title"] = "Sustainable SupplyChain";
}

<!-- Breadcrumb -->
<section class="supply-chain-breadcrumb">
    <div class="container-fluid" style="margin-left: 60px;">
        <nav class="breadcrumb-nav">
            <a href="index.html">Home</a>
            <i class="fas fa-chevron-right"></i>
            <a href="sustainability.html">Sustainability Centre</a>
            <i class="fas fa-chevron-right"></i>
            <span class="current">Sustainable Supply Chain</span>
        </nav>
    </div>
</section>

<!-- Hero Section -->
<section class="supply-chain-hero">
    <div class="container-fluid">
        <div class="supply-chain-hero-content">
            <div class="supply-chain-hero-left">
                <h1 class="supply-chain-hero-title">
                    SUSTAINABLE<br>
                    <span class="supply-chain-hero-title-red">SUPPLY CHAIN</span>
                </h1>
            </div>
            <div class="supply-chain-hero-right">
                <p class="supply-chain-intro-text">
                    At GPI, we believe that an efficient and transparent supply chain
                    is fundamental to delivering high quality products and services
                    at affordable prices. Our supply chain strategy is built on four
                    key pillars.
                </p>
                <a href="#" class="btn-know-more">
                    <span style="padding-right: 30px;">Know More</span>
                    <div class="icon-circle">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                </a>
            </div>
        </div>

        <div class="supply-chain-hero-image-container">
            <div class="supply-chain-hero-image">
                <img src="~/assets/images/foundation-qa.png" alt="Sustainable Supply Chain">
                <div class="supply-chain-hero-image-overlay"></div>
                <div class="outline-text-sustainability" style="
            position: absolute;
            top: 60%;
            left:50%;
            transform: translate(-50%, -50%);
            text-align: center;
            width: 100%;">
                    @* SUSTAINABILITY  *@
                    Supply Chain
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pillars Section -->
<section class="supply-chain-pillars">
    <div class="container-fluid">
        <div class="supply-chain-pillars-header">
            <p class="supply-chain-pillars-label">Sustainability</p>
            <h2 class="supply-chain-pillars-title">
                Pillars of<br>
                <span class="title-outline">Our Supply Chain</span>
            </h2>
        </div>

        <div class="supply-chain-pillars-grid">
            <!-- Card 1: Backward Integration - Red Card -->
            <div class="supply-chain-pillar-card pillar-red-card">
                <div class="pillar-card-content">
                    <h3>BACKWARD<br>INTEGRATION</h3>
                    <p>
                        We integrate key industries that support cable manufacturing to reduce costs and offer
                        competitive pricing.
                    </p>
                </div>
            </div>

            <!-- Card 2: Advanced Manufacturing 1 - Image Card -->
            <div class="supply-chain-pillar-card pillar-image-card">
                <img src="~/assets/images/pillar-turbines-sunset.jpg" alt="Backward Integration Visual">
            </div>

            <!-- Card 3: Advanced Manufacturing 2 - Text Card -->
            <div class="supply-chain-pillar-card pillar-white-card">
                <div class="pillar-card-content">
                    <h3>ADVANCED<br>MANUFACTURING</h3>
                    <p>
                        Using state-of-the-art facilities, we ensure precision, consistency, and continuous
                        innovation.
                    </p>
                </div>
            </div>

            <!-- Card 4: Advanced Manufacturing 3 - Image Card -->
            <div class="supply-chain-pillar-card pillar-image-card">
                <img src="~/assets/images/pillar-globe-plant.jpg" alt="Advanced Manufacturing Visual">
            </div>

            <!-- Card 5: Global Sourcing 1 - Image Card -->
            <div class="supply-chain-pillar-card pillar-image-card">
                <img src="~/assets/images/pillar-lightbulb.jpg" alt="Global Sourcing Visual">
            </div>

            <!-- Card 6: Global Sourcing 2 - Text Card -->
            <div class="supply-chain-pillar-card pillar-white-card">
                <div class="pillar-card-content">
                    <h3>GLOBAL<br>SOURCING</h3>
                    <p>
                        We source premium raw materials from trusted international suppliers to meet stringent
                        standards.
                    </p>
                </div>
            </div>

            <!-- Card 7: Logistics & Distribution 1 - Image Card -->
            <div class="supply-chain-pillar-card pillar-image-card">
                <img src="~/assets/images/pillar-hill-tree.jpg" alt="Logistics & Distribution Visual">
            </div>

            <!-- Card 8: Logistics & Distribution 2 - Text Card -->
            <div class="supply-chain-pillar-card pillar-white-card">
                <div class="pillar-card-content">
                    <h3>LOGISTICS &<br>DISTRIBUTION</h3>
                    <p>
                        A robust logistics network with real-time tracking ensures timely and efficient product
                        delivery.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
