<script>
    // Your certificate data (from C# or JS)
    const certificates = [
      { Title: "Environmental Management System<br>System", IsoTag: "ISO 14001", BadgeImg: "~/assets/ISOCertificates/14001.jpg", PdfUrl: "~/assets/ISOCertificates/14001.pdf" },
      { Title: "Quality Management<br>System", IsoTag: "ISO 9001", BadgeImg: "~/assets/ISOCertificates/9001.jpg", PdfUrl: "~/assets/ISOCertificates/9001.pdf" },
      { Title: "Occupational Health & Safety Management<br>System ", IsoTag: "ISO 45001", BadgeImg: "~/assets/ISOCertificates/45001.jpg", PdfUrl: "~/assets/ISOCertificates/45001.pdf" },
      { Title: "Energy Management <br> System ", IsoTag: "ISO 50001", BadgeImg: "~/assets/ISOCertificates/50001.jpg", PdfUrl: "~/assets/ISOCertificates/50001.pdf" },
      { Title: "BASEC PCR", IsoTag: "BASEC PCR-147", BadgeImg: "~/assets/ISOCertificates/Basec.jpg", PdfUrl: "~/assets/ISOCertificates/Basec.pdf" },
      { Title: "BASEC 13501-6:2014 certificate 1", IsoTag: "BASEC T1CPRT2376-1", BadgeImg: "~/assets/ISOCertificates/Basec2.jpg", PdfUrl: "~/assets/ISOCertificates/Basec2.pdf" },
      { Title: "BASEC 13501-6:2014 certificate 2", IsoTag: "BASEC T1CPRT2376-2", BadgeImg: "~/assets/ISOCertificates/Basec3.jpg", PdfUrl: "~/assets/ISOCertificates/Basec3.pdf" },
      { Title: "BASEC 13501-6:2014 certificate 3", IsoTag: "BASEC T1CPRT2376-3", BadgeImg: "~/assets/ISOCertificates/Basec4.jpg", PdfUrl: "~/assets/ISOCertificates/Basec4.pdf" },
      { Title: "BASEC 13501-6:2014 certificate 4", IsoTag: "BASEC T1CPRT2376-4", BadgeImg: "~/assets/ISOCertificates/Basec5.jpg", PdfUrl: "~/assets/ISOCertificates/Basec5.pdf" },
      { Title: "Certificate of Product Approval", IsoTag: "BASEC 254/001/001", BadgeImg: "~/assets/ISOCertificates/Basec7.jpg", PdfUrl: "~/assets/ISOCertificates/Basec7.pdf" },
      { Title: "Types and Ranges Approval", IsoTag: "BASEC 254/001/001", BadgeImg: "~/assets/ISOCertificates/Basec8.jpg", PdfUrl: "~/assets/ISOCertificates/Basec8.pdf" },
      { Title: "CENTRAL POWER RESEARCH INSTITUTE", IsoTag: "CPRI", BadgeImg: "~/assets/ISOCertificates/cpri.jpg", PdfUrl: "~/assets/ISOCertificates/cpri.pdf" },
      { Title: "Arab Republic of Egypt", IsoTag: "EGAC", BadgeImg: "~/assets/ISOCertificates/arab.jpg", PdfUrl: "~/assets/ISOCertificates/arab.pdf" },
      { Title: "KEMA REPORT OF PERFORMANCE", IsoTag: "KEMA 1491-21", BadgeImg: "~/assets/ISOCertificates/kema2.jpg", PdfUrl: "~/assets/ISOCertificates/kema2.pdf" },
      { Title: "KEMA REPORT OF PERFORMANCE", IsoTag: "KEMA 1492-21", BadgeImg: "~/assets/ISOCertificates/kema.jpg", PdfUrl: "~/assets/ISOCertificates/kema.pdf" },
      { Title: "KEMA REPORT OF PERFORMANCE", IsoTag: "KEMA Labs 1491-21", BadgeImg: "~/assets/ISOCertificates/kemalab2.jpg", PdfUrl: "~/assets/ISOCertificates/kemalab2.pdf" },
      { Title: "KEMA REPORT OF PERFORMANCE", IsoTag: "KEMA Labs 1492-21", BadgeImg: "~/assets/ISOCertificates/kemalab.jpg", PdfUrl: "~/assets/ISOCertificates/kemalab.pdf" }
    ];

    // Function to render cards inside the grid
    function renderCertificates() {
      const container = document.getElementById('certScrollContainer');
      if (!container) return;

      let html = '';
      for (const cert of certificates) {
        html += `
          <div class="qhse-cert-card-new">
            <img src="${cert.BadgeImg.replace(/^~/, '')}" alt="${cert.IsoTag}" class="cert-bg">
            <div class="cert-overlay">
              <div class="cert-top">
              </div>
              <div class="cert-bottom">
                <h3>${cert.Title}</h3>
                <div class="cert-footer">
                  <span class="iso-tag">${cert.IsoTag}</span>
                  <a href="${cert.PdfUrl.replace(/^~/, '')}" class="cert-arrow-btn" target="_blank">
                        <i class="fas fa-download"></i>
                    </a>
                </div>
              </div>
            </div>
          </div>
        `;
      }
      container.innerHTML = html;
    }

    // Scroll functionality
    function initSlider() {
      const container = document.getElementById('certScrollContainer');
      const prevBtn = document.querySelector('.slider-btn.prev');
      const nextBtn = document.querySelector('.slider-btn.next');

      if (!container || !prevBtn || !nextBtn) return;

      // Scroll amount = one card width + gap
      const getScrollAmount = () => {
        const card = container.querySelector('.qhse-cert-card-new');
        if (!card) return 300; // fallback
        const cardWidth = card.offsetWidth;
        const gap = parseInt(getComputedStyle(container).gap) || 24;
        return cardWidth + gap;
      };

      prevBtn.addEventListener('click', () => {
        const amount = getScrollAmount();
        container.scrollBy({ left: -amount, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        const amount = getScrollAmount();
        container.scrollBy({ left: amount, behavior: 'smooth' });
      });
    }

    // Run when page loads
    document.addEventListener('DOMContentLoaded', () => {
      renderCertificates();
      initSlider();
    });
</script>