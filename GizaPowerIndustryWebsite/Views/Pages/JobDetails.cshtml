@model GizaPowerIndustryWebsite.Models.VacancyDetailsViewModel

@{
    ViewData["Title"] = Model.JobTitle;
}
<style>
    .sustainability-hero {
        position: relative;
        width: 100%;
        height: 70vh;
        overflow: hidden;
        padding-top: 0 !important;
    }

    .sustainability-hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

        .sustainability-hero-bg img {
            width: 800%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .sustainability-hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .sustainability-hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 3;
        text-align: center;
        width: 100%;
    }

    .sustainability-hero-title {
        color: #fff;
        font-size: 72px;
        font-weight: 700;
        letter-spacing: 6px;
        font-family: Arial, sans-serif;
    }

    @@media (max-width: 768px) {
        .sustainability-hero-title {
            font-size: 42px;
        }
    }
    /* Responsive adjustment */
    @@media (max-width: 768px) {
        .sustainability-hero {
            height: 55vh;
        }

        .sustainability-hero-title {
            font-size: 2.2rem;
        }

        .sustainability-hero-subtitle {
            font-size: 1rem;
        }
    }
    /* Main title – bold, sentence case */
    .sustainability-hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        color: #fff;
        margin: 0 0 1rem;
        line-height: 1.1;
        text-transform: none;
    }

    /*Subtitle–light,supportive*/
    .sustainability-hero-subtitle {
        font-size: clamp(1rem, 2.5vw, 1.4rem);
        font-weight: 300;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
        line-height: 1.6;
        text-transform: none;
    }
    /*Responsive adjustment*/
    @@media (max-width: 768px) {
        .sustainability-hero {
            height: 55vh;
        }

        .sustainability-hero-title {
            font-size: 2.2rem;
        }

        .sustainability-hero-subtitle {
            font-size: 1rem;
        }
    }

    /* =========================================================
       APPLY SHEET — in-page slide-in panel (replaces navigation
       to a separate Apply page)
       ========================================================= */

    /* Fallback value; overridden at runtime by JS with the real
       header height so the sheet/overlay never sit on top of it. */
    :root {
        --header-height: 80px;
    }

    .apply-sheet-overlay {
        position: fixed;
        top: var(--header-height);
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(6, 40, 63, 0.55);
        z-index: 900;
        opacity: 0;
        pointer-events: none;
        transition: opacity .25s ease;
    }

        .apply-sheet-overlay.is-open {
            opacity: 1;
            pointer-events: auto;
        }

    .apply-sheet {
        position: fixed;
        top: var(--header-height);
        right: 0;
        height: calc(100% - var(--header-height));
        width: min(560px, 100%);
        background: #fff;
        z-index: 901;
        box-shadow: -8px 0 30px rgba(0,0,0,.15);
        transform: translateX(100%);
        transition: transform .3s ease;
        display: flex;
        flex-direction: column;
    }

        .apply-sheet.is-open {
            transform: translateX(0);
        }

    .apply-sheet-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.5rem 1.75rem;
        border-bottom: 1px solid #eceef1;
        flex-shrink: 0;
    }

    .apply-sheet-heading {
        margin: 0;
    }

    .apply-sheet-title {
        margin: 0 0 .25rem;
        font-size: 1.4rem;
        font-weight: 700;
        color: #1a2b4c;
    }

    .apply-sheet-subtitle {
        margin: 0;
        font-size: .9rem;
        color: #5a6472;
    }

    .apply-sheet-close {
        background: #f4f5f7;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #1a2b4c;
        font-size: 1rem;
        flex-shrink: 0;
        transition: background .15s ease, color .15s ease;
    }

        .apply-sheet-close:hover {
            background: #c0392b;
            color: #fff;
        }

    .apply-sheet-body {
        padding: 1.75rem;
        overflow-y: auto;
        flex: 1;
    }

    body.apply-sheet-locked {
        overflow: hidden;
    }

    /* Reused apply-form styling (matches the standalone Apply page) */
    .apply-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.1rem 1.25rem;
    }

    .apply-field-full {
        grid-column: 1 / -1;
    }

    .apply-label {
        display: block;
        font-weight: 600;
        color: #1a2b4c;
        margin-bottom: .4rem;
        font-size: .9rem;
    }

    .apply-input {
        width: 100%;
        padding: .7rem .9rem;
        border: 1px solid #d9dde3;
        border-radius: 8px;
        font-size: .95rem;
        font-family: inherit;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .apply-input:focus {
            outline: none;
            border-color: #c0392b;
            box-shadow: 0 0 0 3px rgba(192,57,43,.12);
        }

    .apply-field-error {
        color: #c0392b;
        font-size: .8rem;
        margin-top: .3rem;
        display: block;
        min-height: 1em;
    }

    .apply-error-banner, .apply-success-banner {
        border-radius: 8px;
        padding: .9rem 1.1rem;
        margin-bottom: 1.25rem;
        font-weight: 500;
        font-size: .9rem;
        display: none;
    }

    .apply-error-banner {
        background: #fdeceb;
        color: #c0392b;
        border: 1px solid #f3b8b3;
    }

    .apply-success-banner {
        background: #e9f7ef;
        color: #1e7e42;
        border: 1px solid #b7e4c7;
    }

    .apply-file-input {
        display: none;
    }

    .apply-file-drop {
        display: flex;
        align-items: center;
        gap: .6rem;
        border: 1.5px dashed #c7ccd4;
        border-radius: 8px;
        padding: 1rem;
        cursor: pointer;
        color: #5a6472;
        font-size: .88rem;
        transition: border-color .15s ease, background .15s ease;
    }

        .apply-file-drop:hover {
            border-color: #c0392b;
            background: #fdf6f5;
        }

        .apply-file-drop i {
            color: #c0392b;
            font-size: 1.2rem;
        }

    .apply-submit-btn {
        margin-top: 1.75rem;
        border: none;
        cursor: pointer;
        width: 100%;
        justify-content: center;
    }

        .apply-submit-btn[disabled] {
            opacity: .65;
            cursor: not-allowed;
        }

    .apply-sheet-success-state {
        display: none;
        text-align: center;
        padding: 2rem 0;
    }

        .apply-sheet-success-state .apply-success-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #e9f7ef;
            color: #1e7e42;
            font-size: 1.8rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .apply-sheet-success-state h3 {
            margin: 0 0 .5rem;
            color: #1a2b4c;
        }

        .apply-sheet-success-state p {
            color: #5a6472;
            margin: 0 0 1.5rem;
        }

    @@media (max-width: 640px) {
        .apply-form-grid {
            grid-template-columns: 1fr;
        }

        .apply-sheet {
            width: 100%;
        }
    }
</style>
<!-- Hero Section -->
<section class="sustainability-hero" style="border-radius:0px">
    <!-- Background Image -->
    <div class="sustainability-hero-bg">
        <img src="~/assets/GPI Website Visuals/Careers/Job Description.jpg" alt="Careers">
    </div>
    <!-- Dark overlay for readability -->
    <div class="sustainability-hero-overlay"></div>

    <!-- Centred text content -->
    <div class="job-hero-content">
        <h1 class="job-hero-title">@Model.JobTitle</h1>
    </div>
</section>
