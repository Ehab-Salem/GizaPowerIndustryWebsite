    <div class="container">
        <div class="market-grid">
            <div class="market-content" data-reveal="left">
                <p class="about-label" style="font-size: 16px;">Our Partners</p>
                <h2 class="market-title">
                    <span class="text-red">Expanding</span> Our<br>Market Reach
                </h2>
