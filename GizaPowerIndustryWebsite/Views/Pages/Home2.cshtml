            </div>

            <div class="partner-cards" data-reveal-group>
                <div class="partner-card">
                    <div class="partner-logo-box">
                        <img src="~/assets/images/Component 1.svg" alt="Partner Logo" class="logo-main">
                        <img src="~/assets/images/partner-emblem-color.png" alt="Alternate Logo" class="logo-alternate">
                    </div>
                </div>
                <div class="partner-card">
                    <div class="partner-logo-box">
                        <img src="~/assets/images/Component 1.svg" alt="Partner Logo" class="logo-main">
                        <img src="~/assets/images/partner-emblem-color.png" alt="Alternate Logo" class="logo-alternate">
                    </div>
                </div>
                <div class="partner-card">
                    <div class="partner-logo-box">
                        <img src="~/assets/images/Component 1.svg" alt="Partner Logo" class="logo-main">
                        <img src="~/assets/images/partner-emblem-color.png" alt="Alternate Logo" class="logo-alternate">
                    </div>
                </div>
                <div class="partner-card">
                    <div class="partner-logo-box">
                        <img src="~/assets/images/Component 1.svg" alt="Partner Logo" class="logo-main">
                        <img src="~/assets/images/partner-emblem-color.png" alt="Alternate Logo" class="logo-alternate">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Business Lines Section -->
<section class="business-section" id="business">
    <div class="business-grid">
        <div class="business-visual" data-reveal="left">
            <img src="~/assets/images/business-hero.jpg" alt="GPI Manufacturing Facility">
        </div>
        <div class="business-content" data-reveal="right">
            <div class="business-text-wrapper">
                <p class="business-label">Business Lines</p>
                <h2 class="business-title" style="font-weight:800">Cables & Wires</h2>
