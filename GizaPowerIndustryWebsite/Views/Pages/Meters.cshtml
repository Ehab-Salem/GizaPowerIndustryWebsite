@{
    var meters = new[]
    {
        new
        {
            Id = "GPM-PC01",
            Title = "SINGLE PHASE METERS",
            Img = "~/assets/imgs/meters/single-phase-prepaid-connected.jpg",
            Link = Url.Action(
                "SinglePhaseMeters",
                "Pages",
                new
                {
                    Name = "SINGLE PHASE PREPAID CONNECTED ENERGY METER",
                    Img = "single-phase-prepaid-connected.jpg"
                })
        },

        new
        {
            Id = "GPM-PC03",
            Title = "THREE-PHASE METERS",
            Img = "~/assets/imgs/meters/Therre.png",
            Link = Url.Action(
                "ThreePhaseMeters",
                "Pages",
                new
                {
                    Name = "THREE-PHASE PREPAID CONNECTED METERS",
                    Img = "Therre.png"
                })
        },
    };
}

<div class="main-content">
    <!-- start page title -->
    <section class="page-title-big-typography ipad-top-space-margin cover-background background-position-center-bottom position-relative big-section"
             style="background-image:url('@Url.Content("~/assets/GPI Website Visuals/Business Lines/Meters/meter-(1).jpg")')">
        <div class="opacity-extra-medium bg-dark-slate-blue"></div>

        <div class="container">
            <!-- <div class="row align-items-center justify-content-center">
                <div class="col-lg-6 col-md-8 position-relative text-center page-title-extra-large"
                     data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-600 text-white mb-15px" local="FiberOpticProducts">GPI Smart Meters</h1>
                    <h2 class="mb-0 text-white">OPTIMIZE ENERGY USAGE AND IMPROVE OPERATIONAL EFFICIENCY WITH ADVANCED METERING TECHNOLOGIES FOR ACCURATE AND RELIABLE DATA COLLECTION</h2>
                </div>
            </div> -->
        </div>
    </section>
    <!-- end page title -->
    <div class="container mt-3">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-12 col-md-8 position-relative text-center page-title-extra-large" data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-800 mb-15px" style="color: #06283F !important">GPI Smart Meters</h1>
                    <h2 class="mb-0" style="color: #06283F !important">OPTIMIZE ENERGY USAGE AND IMPROVE OPERATIONAL EFFICIENCY WITH ADVANCED METERING TECHNOLOGIES FOR ACCURATE AND RELIABLE DATA COLLECTION</h2>
                </div>
            </div>
        </div>
    <!-- start page title -->
    <section class="ipad-top-space-margin md-pt-0 pt-0 pb-0">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-12 text-center position-relative page-title-double-large">
                    <div class="d-flex flex-column justify-content-center extra-very-small-screen">
                        <h2 class="text-dark-gray d-inline-block fw-400 ls-0px mb-0">
                            The GPI Meters plant was established in 2022 to meet the "Egypt 2030" vision, especially with the growing domestic and global demand for smart and prepaid electricity meters.
                            The plant was built on a total area of 5000 square meters and is equipped with modern production lines with a production capacity of up to 3 million meters per year that can be doubled to 6 million meters per year to meet the growing local and global demand for smart grid solutions. Thanks to our collaboration with international companies and offices, our advanced meter technologies and designs provide accurate and reliable data collection for energy usage optimization and operational efficiency improvement.
                        </h2>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end page title -->
    <!-- start section -->
    <section class="big-section ps-7 pe-7 xxl-ps-3 xxl-pe-3 xs-px-0" style="padding-top:0px; padding-bottom:4rem">
        <div class="container-fluid">
            <div class="row row-cols-1 row-cols-xl-4 row-cols-md-2 row-cols-sm-2 justify-content-center"
                 data-anime='{ "el": "childs", "translateX": [30, 0], "opacity": [0,1], "duration": 800, "delay": 200, "staggervalue": 300, "easing": "easeOutQuad" }'>

                @foreach (var meter in meters)
                {
                    <!-- start interactive banner item -->
                    <div class="col interactive-banner-style-05 position-relative z-index-1 mb-30px">
                        <div class="atropos">
                            <a href="@meter.Link" class="position-absolute z-index-1 top-0px left-0px h-100 w-100"></a>
                            <div class="atropos-scale">
                                <div class="atropos-rotate">
                                    <div class="atropos-inner">
                                        <figure class="m-0 hover-box border-radius-8px overflow-hidden position-relative" data-atropos-offset="3">
                                            <img class="w-100" src="@Url.Content(meter.Img)" alt="@meter.Title" />
                                            <figcaption class="d-flex flex-column align-items-start justify-content-center position-absolute left-0px top-0px w-100 h-100 z-index-1 p-15 xl-p-12 last-paragraph-no-margin">
                                                <div class="mb-auto bg-red fw-500 text-white text-uppercase border-radius-30px ps-20px pe-20px fs-13">@meter.Id</div>
                                                <span class="text-white fw-500 fs-22 sm-lh-26 xs-lh-28 sm-mb-5px">@meter.Title</span>
                                                <div class="position-absolute left-0px top-0px w-100 h-100 bg-gradient-gray-light-dark-transparent z-index-minus-1 opacity-9"></div>
                                                <div class="box-overlay bg-gradient-gray-light-dark-transparent z-index-minus-1"></div>
                                            </figcaption>
                                        </figure>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>