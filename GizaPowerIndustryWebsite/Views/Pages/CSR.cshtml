@{
    ViewData["Title"] = "CSR";
}
 <!-- Breadcrumb -->
<section class="qa-breadcrumb">
    <div class="container-fluid">
        <nav class="breadcrumb-nav">
            <a href="index.html">Home</a>
            <i class="fas fa-chevron-right"></i>
            <a href="sustainability.html">Sustainability Centre</a>
            <i class="fas fa-chevron-right"></i>
            <span class="current">Corporate Social Responsibility (CSR)</span>
        </nav>
    </div>
</section>
<!-- Hero Section -->
<section class="qa-hero">
    <div class="container-fluid">
        <div class="qa-hero-content">
            <div class="qa-hero-left">
                <h1 class="qa-hero-title">
                    CORPORATE SOCIAL<br>
                    <span class="qa-hero-title-red">RESPONSIBILITY (CSR)</span>
                </h1>
            </div>
            <div class="qa-hero-right">
                <p class="qa-intro-text">
                    At GPI, we are dedicated to making a positive impact on the environment and communities
                    we operate in. Our CSR initiatives focus on sustainability, community engagement, and ethical
                    practices.
                </p>
                <a href="#" class="btn-know-more">
                    <span style="padding-right: 30px;">Know More</span>
                    <div class="icon-circle">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                </a>
            </div>
        </div>

        <div class="qa-hero-image-container">
            <img src="~/assets/images/foundation-csr.jpg" alt="Quality Assurance & Certifications">
            <div class="qa-hero-image-overlay"></div>
            <div class="outline-text-sustainability">SUSTAINABILITY</div>
        </div>
    </div>
</section>
<!-- CSR Initiatives Section -->
<section class="csr-initiatives">
    <div class="container-fluid" style="padding: 0 80px;">
        <div class="csr-initiatives-header">
            <span class="csr-label-top">Sustainability</span>
            <h2 class="csr-main-title">Our CSR<br>initiatives focus on</h2>
        </div>

        <div class="csr-initiatives-grid">
            <!-- Row 1 -->
            <div class="csr-card csr-card-red">
                <h3 class="csr-card-title">SUSTAINABILITY</h3>
                <p class="csr-card-desc">
                    Implementing eco-friendly manufacturing processes and reducing our carbon
                    footprint.
                </p>
            </div>
            <div class="csr-card csr-card-image">
                <img src="~/assets/images/csr-initiative-windmills.jpg" alt="Sustainability Initiative">
            </div>
            <div class="csr-card csr-card-white">
                <h3 class="csr-card-title">COMMUNITY ENGAGEMENT</h3>
                <p class="csr-card-desc">
                    Supporting local communities through charitable initiatives, education
                    programs, and volunteer work.
                </p>
            </div>

            <!-- Row 2 -->
            <div class="csr-card csr-card-image">
                <img src="~/assets/images/csr-initiative-hand-bulb.jpg" alt="Ethical Practices Initiative">
            </div>
            <div class="csr-card csr-card-white">
                <h3 class="csr-card-title">ETHICAL PRACTICES</h3>
                <p class="csr-card-desc">
                    Upholding the highest standards of integrity, transparency, and ethical
                    behavior in all our business operations.
                </p>
            </div>
            <div class="csr-card csr-card-image">
                <img src="~/assets/images/csr-initiative-tree-hill.jpg" alt="Environmental Caring Initiative">
            </div>
        </div>
    </div>
</section>