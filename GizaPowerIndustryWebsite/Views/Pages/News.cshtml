@{
    ViewData["Title"] = "News";
}
<style>
    /* ===== Latest News Grid – Responsive ===== */
    .latest-news-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }

    /* --- Featured Article --- */
    .featured-article {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

    .featured-article-image-container {
        position: relative;
        height: 100%;
        min-height: 400px;
    }

        .featured-article-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .featured-article-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.2) 60% );
        border-radius: 12px;
    }

    .featured-article-content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 2rem;
        color: #fff;
    }

    .article-badge {
        display: inline-block;
        background: #B82025;
        color: #fff;
        padding: 0.25rem 1rem;
        border-radius: 50px;
        font-size: 25px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 1rem;
    }

    .featured-article-title {
        font-size: clamp(1.25rem, 3vw, 2rem);
        font-weight: 800;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .featured-article-excerpt {
        font-size: 0.95rem;
        line-height: 1.7;
        opacity: 0.9;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* --- Side Articles List --- */
    .side-articles-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .side-article-item {
        display: flex;
        gap: 1.5rem;
        background: #fff;
        border: 1px solid #F3F4F6;
        border-radius: 12px;
        overflow: hidden;
        transition: box-shadow 0.3s;
    }

        .side-article-item:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }

    .side-article-img-box {
        position: relative;
        width: 180px;
        flex-shrink: 0;
    }

        .side-article-img-box img {
            width: 100%;
            height: 100%;
            display: block;
        }

    .side-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    }

    .side-article-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #B82025;
        color: #fff;
        padding: 0.2rem 0.8rem;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .side-article-text {
        padding: 1.25rem 1.25rem 1.25rem 0;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .side-article-date {
        font-size: 0.8rem;
        color: #9CA3AF;
        margin-bottom: 0.5rem;
    }

    .side-article-title {
        font-size: 1rem;
        font-weight: 700;
        color: #06283F;
        margin: 0 0 0.5rem;
        line-height: 1.4;
    }

    .side-article-excerpt {
        font-size: 0.875rem;
        color: #6B7280;
        line-height: 1.6;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0 0 0.75rem;
    }

    .read-more-link {
        font-size: 0.85rem;
        font-weight: 600;
        color: #B82025;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: gap 0.2s;
    }

        .read-more-link:hover {
            gap: 0.7rem;
        }

    /* ===== Responsive Breakpoints ===== */

    /* Tablets */
    @@media (max-width: 992px) {
        .latest-news-grid {
            grid-template-columns: 1fr;
        }

        .featured-article-image-container {
            min-height: 300px;
        }

        .side-article-item {
            flex-direction: column;
        }

        .side-article-img-box {
            width: 100%;
            height: 200px;
        }

        .side-article-text {
            padding: 1.25rem;
        }
    }

    /* Mobiles */
    @@media (max-width: 600px) {
        .latest-news-grid {
            gap: 1.5rem;
        }

        .featured-article-content {
            padding: 1.5rem;
        }

        .featured-article-image-container {
            min-height: 250px;
        }

        .side-article-img-box {
            height: 180px;
        }
    }

    /* Section Header Style matching Home.cshtml */
    .about-label {
        font-weight: 900;
        font-size: 40px;
        color: #a3191e;
        margin-top: 24px !important;
        margin-bottom: 0px !important;
        line-height: 1.2;
    }

    .hero-small {
        font-size: 24px;
        font-weight: 700;
        color: #06283f;
        display: block;
        line-height: 1.3;
        margin-top: 6px;
    }

    @@media (max-width: 768px) {
        .about-label {
            font-size: 30px !important;
        }
        .hero-small {
            font-size: 18px !important;
        }
    }
</style>

<!-- ============================================================
     COMPANY LIFE / INTERNSHIP SPOTLIGHT — styles
     Scoped locally so it doesn't collide with anything global.
============================================================= -->
<style>
    .spotlight-section {
        padding: 1rem 0 3rem;
    }

    .spotlight-card {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        background: #fff;
        border: 1px solid #F3F4F6;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(6,40,63,0.07);
    }

    .spotlight-media {
        position: relative;
        min-height: 360px;
        cursor: pointer;
        overflow: hidden;
    }

        .spotlight-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.5s ease;
        }

        .spotlight-media:hover img {
            transform: scale(1.05);
        }

    .spotlight-media-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(6,40,63,0) 55%, rgba(6,40,63,0.55) 100%);
    }

    .spotlight-count-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(6,40,63,0.72);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 50px;
        backdrop-filter: blur(2px);
    }

    .spotlight-expand {
        position: absolute;
        right: 16px;
        bottom: 16px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255,255,255,0.92);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.25s ease, transform 0.25s ease;
    }

        .spotlight-expand svg {
            width: 18px;
            height: 18px;
            stroke: #B82025;
            fill: none;
            stroke-width: 2;
        }

    .spotlight-media:hover .spotlight-expand {
        opacity: 1;
        transform: translateY(0);
    }

    .spotlight-content {
        padding: 2.4rem 2.6rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.9rem;
    }

    .spotlight-title {
        font-size: clamp(1.35rem, 2.4vw, 1.9rem);
        font-weight: 800;
        color: #06283F;
        line-height: 1.28;
        margin: 0;
    }

    .spotlight-desc {
        font-size: 0.95rem;
        line-height: 1.7;
        color: #6B7280;
        margin: 0;
    }

    .spotlight-view-btn {
        appearance: none;
        border: none;
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #B82025;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 7px 13px;
        border-radius: 50px;
        cursor: pointer;
        transition: gap 0.2s ease, background 0.2s ease;
        margin-top: 0.3rem;
    }

        .spotlight-view-btn:hover {
            gap: 0.85rem;
            background: #8f1519;
        }

    .spotlight-thumbs {
        display: flex;
        gap: 10px;
        margin-top: 0.6rem;
    }

    .spotlight-thumb {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        object-fit: cover;
        cursor: pointer;
        border: 2px solid transparent;
        opacity: 0.75;
        transition: opacity 0.2s ease, border-color 0.2s ease;
    }

        .spotlight-thumb:hover {
            opacity: 1;
            border-color: #B82025;
        }

    @@media (max-width: 900px) {
        .spotlight-card {
            grid-template-columns: 1fr;
        }

        .spotlight-media {
            min-height: 280px;
        }

        .spotlight-content {
            padding: 1.8rem;
        }
    }

    /* ---------- lightbox / carousel ---------- */
    .il-lightbox {
        position: fixed;
        inset: 0;
        background: rgba(6,40,63,0.88);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 24px;
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
    }

        .il-lightbox.open {
            display: flex;
        }

    .il-lightbox-inner {
        max-width: 900px;
        width: 100%;
        background: #101820;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0,0,0,0.55);
    }

    .il-lightbox-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background: rgba(0,0,0,0.4);
        border: none;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        cursor: pointer;
        padding: 8px 12px;
        border-radius: 50px;
        z-index: 20;
        transition: background 0.2s ease;
    }

        .il-lightbox-close:hover {
            background: rgba(0,0,0,0.7);
        }

    .il-stage {
        position: relative;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 320px;
    }

        .il-stage img {
            width: 100%;
            max-height: 62vh;
            object-fit: contain;
            display: block;
        }

    .il-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(0,0,0,0.45);
        border: none;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 15;
        transition: background 0.2s ease, transform 0.2s ease;
    }

        .il-nav:hover {
            background: rgba(184,32,37,0.85);
            transform: translateY(-50%) scale(1.06);
        }

        .il-nav svg {
            width: 18px;
            height: 18px;
            fill: #fff;
        }

    .il-prev {
        left: 14px;
    }

    .il-next {
        right: 14px;
    }

    .il-counter {
        position: absolute;
        top: 14px;
        left: 14px;
        font-size: 0.75rem;
        color: #fff;
        background: rgba(0,0,0,0.45);
        padding: 5px 10px;
        border-radius: 50px;
        z-index: 15;
    }

    .il-thumbs {
        display: flex;
        gap: 8px;
        padding: 12px 16px;
        background: #101820;
        overflow-x: auto;
    }

    .il-thumb {
        flex: 0 0 auto;
        width: 56px;
        height: 56px;
        border-radius: 6px;
        overflow: hidden;
        border: 2px solid transparent;
        opacity: 0.55;
        cursor: pointer;
        transition: opacity 0.2s ease, border-color 0.2s ease;
    }

        .il-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .il-thumb.active {
            opacity: 1;
            border-color: #B82025;
        }

    .sustainability-hero {
        position: relative;
        width: 100%;
        height: 70vh;
        overflow: hidden;
        padding-top: 0 !important;
    }

    .sustainability-hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .sustainability-hero-bg img {
        width: 800%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .sustainability-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgb(6 40 63 / 27%), rgb(6 40 63 / 71%));
        z-index: 1;
    }

    .sustainability-hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 3;
        text-align: center;
        width: 100%;
    }

    .sustainability-hero-title {
        color: #fff;
        font-size: 72px;
        font-weight: 700;
        letter-spacing: 6px;
        font-family: Arial, sans-serif;
    }

    @@media (max-width: 768px) {
        .sustainability-hero-title {
            font-size: 42px;
        }
    }
    /* Responsive adjustment */
    @@media (max-width: 768px) {
        .sustainability-hero {
            height: 55vh;
        }

        .sustainability-hero-title {
            font-size: 2.2rem;
        }

        .sustainability-hero-subtitle {
            font-size: 1rem;
        }

        .featured-article-title
        {
            line-height: 1 !important;
        }
    }
    /* Main title – bold, sentence case */
    .sustainability-hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        color: #fff;
        margin: 0 0 1rem;
        line-height: 1.1;
        text-transform: none; /* sentence case */
    }

    /* Subtitle – light, supportive */
    .sustainability-hero-subtitle {
        font-size: clamp(1rem, 2.5vw, 1.4rem);
        font-weight: 300;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
        line-height: 1.6;
        text-transform: none;
    }
    /* Responsive adjustment */
    @@media (max-width: 768px) {
        .sustainability-hero {
            height: 55vh;
        }

        .sustainability-hero-title {
            font-size: 2.2rem;
        }

        .sustainability-hero-subtitle {
            font-size: 1rem;
        }
    }
</style>

