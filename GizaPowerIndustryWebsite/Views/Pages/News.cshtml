<script>
    /* ============================================================
       Internship gallery — simple single-item carousel.
       Static array for now; swap for @@Html.Raw(Json.Serialize(...))
       if/when this comes from the database like the Media page does.
    ============================================================= */
    const ilMedia = [
        { src: '@Url.Content("~/assets/images/inter1.jfif")' },
        { src: '@Url.Content("~/assets/images/inter2.jfif")' },
        { src: '@Url.Content("~/assets/images/inter3.jfif")' }
    ];

    const ilLightbox = document.getElementById('ilLightbox');
    const ilImg = document.getElementById('ilImg');
    const ilCounter = document.getElementById('ilCounter');
    const ilThumbs = document.getElementById('ilThumbs');
    const ilPrev = document.getElementById('ilPrev');
    const ilNext = document.getElementById('ilNext');
    let ilIndex = 0;

    function ilShow(index) {
        ilIndex = (index + ilMedia.length) % ilMedia.length;
        ilImg.src = ilMedia[ilIndex].src;
        ilCounter.textContent = `${ilIndex + 1} / ${ilMedia.length}`;
        [...ilThumbs.children].forEach((t, i) => t.classList.toggle('active', i === ilIndex));
    }

    function ilRenderThumbs() {
        ilThumbs.innerHTML = '';
        ilMedia.forEach((m, i) => {
            const t = document.createElement('div');
            t.className = 'il-thumb';
            t.innerHTML = `<img src="${m.src}" alt="">`;
            t.addEventListener('click', () => ilShow(i));
            ilThumbs.appendChild(t);
        });
    }

    function ilOpen(startIndex) {
        ilRenderThumbs();
        ilShow(startIndex || 0);
        ilLightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function ilClose() {
        ilLightbox.classList.remove('open');
        document.body.style.overflow = '';
    }

    document.getElementById('ilOpen').addEventListener('click', () => ilOpen(0));
    document.getElementById('ilOpen').addEventListener('keydown', (e) => { if (e.key === 'Enter') ilOpen(0); });
    document.getElementById('ilViewBtn').addEventListener('click', () => ilOpen(0));

    document.querySelectorAll('.spotlight-thumb').forEach(thumb => {
        thumb.addEventListener('click', () => ilOpen(Number(thumb.dataset.index)));
    });

    ilPrev.addEventListener('click', () => ilShow(ilIndex - 1));
    ilNext.addEventListener('click', () => ilShow(ilIndex + 1));
    document.getElementById('ilClose').addEventListener('click', ilClose);
    ilLightbox.addEventListener('click', (e) => { if (e.target === ilLightbox) ilClose(); });

    document.addEventListener('keydown', (e) => {
        if (!ilLightbox.classList.contains('open')) return;
        if (e.key === 'Escape') ilClose();
        if (e.key === 'ArrowLeft') ilShow(ilIndex - 1);
        if (e.key === 'ArrowRight') ilShow(ilIndex + 1);
    });
</script>
