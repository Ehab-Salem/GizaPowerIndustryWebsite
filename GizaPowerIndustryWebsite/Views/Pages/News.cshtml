    <!-- Centred text content -->
    <div class="sustainability-hero-content">
        <h1 class="sustainability-hero-title">News</h1>
        <p class="sustainability-hero-subtitle">
            Lastest News and Updates from Giza Power Industry
        </p>
    </div>
</section>

<!-- Latest News Section -->
<section class="" id="Latest">
    <div class="container">
        <div class="about-header text-center mb-60px" style="text-align: left !important; margin-bottom: 30px !important;">
            <p class="about-label" style="font-weight: 900; color: #a3191e; margin-top:24px !important; margin-bottom:0px !important">
                Latest News
            </p>
            <span class="hero-small reveal-line" style="font-size: 25px; font-weight: 700; color: #06283f;">
