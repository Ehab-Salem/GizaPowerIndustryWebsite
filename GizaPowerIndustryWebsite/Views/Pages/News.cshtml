                        </a>
                    </div>
                </article>

                <article class="side-article-item">
                    <div class="side-article-img-box">
                        <img src="~/assets/GPI Website Visuals/News/latest-news-side-2.jpg" alt="GPI Reduces Carbon Footprint">
                        <div class="side-image-overlay"></div>
                        <span class="side-article-badge">Sustainability</span>
                    </div>
                    <div class="side-article-text">
