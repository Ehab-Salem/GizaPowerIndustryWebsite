                        <!-- ADVANCED FUNCTIONS -->
                        <div class="tab-pane fade" id="ADVANCED">
                            <div class="row m-0">
                                <div class="col-12">
                                    <ul class="list-style-04">
                                        <li>Multi-tariff registers</li>
                                        <li>Load profile 4 configurable channels</li>
                                        <li>Instantaneous monitoring of voltage, current, power factor (true rms)</li>
                                        <li>Event logging with timestamp and push to hes</li>
                                        <li>Relay control via remote, manual, or threshold logic</li>
                                        <li>Overcurrent protection with auto-recovery and lockout logic</li>
                                        <li>Tamper detection: Cover opening, current reversal, bypass, overload, relay fault and all of this push to hes</li>
                                        <li>Power quality monitoring: Over/under voltage, missing phase, imbalance</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
