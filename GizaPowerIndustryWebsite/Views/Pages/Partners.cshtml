<script>

    // Partner Logos Scroll Functionality
    document.addEventListener('DOMContentLoaded', function () {
    // ── Partner logo strip: seamless loop + auto-scroll + manual buttons ──
    const partnerWrapper = document.getElementById("partnerScrollWrapper");

    if (partnerWrapper) {
        const partnerTrack = document.getElementById("partnerScrollTrack");

        // 1. Clone all cards for seamless loop
        const originalCards = Array.from(
            partnerTrack.querySelectorAll(".partner-logo-card")
        );
        originalCards.forEach(card => {
            const clone = card.cloneNode(true);
            clone.setAttribute("aria-hidden", "true");
            partnerTrack.appendChild(clone);
        });

        const scrollSpeed  = 0.7;   // px per tick
        const tickInterval = 16;    // ms (~60fps)
        const scrollAmount = 500;   // px per button click
        let isPaused           = false;
        let isManualScrolling  = false;
        let manualTimeout      = null;
        let autoTimer          = null;

        // 2. Auto-scroll loop
        function startPartnerAutoScroll() {
            autoTimer = setInterval(() => {
                if (isPaused || isManualScrolling) return;

                partnerWrapper.scrollLeft += scrollSpeed;

                // Seamless jump at midpoint
                const halfWidth = partnerTrack.scrollWidth / 2;
                if (partnerWrapper.scrollLeft >= halfWidth) {
                    partnerWrapper.scrollLeft -= halfWidth;
                }
            }, tickInterval);
        }

        startPartnerAutoScroll();

        // 3. Manual buttons
        function manualPartnerScroll(direction) {
            isManualScrolling = true;
            clearTimeout(manualTimeout);
            partnerWrapper.scrollBy({ left: direction * scrollAmount, behavior: "smooth" });
            manualTimeout = setTimeout(() => {
                isManualScrolling = false;
            }, 1500);
        }

        document.querySelector(".partner-scroll-left")
            ?.addEventListener("click", () => manualPartnerScroll(-1));
        document.querySelector(".partner-scroll-right")
            ?.addEventListener("click", () => manualPartnerScroll(1));

        // 4. Pause on hover / touch
        partnerWrapper.addEventListener("mouseenter", () => isPaused = true);
        partnerWrapper.addEventListener("mouseleave", () => isPaused = false);
        partnerWrapper.addEventListener("touchstart", () => {
            isPaused = true;
        }, { passive: true });
        partnerWrapper.addEventListener("touchend", () => {
            setTimeout(() => isPaused = false, 1000);
        }, { passive: true });
    }
    });
</script>