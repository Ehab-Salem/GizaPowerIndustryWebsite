<div class="main-content">
    <!-- start page title -->
    <section class="page-title-big-typography mt-0 ipad-top-space-margin cover-background background-position-center-bottom position-relative big-section"
             style="background-image: url('@Url.Content("~/assets/GPI Website Visuals/Business Lines/Banner-AURA.jpg")')">

        <div class="opacity-extra-medium bg-dark-slate-blue"></div>
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-12 col-md-8 position-relative text-center page-title-extra-large" data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "easing": "easeOutCirc" }'>
                    <h1 class="fw-600 text-white mb-15px">AURA</h1>
                    <h2 class="mb-0 text-white">Smart LED Lighting Solutions for Modern Living & Efficient Spaces</h2>
                </div>
            </div>
        </div>
    </section>
    <!-- end page title -->
    <!-- start page title -->
    <section class="ipad-top-space-margin md-pt-0 pt-0 pb-0">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-12 text-center position-relative page-title-double-large">
                    <div class="d-flex flex-column justify-content-center extra-very-small-screen">
                        <h2 class="text-dark-gray d-inline-block fw-400 ls-0px mb-0">At Aura, we deliver a comprehensive range of high-performance LED lighting solutions designed to combine energy efficiency, reliability, and modern design. Backed by the industrial expertise of Giza Power Industry (GPI), Aura products are engineered to provide exceptional illumination performance across residential, commercial, and industrial applications. With a strong focus on sustainability, long operational lifespan, and everyday efficiency, Aura lighting solutions are developed to meet modern lighting demands while reducing energy consumption and maintenance costs.</h2>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- start section -->
    <section class="big-section" style="padding-top: 0px;padding-bottom: 10px;">
        <div class="container">
            <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 g-3 justify-content-center" data-anime='{"el": "childs", "translateY": [0, 0], "perspective": [1000,1200], "scale": [1.1, 1], "rotateX": [50, 0], "opacity": [0,1], "duration": 800, "delay": 200, "staggervalue": 300, "easing": "easeOutQuad" }'>

                <!-- start interactive banner item -->
                <div class="col interactive-banner-style-03 transition-inner-all center">
                    <div class="position-relative overflow-hidden border-radius-6px last-paragraph-no-margin">
                        <figure class="m-0">
                            <a asp-controller="Pages" asp-action="Led Bulbs" class="h-100 w-100 d-inline-block bg-transparent">
                                <div class="position-absolute top-0px left-0px w-100 h-100 z-index-1"></div>
                                <img src="~/assets/imgs/aura/Led-Bulbs.jpg" alt="" />
                                <figcaption class="d-flex flex-column w-100 h-100 p-60px lg-p-35px z-index-1 bg-transparent">
                                    <a asp-controller="Pages" asp-action="Led Bulbs" class="align-self-start fs-24 fw-600 ls-1px text-uppercase text-white">Led Bulbs</a>
                                </figcaption>
                            </a>
                        </figure>
                    </div>
                </div>
                <!-- end interactive banner item -->
                <div class="col interactive-banner-style-03 transition-inner-all center">
                    <div class="position-relative overflow-hidden border-radius-6px last-paragraph-no-margin">
                        <figure class="m-0">
                            <a asp-controller="Pages" asp-action="SpotLamps" class="h-100 w-100 d-inline-block bg-transparent">
                                <div class="position-absolute top-0px left-0px w-100 h-100 z-index-1"></div>
                                <img src="~/assets/imgs/aura/Spot-lamps.jpg" alt="" />
                                <figcaption class="d-flex flex-column w-100 h-100 p-60px lg-p-35px z-index-1 bg-transparent">
                                    <a asp-controller="Pages" asp-action="SpotLamps" class="align-self-start fs-24 fw-600 ls-1px text-uppercase text-white">Spot lamps</a>
                                </figcaption>
                            </a>
                        </figure>
                    </div>
                </div>
                <!-- start interactive banner item -->
                <div class="col interactive-banner-style-03 transition-inner-all center">
                    <div class="position-relative overflow-hidden border-radius-6px last-paragraph-no-margin">
                        <figure class="m-0">
                            <a asp-controller="Pages" class="h-100 w-100 d-inline-block bg-transparent">
                                <div class="position-absolute top-0px left-0px w-100 h-100 z-index-1"></div>
                                <img src="~/assets/imgs/aura/Aura-Tube.jpg" alt="" />
                                <figcaption class="d-flex flex-column w-100 h-100 p-60px lg-p-35px z-index-1 bg-transparent">
                                    <a asp-controller="Pages" asp-action="AuraTubes" class="align-self-start fs-24 fw-600 ls-1px text-uppercase text-white">Aura tubes</a>
                                </figcaption>
                            </a>
                        </figure>
                    </div>
                </div>
            </div>
        </div>
