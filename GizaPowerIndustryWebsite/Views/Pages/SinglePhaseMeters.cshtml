@{
    ViewData["Title"] = "Meters Products";
}

<style>
    .main-content {
        padding-top: 90px; /* adjust this value as needed */
    }

    .products-page {
        display: flex;
        gap: 30px;
        padding: 40px 0;
        align-items: flex-start;
    }

    /* ===== SIDEBAR ===== */
    .filter-sidebar {
        width: 280px;
        flex-shrink: 0;
        background: #f8f9fa;
        padding: 25px;
        border-radius: 6px;
    }

        .filter-sidebar h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 20px;
        }

    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .btn-clear-filters {
        border: none;
        background: none;
        color: #B82025;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .btn-close-sidebar {
        border: none;
        background: none;
        font-size: 1.1rem;
        cursor: pointer;
    }

    .filter-group {
        border-bottom: 1px solid #e0e0e0;
        padding-bottom: 15px;
        margin-bottom: 15px;
    }

    .filter-group-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        font-weight: 600;
        color: #444;
        margin-bottom: 12px;
    }

        .filter-group-header .toggle-icon {
            font-size: 1.2rem;
            line-height: 1;
            transition: transform 0.2s;
        }

    .filter-group.collapsed .toggle-icon {
        transform: rotate(-90deg);
    }

    .filter-options {
        display: flex;
        flex-direction: column;
        gap: 10px;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .filter-group.collapsed .filter-options {
        display: none;
    }

    .filter-option {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 0.92rem;
        color: #374151;
        cursor: pointer;
        flex-direction: row;
        margin: 0;
        min-height: 2.25rem;
    }

        .filter-option input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid #d1d5db;
            border-radius: 4px;
            margin: 0;
            cursor: pointer;
            position: relative;
            transition: all 0.2s;
            flex-shrink: 0;
        }

            .filter-option input[type="checkbox"]:checked {
                background: #B82025;
                border-color: #B82025;
            }

                .filter-option input[type="checkbox"]:checked::after {
                    content: "";
                    position: absolute;
                    left: 5px;
                    top: 2px;
                    width: 5px;
                    height: 10px;
                    border: solid #fff;
                    border-width: 0 2px 2px 0;
                    transform: rotate(45deg);
                }

        .filter-option .option-label {
            flex: 1 1 auto;
            min-width: 0;
            line-height: 1.4;
        }

        .filter-option .count {
            flex: 0 0 auto;
            color: #9ca3af;
            font-size: 0.8rem;
            white-space: nowrap;
            margin-left: auto;
        }

    .show-more {
        color: #B82025;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-top: 5px;
    }

    /* ===== MAIN LIST ===== */
    .products-main {
        flex: 1;
    }

    .products-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e0e0e0;
        margin-bottom: 10px;
    }

        .products-toolbar h2 {
            color: #B82025;
            font-size: 1.3rem;
            font-weight: 700;
            margin: 0;
        }

    .toolbar-controls {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

        .toolbar-controls label {
            font-weight: 600;
            font-size: 0.85rem;
            color: #555;
            margin-right: 5px;
        }


    .product-list {
        display: flex;
        flex-direction: column;
    }

    .product-row {
        display: flex;
        align-items: center;
        gap: 25px;
        padding: 18px 0;
        border-bottom: 1px solid #eee;
    }

        /* ===== FULL IMAGE DISPLAY =====
                           "Stage" box sized to the real product image ratio (600 x 815,
                           portrait) via aspect-ratio, so images render big and full,
                           never cropped or squashed. */
        .product-row .image-stage {
            position: relative; /* needed for badge positioning */
            width: 220px;
            aspect-ratio: 600 / 815;
            height: auto;
            flex-shrink: 0;
            background: #f8f9fa;
            border: 1px solid #eee;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .product-row img {
            max-width: 100%;
            max-height: 100%;
            width: auto;
            height: auto;
            object-fit: contain;
        }

    /* ===== PRODUCT BADGE ===== */
    .product-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #B82025;
        color: #fff;
        font-weight: 500;
        text-transform: uppercase;
        border-radius: 30px;
        padding: 4px 18px;
        font-size: 13px;
        line-height: 1.6;
        z-index: 2;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        letter-spacing: 0.3px;
    }

    .product-row .product-name {
        flex: 1;
        color: #06283F;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
    }

    .product-row .btn-spec {
        border: 1px solid #ccc;
        border-radius: 4px;
        background: #fff;
        padding: 10px 18px;
        font-size: 0.85rem;
        color: #555;
        text-decoration: none;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Grid view */
    .product-list.grid-view {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
    }

        .product-list.grid-view .product-row {
            flex-direction: column;
            align-items: stretch;
            text-align: center;
            border: 1px solid #eee;
            border-radius: 6px;
            padding: 20px;
        }

            .product-list.grid-view .product-row .image-stage {
                width: 100%;
                aspect-ratio: 600 / 815;
                height: auto;
            }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .products-page {
            flex-direction: column;
        }

        .filter-sidebar {
            width: 100%;
        }

        .product-list.grid-view {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .product-row {
            flex-wrap: wrap;
        }

            .product-row .image-stage {
                width: 100%;
                aspect-ratio: 600 / 815;
                height: auto;
                max-width: 260px;
                margin: 0 auto;
            }

            .product-row .btn-spec {
                width: 100%;
                justify-content: center;
            }

        .product-list.grid-view {
            grid-template-columns: 1fr;
        }

        .products-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="main-content">
    <div class="container">
        <div class="products-page">
            <!-- ===== FILTER SIDEBAR ===== -->
            <aside class="filter-sidebar" id="filterSidebar">
                <div class="sidebar-header">
                    <h3>Filter by</h3>
                    <button class="btn-clear-filters" id="clearAllFilters" style="display:none;">Clear All</button>
                    <button class="btn-close-sidebar d-md-none" onclick="closeMobileSidebar()">✕</button>
                </div>

                <!-- Meter Type Group -->
                <div class="filter-group">
                    <div class="filter-group-header" onclick="toggleGroup(this)">
                        <span>Meter Type</span>
                        <svg class="toggle-icon" width="16" height="16" viewBox="0 0 16 16"><polyline points="4,6 8,10 12,6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    </div>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="checkbox" data-filter="metertype" value="Energy" />
                            <span class="option-label">Energy Meter</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" data-filter="metertype" value="Smart" />
                            <span class="option-label">Smart Meter</span>
                        </label>
                    </div>
                </div>


                <!-- Accuracy Class Group -->
                <div class="filter-group">
                    <div class="filter-group-header" onclick="toggleGroup(this)">
                        <span>Accuracy Class</span>
                        <svg class="toggle-icon" width="16" height="16" viewBox="0 0 16 16"><polyline points="4,6 8,10 12,6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    </div>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="checkbox" data-filter="accuracy" value="Class 1" />
                            <span class="option-label">Class 1</span>
                        </label>
                        <label class="filter-option">
                            <input type="checkbox" data-filter="accuracy" value="Class 0.5S" />
                            <span class="option-label">Class 0.5S</span>
                        </label>
                    </div>
                </div>

                <!-- Mounting Type Group -->
                <div class="filter-group" style="border-bottom: none;">
                    <div class="filter-group-header" onclick="toggleGroup(this)">
                        <span>Mounting</span>
                        <svg class="toggle-icon" width="16" height="16" viewBox="0 0 16 16"><polyline points="4,6 8,10 12,6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    </div>
                    <div class="filter-options">
                        <label class="filter-option">
                            <input type="checkbox" data-filter="mounting" value="DIN Rail" />
                            <span class="option-label">DIN Rail</span>
                        </label>
                        <!-- Added Wall Mount option to match real product data -->
                        <label class="filter-option">
                            <input type="checkbox" data-filter="mounting" value="Wall" />
                            <span class="option-label">Wall Mount</span>
                        </label>
                    </div>
                </div>
            </aside>

            <!-- ===== MAIN PRODUCT LIST ===== -->
            <div class="products-main">
                <div class="products-toolbar">
                    <h2>Single Phase Meters</h2>
                </div>

                <div class="product-list grid-view" id="productList">
                    @{
                        var products = new[]
                        {
                                        new {
                                        Id = "GPM-PC01",
                                        Name = "SINGLE PHASE PREPAID CONNECTED ENERGY METER ",
                                        Img = "single-phase-prepaid-connected.jpg",
                                        Action = "SinglePhasePrePaidConnected",
                                        MeterType = "Energy",
                                        Phase = "Single",
                                        Connection = "Direct",
                                        Accuracy = "Class 1",
                                        Mounting = "Wall"
                                        },
                                        new {
                                        Id = "GPM-PP01",
                                        Name = "SINGLE PHASE PREPAID ENERGY METER ",
                                        Img = "single-phase-prepaid-energy.jpg",
                                        Action = "SinglePhasePrePaidEnergy",
                                        MeterType = "Energy",
                                        Phase = "Single",
                                        Connection = "Direct",
                                        Accuracy = "Class 0.5S",
                                        Mounting = "Wall"
                                        },
                                        new {
                                        Id = "S12U16",
                                        Name = "SINGLE PHASE SMART STS PREPAID ELECTRIC METER",
                                        Img = "sINGLE-sHASE-sMART-sTS-pREPAID-eLECTRIC.jpg",
                                        Action = "SinglePhaseSmart",
                                        MeterType = "Smart",
                                        Phase = "Single",
                                        Connection = "Direct",
                                        Accuracy = "Class 1",
                                        Mounting = "DIN Rail"
                                        }
                                        };
                    }

                    @foreach (var product in products)
                    {
                        <div class="product-row"
                             data-metertype="@product.MeterType"
                             data-phase="@product.Phase"
                             data-connection="@product.Connection"
                             data-accuracy="@product.Accuracy"
                             data-mounting="@product.Mounting">
                            <div class="image-stage">
                                <img src="~/assets/imgs/meters/@product.Img" alt="@product.Name" />
                                <div class="product-badge">@product.Id</div>
                            </div>
                            <a asp-controller="Pages" asp-action="@product.Action"
                               asp-route-Name="@product.Name"
                               asp-route-img="@product.Img"
                               class="product-name">@product.Name</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /* ===== Collapse / Expand Filter Group ===== */
    function toggleGroup(header) {
        const group = header.closest('.filter-group');
        if (!group) return;
        group.classList.toggle('collapsed');
    }

    /* ===== Show More / Show Less (if needed) ===== */
    function toggleShowMore(link) {
        const container = link.closest('.filter-options');
        const extras = container.querySelector('.extra-options');
        if (!extras) return;
        if (extras.style.display === 'none' || extras.style.display === '') {
            extras.style.display = 'block';
            link.textContent = '− Show Less';
        } else {
            extras.style.display = 'none';
            link.textContent = '+ Show More';
        }
    }

    /* ===== Single selection inside each filter group ===== */
    document.addEventListener('change', function (e) {
        if (!e.target.matches('.filter-option input[type="checkbox"]')) return;
        const group = e.target.closest('.filter-group');
        if (!group) return;
        const allCheckboxes = group.querySelectorAll('.filter-option input[type="checkbox"]');
        allCheckboxes.forEach(cb => {
            if (cb !== e.target) cb.checked = false;
        });
        updateClearButton();
        filterProducts();
    });

    /* ===== Clear All filters ===== */
    function updateClearButton() {
        const anyChecked = document.querySelectorAll('.filter-option input[type="checkbox"]:checked').length > 0;
        const clearBtn = document.getElementById('clearAllFilters');
        if (clearBtn) {
            clearBtn.style.display = anyChecked ? 'inline-block' : 'none';
        }
    }

    document.getElementById('clearAllFilters')?.addEventListener('click', function () {
        document.querySelectorAll('.filter-option input[type="checkbox"]').forEach(cb => cb.checked = false);
        updateClearButton();
        filterProducts();
    });

    /* ===== Product filtering ===== */
    function filterProducts() {
        const selectedFilters = {};
        document.querySelectorAll('.filter-option input[type="checkbox"]:checked').forEach(cb => {
            const filterType = cb.getAttribute('data-filter');
            const value = cb.value;
            selectedFilters[filterType] = value;
        });

        const rows = document.querySelectorAll('.product-row');
        rows.forEach(row => {
            let visible = true;

            if (selectedFilters['metertype'] && row.getAttribute('data-metertype') !== selectedFilters['metertype']) visible = false;
            if (selectedFilters['phase'] && row.getAttribute('data-phase') !== selectedFilters['phase']) visible = false;
            if (selectedFilters['connection'] && row.getAttribute('data-connection') !== selectedFilters['connection']) visible = false;
            if (selectedFilters['accuracy'] && row.getAttribute('data-accuracy') !== selectedFilters['accuracy']) visible = false;
            if (selectedFilters['mounting'] && row.getAttribute('data-mounting') !== selectedFilters['mounting']) visible = false;

            row.style.display = visible ? 'flex' : 'none';
        });
    }

    // Initial state
    document.addEventListener('DOMContentLoaded', function () {
        updateClearButton();
        filterProducts(); // show all by default
    });

    /* ===== Mobile Sidebar Toggle ===== */
    function openMobileSidebar() {
        document.getElementById('filterSidebar')?.classList.add('open');
    }
    function closeMobileSidebar() {
        document.getElementById('filterSidebar')?.classList.remove('open');
    }
</script>