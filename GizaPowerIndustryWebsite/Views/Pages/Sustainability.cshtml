@{
    ViewData["Title"] = "Sustainability";
}
<style>
    /* ── Sustainability Hero (full width, centred text) ── */
    .sustainability-hero {
        position: relative;
        width: 100%;
        height: 70vh;
        min-height: 400px;
        overflow: hidden;
        margin-top: 70px;
        border-radius: 0 !important;
    }

    .sustainability-hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

        .sustainability-hero-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .sustainability-hero-overlay {
        position: absolute;
        inset: 0;
        /* background: linear-gradient(to bottom, rgba(6, 40, 63, 0.45), rgba(6, 40, 63, 0.75)); */
        z-index: 1;
    }

    .sustainability-hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        text-align: center;
        width: 100%;
        padding: 0 2rem;
    }

    .sustainability-hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        color: #fff;
        margin: 0 0 1rem;
        line-height: 1.1;
        text-transform: none;
    }

    .sustainability-hero-subtitle {
        font-size: clamp(1rem, 2.5vw, 1.4rem);
        font-weight: 300;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
        line-height: 1.6;
    }

    /* ── Commitment section ── */
    .commitment-subheading {
        font-weight: 900;
        color: #06283f;
        line-height: 1.35;
        /* margin-top: 3rem; */
        margin-bottom: 1.5rem;
        text-transform: none;
        text-align: center;
        font-size: 24px;
    }

    /* ── Commitment Pillars (Equal Height, Animated White Cards) ── */
    .commitment-pillars {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 28px;
        /* padding: 20px 0 70px; */
    }

    .pillar-card {
        position: relative;
        background: #ffffff;
        border: 1px solid #f0f2f5;
        border-radius: 18px;
        padding: 38px 28px 32px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* Red Accent Top Border */
    .pillar-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #B82025 0%, #E63946 100%);
        border-radius: 18px 18px 0 0;
        transition: height 0.3s ease, box-shadow 0.3s ease;
    }

    /* Hover Animation */
    .pillar-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 38px rgba(184, 32, 37, 0.09), 0 4px 16px rgba(0, 0, 0, 0.05);
        border-color: rgba(184, 32, 37, 0.25);
    }

    .pillar-card:hover::before {
        height: 6px;
        box-shadow: 0 2px 10px rgba(184, 32, 37, 0.4);
    }

    /* Card Typography */
    .pillar-card h3 {
        font-size: 1.25rem;
        font-weight: 800;
        color: #06283F;
        text-transform: uppercase;
        line-height: 1.35;
        margin: 0 0 16px;
        transition: color 0.3s ease;
    }

    .pillar-card:hover h3 {
        color: #B82025;
    }

    .pillar-card p {
        font-size: 0.95rem;
        color: #586F7E;
        line-height: 1.7;
        margin: 0;
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .commitment-pillars {
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }
    }

    @@media (max-width: 640px) {
        .commitment-pillars {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 10px 0 40px;
        }

        .pillar-card {
            padding: 28px 22px;
        }
    }
</style>

<!-- Full‑width Hero Banner -->
<section class="sustainability-hero" style="border-radius:0px">
    <!-- Background Image -->
    <div class="sustainability-hero-bg">
        <img src="~/assets/GPI Website Visuals/Sustainability/Sustainability.jpg" alt="Sustainable energy landscape">
    </div>
    <!-- Dark overlay for readability -->
    <div class="sustainability-hero-overlay"></div>

    <!-- Centred text content -->
    <div class="sustainability-hero-content">
        <h1 class="sustainability-hero-title">Sustainability</h1>
        <p class="sustainability-hero-subtitle">
            Innovating for a greener, more responsible future.
        </p>
    </div>
</section>

<!-- Our Commitment Section -->
<section class="commitment-section">
    <div class="container">
        <div class="commitment-content">
            <h2 class="commitment-subheading reveal-line">
                For us, sustainability is not just a responsibility — it’s an opportunity to innovate and lead by example.
            </h2>
        </div>
        <div class="commitment-pillars">
            <!-- Column 1 -->
            <div class="pillar-card">
                <h3>ECO-FRIENDLY<br>MANUFACTURING</h3>
                <p>
                    We implement cutting-edge technologies and processes to minimize our carbon footprint, ensuring that our manufacturing practices are as green as possible.
                </p>
            </div>

            <!-- Column 2 -->
            <div class="pillar-card">
                <h3>SUSTAINABLE<br>PRODUCTS</h3>
                <p>
                    Our product range is designed with sustainability in mind. From energy-efficient lighting solutions to durable cables and advanced meters, we aim to provide products that contribute to a more sustainable future.
                </p>
            </div>

            <!-- Column 3 -->
            <div class="pillar-card">
                <h3>COMMUNITY<br>ENGAGEMENT</h3>
                <p>
                    We actively engage with communities we operate in to promote sustainable practices and support initiatives that enhance environmental and social well-being.
                </p>
            </div>

            <!-- Column 4 -->
            <div class="pillar-card">
                <h3>GLOBAL<br>RESPONSIBILITY</h3>
                <p>
                    As we expand our global reach, we are dedicated to adhering to the highest standards of environmental stewardship and corporate responsibility in all the markets we serve.
                </p>
            </div>
        </div>
    </div>
</section>
