<script>
    (function() {
      const searchInput = document.getElementById('vacancySearchAlt');
      const clearBtn = document.getElementById('clearVacancySearchAlt');
      const filterButtons = document.querySelectorAll('#vacancies-alt .filter-btn');
      const jobRows = document.querySelectorAll('#vacancyListAlt .vacancy-row');

      let activeCategory = 'all';
      let searchTerm = '';

      function filterJobs() {
        jobRows.forEach(row => {
          const category = row.getAttribute('data-category');
          const searchText = row.textContent.toLowerCase();

          const matchesCategory = activeCategory === 'all' || category === activeCategory;
          const matchesSearch = searchTerm === '' || searchText.includes(searchTerm);

          row.style.display = (matchesCategory && matchesSearch) ? 'flex' : 'none';
        });
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          filterButtons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          activeCategory = this.getAttribute('data-filter');
          filterJobs();
        });
      });

      searchInput.addEventListener('input', function() {
        searchTerm = this.value.toLowerCase().trim();
        filterJobs();
      });

      clearBtn.addEventListener('click', function() {
        searchInput.value = '';
        searchTerm = '';
        filterJobs();
        searchInput.focus();
      });

      filterJobs();
    })();
</script>
<script>
