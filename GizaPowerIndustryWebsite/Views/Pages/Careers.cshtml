    </div>

    <!-- Dropdown filters -->
    <div class="fyr-filters-row">
        <div class="fyr-dropdown" id="fyrDropLocation">
            <button class="fyr-drop-btn" data-selected="">
                <span class="fyr-drop-label">All Locations</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="fyr-drop-menu">
                <li class="fyr-drop-item active" data-value="">All Locations</li>
                @foreach (var loc in Model.Vacancies.Select(v => v.Location).Distinct().OrderBy(l => l))
                {
                    <li class="fyr-drop-item" data-value="@loc">@loc</li>
                }
            </ul>
        </div>

        <div class="fyr-dropdown" id="fyrDropDept">
            <button class="fyr-drop-btn" data-selected="">
                <span class="fyr-drop-label">All Departments</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="fyr-drop-menu">
                <li class="fyr-drop-item active" data-value="">All Departments</li>
                @foreach (var dept in Model.Departments)
                {
                    <li class="fyr-drop-item" data-value="@dept.Slug">@dept.Name</li>
                }
            </ul>
        </div>

        <div class="fyr-dropdown" id="fyrDropLevel">
            <button class="fyr-drop-btn" data-selected="">
                <span class="fyr-drop-label">All Experience Level</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="fyr-drop-menu">
                <li class="fyr-drop-item active" data-value="">All Experience Level</li>
                @foreach (var lvl in Model.Vacancies.Select(v => v.SeniorityLevel).Where(l => !string.IsNullOrEmpty(l)).Distinct().OrderBy(l => l))
                {
                    <li class="fyr-drop-item" data-value="@lvl">@lvl</li>
                }
            </ul>
        </div>

        <div class="fyr-dropdown" id="fyrDropType">
            <button class="fyr-drop-btn" data-selected="">
                <span class="fyr-drop-label">All Employment Type</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <ul class="fyr-drop-menu">
                <li class="fyr-drop-item active" data-value="">All Employment Type</li>
                @foreach (var et in Model.Vacancies.Select(v => v.EmploymentType).Distinct().OrderBy(e => e))
                {
                    <li class="fyr-drop-item" data-value="@et">@et</li>
                }
            </ul>
        </div>
    </div>

    <!-- Cards grid -->
    <div class="fyr-grid" id="fyrGrid">
        @if (!Model.Vacancies.Any())
        {
            <p class="fyr-empty">There are no open positions right now. Please check back soon.</p>
        }
        @foreach (var job in Model.Vacancies)
        {
            <div class="fyr-card"
                 data-category="@job.DepartmentSlug"
                 data-location="@job.Location"
                 data-level="@job.SeniorityLevel"
                 data-type="@job.EmploymentType">

                <!-- Card top row: location + badge -->
                <div class="fyr-card-top">
                    <span class="fyr-card-location">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        @job.Location
                    </span>
                    <span class="fyr-badge">@job.EmploymentType.ToUpper()</span>
                </div>

                <!-- Title + summary -->
                <div class="fyr-card-body">
                    <h3 class="fyr-card-title">@job.JobTitle</h3>
                    @if (!string.IsNullOrEmpty(job.JobSummary))
                    {
                        <p class="fyr-card-summary">@job.JobSummary</p>
                    }
                </div>

                <!-- Meta row: seniority + department -->
                <div class="fyr-card-meta">
                    @if (!string.IsNullOrEmpty(job.SeniorityLevel))
                    {
                        <span class="fyr-meta-item">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            @job.SeniorityLevel
                        </span>
                    }
                    <span class="fyr-meta-item">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                        @job.Department
                    </span>
                </div>

                <!-- Action buttons -->
                <div class="fyr-card-actions">
                    <a asp-action="JobDetails" asp-controller="Pages" asp-route-id="@job.Id" class="fyr-btn-outline">View Details</a>
                    <a asp-action="JobDetails" asp-controller="Pages" asp-route-id="@job.Id" class="fyr-btn-solid">Apply now</a>
                </div>
            </div>
        }
    </div>

    <!-- No results message -->
    <p class="fyr-no-results" id="fyrNoResults" style="display:none;">No positions match your filters. Please try different criteria.</p>

</section>
<script>
(function () {
    /* ---- helpers ---- */
    const keyword   = document.getElementById('fyrKeyword');
    const clearKw   = document.getElementById('fyrClearKeyword');
    const grid      = document.getElementById('fyrGrid');
    const noResults = document.getElementById('fyrNoResults');
    const cards     = Array.from(grid.querySelectorAll('.fyr-card'));

    /* dropdown state */
    const dropState = { location: '', dept: '', level: '', type: '' };

    /* ---- dropdown wiring ---- */
    function wireDropdown(wrapperId, stateKey, defaultLabel) {
        const wrapper = document.getElementById(wrapperId);
        const btn     = wrapper.querySelector('.fyr-drop-btn');
        const label   = btn.querySelector('.fyr-drop-label');
        const menu    = wrapper.querySelector('.fyr-drop-menu');
        const items   = Array.from(menu.querySelectorAll('.fyr-drop-item'));

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            document.querySelectorAll('.fyr-drop-menu.open').forEach(m => { if (m !== menu) m.classList.remove('open'); });
            menu.classList.toggle('open');
        });

        items.forEach(item => {
            item.addEventListener('click', function () {
                items.forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                dropState[stateKey] = this.dataset.value;
                label.textContent = this.dataset.value ? this.textContent : defaultLabel;
                btn.classList.toggle('fyr-drop-btn--active', !!this.dataset.value);
                menu.classList.remove('open');
                filterCards();
            });
        });
    }

    wireDropdown('fyrDropLocation', 'location', 'All Locations');
    wireDropdown('fyrDropDept',     'dept',     'All Departments');
    wireDropdown('fyrDropLevel',    'level',    'All Experience Level');
    wireDropdown('fyrDropType',     'type',     'All Employment Type');

    /* close dropdowns on outside click */
    document.addEventListener('click', () => document.querySelectorAll('.fyr-drop-menu.open').forEach(m => m.classList.remove('open')));

    /* ---- keyword ---- */
    keyword.addEventListener('input', filterCards);
    clearKw.addEventListener('click', function () { keyword.value = ''; filterCards(); keyword.focus(); });

    /* ---- filter logic ---- */
    function filterCards() {
        const kw = keyword.value.toLowerCase().trim();
        let visible = 0;
        cards.forEach(card => {
            const matchKw   = !kw || card.textContent.toLowerCase().includes(kw);
            const matchLoc  = !dropState.location || card.dataset.location === dropState.location;
            const matchDept = !dropState.dept     || card.dataset.category  === dropState.dept;
            const matchLvl  = !dropState.level    || card.dataset.level     === dropState.level;
            const matchType = !dropState.type     || card.dataset.type      === dropState.type;
            const show = matchKw && matchLoc && matchDept && matchLvl && matchType;
            card.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    filterCards();
})();
</script>
<script>
(function () {
    /* ---- 1. Animate header / search / filters on first scroll into view ---- */
    const section     = document.getElementById('vacancies-modern');
    const revealEls   = section.querySelectorAll('.fyr-header, .fyr-search-wrap, .fyr-filters-row');

    const topObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                entry.target.classList.add('fyr-visible');
                topObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.15 });

    revealEls.forEach(function (el) { topObserver.observe(el); });

    /* ---- 2. Staggered card entrance ---- */
    const allCards = Array.from(section.querySelectorAll('.fyr-card'));

    const cardObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                const card  = entry.target;
                const index = allCards.indexOf(card);
                const col   = index % 3; /* stagger by column */
                card.style.animationDelay = (col * 80) + 'ms';
                card.classList.add('fyr-card-visible');
                cardObserver.unobserve(card);
            }
        });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

    allCards.forEach(function (card) { cardObserver.observe(card); });

    /* ---- 3. Shimmer effect on the badge when card becomes visible ---- */
    section.addEventListener('animationstart', function (e) {
        if (e.target.classList.contains('fyr-card')) {
            const badge = e.target.querySelector('.fyr-badge');
            if (badge) {
                badge.style.transition = 'background 0.4s ease 0.3s';
            }
        }
    });

    /* ---- 4. Drop-button press micro-animation ---- */
    section.querySelectorAll('.fyr-drop-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            btn.style.transform = 'scale(0.96)';
            setTimeout(function () { btn.style.transform = ''; }, 150);
        });
    });

    /* ---- 5. Re-run stagger when cards are filtered back in ---- */
    const grid = document.getElementById('fyrGrid');
    const mutObs = new MutationObserver(function () {
        allCards.forEach(function (card, i) {
            if (card.style.display !== 'none' && !card.classList.contains('fyr-card-visible')) {
                const col = i % 3;
                card.style.animationDelay = (col * 60) + 'ms';
                card.classList.add('fyr-card-visible');
            }
        });
    });
    mutObs.observe(grid, { attributes: true, subtree: true, attributeFilter: ['style'] });
})();
</script>
