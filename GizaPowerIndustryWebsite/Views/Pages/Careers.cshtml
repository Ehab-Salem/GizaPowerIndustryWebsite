      const filterButtons = document.querySelectorAll('.filter-btn');
      const jobItems = document.querySelectorAll('.internship-item');

      let activeCategory = 'all';
      let searchTerm = '';

      // Update visible jobs based on category + search text
      function filterJobs() {
        jobItems.forEach(item => {
          const category = item.getAttribute('data-category');
          const searchText = item.textContent.toLowerCase();

          const matchesCategory = activeCategory === 'all' || category === activeCategory;
          const matchesSearch = searchTerm === '' || searchText.includes(searchTerm);

          item.style.display = (matchesCategory && matchesSearch) ? 'flex' : 'none';
        });
      }

      // Category filter click
      filterButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          filterButtons.forEach(b => b.classList.remove('active'));
          this.classList.add('active');
          activeCategory = this.getAttribute('data-filter');
          filterJobs();
        });
      });

      // Search input
      searchInput.addEventListener('input', function() {
        searchTerm = this.value.toLowerCase().trim();
        filterJobs();
      });

      // Clear button
      clearBtn.addEventListener('click', function() {
        searchInput.value = '';
        searchTerm = '';
