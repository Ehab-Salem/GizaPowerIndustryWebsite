@model GizaPowerIndustryWebsite.Models.CareersViewModel
@{
    ViewData["Title"] = "Careers";
}
<style>
    /* ===== Clean Equal‑Height Culture Grid ===== */
    .culture-grid-equal {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 24px;
    }

    /* Card Base */
    .culture-card-equal {
        position: relative;
        border-radius: 18px;
        padding: 38px 30px 32px;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #f0f2f5;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        height: 100%;
        overflow: hidden;
        transition: all 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* Beautiful Red Top Border Accent */
    .culture-card-equal::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #B82025 0%, #E63946 100%);
        border-radius: 18px 18px 0 0;
        transition: height 0.3s ease, box-shadow 0.3s ease;
    }

    /* Hover Animation */
    .culture-card-equal:hover {
        transform: translateY(-8px);
        box-shadow: 0 18px 38px rgba(184, 32, 37, 0.09), 0 4px 16px rgba(0, 0, 0, 0.05);
        border-color: rgba(184, 32, 37, 0.25);
    }

    .culture-card-equal:hover::before {
        height: 6px;
        box-shadow: 0 2px 10px rgba(184, 32, 37, 0.4);
    }

    /* White Card Typography */
    .culture-card-white {
        background: #fff;
    }

    .culture-card-white .culture-card-title {
        color: #06283f;
        transition: color 0.3s ease;
    }

    .culture-card-equal:hover .culture-card-title {
        color: #B82025;
    }

    .culture-card-white .culture-preview,
    .culture-card-white .culture-full {
        color: #6b7280;
    }

    /* Icon */
    .culture-card-icon {
        margin-bottom: 24px;
    }

    .culture-card-icon img {
        width: 50px;
        height: auto;
        transition: transform 0.35s ease;
    }

    .culture-card-equal:hover .culture-card-icon img {
        transform: scale(1.12) rotate(4deg);
    }

    /* Title */
    .culture-card-title {
        font-size: 1.35rem;
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.3;
        margin: 0 0 16px;
    }

    /* Text Handling */
    .culture-preview {
        font-size: 0.9375rem;
        line-height: 1.6;
        margin: 0;
    }

    .culture-full {
        display: none;
        font-size: 0.9375rem;
        line-height: 1.6;
        margin: 0;
    }

    .culture-card-body.expanded .culture-full {
        display: block;
    }

    .culture-card-body.expanded .culture-preview {
        display: none;
    }

    /* Read More Button */
    .culture-read-more {
        background: none;
        border: none;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
        margin-top: 14px;
        font-size: 0.9rem;
        text-decoration: underline;
        color: #B82025;
        display: inline-block;
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .culture-read-more:hover {
        color: #8b1317;
        transform: translateX(3px);
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .culture-grid-equal {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .culture-grid-equal {
            grid-template-columns: 1fr;
        }
    }
</style>
<style>
    /* ==================== CULTURE & GROWTH ==================== */
    .culture-growth {
        padding: 100px 0;
        background: #ffffff;
    }

    .culture-title {
        font-size: clamp(2.5rem, 5vw, 4.25rem);
        line-height: 1.1;
        color: #06283f;
        margin-bottom: 60px;
        font-family: 'Neulis Sans', 'Montserrat', sans-serif;
        font-weight: 300;
        text-transform: capitalize;
    }

        .culture-title .bold {
            font-weight: 900;
        }

    /* ----- GRID LAYOUT (Desktop: 5 columns) ----- */
    .culture-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 24px;
        margin-bottom: 20px;
    }

    /* ----- CARD BASE ----- */
    .culture-card {
        padding: 50px 30px 40px;
        border-radius: 20px;
        min-height: 275px;
        display: grid;
        grid-template-columns: auto 1fr; /* icon | title */
        grid-template-rows: auto 1fr; /* row1: icon+title, row2: paragraph */
        align-items: start;
        gap: 0 16px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .culture-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        /* ----- ICON ----- */
        .culture-card .culture-icon {
            grid-row: 1;
            grid-column: 1;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            margin: 0;
            background: transparent;
            border: none;
        }

    .culture-red .culture-icon img,
    .culture-white .culture-icon img {
        width: 50px;
        height: auto;
        display: block;
    }

    /* ----- CONTENT WRAPPER (invisible) ----- */
    .culture-card .culture-card-content {
        display: contents; /* h3 and p become direct grid items */
    }

    /* ----- TITLE (next to icon on row 1) ----- */
    .culture-card h3 {
        grid-row: 1;
        grid-column: 2;
        margin: 0;
        text-transform: uppercase;
        font-weight: 900;
        font-size: 1.35rem;
        line-height: 1.3;
        align-self: start;
    }

    /* ----- PARAGRAPH (full width row 2) ----- */
    .culture-card p {
        grid-row: 2;
        grid-column: 1 / -1;
        margin: 0;
        margin-top: 16px;
        font-size: 0.9375rem;
        line-height: 1.6;
    }

    /* ----- RED CARD COLOURS ----- */
    .culture-red {
        background: #b82025;
        color: #ffffff;
    }

        .culture-red::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 77%;
            height: 95%;
            background: url('../icons/culture-red-bg.png') no-repeat bottom right;
            background-size: contain;
            opacity: 1.15;
            z-index: 0;
            pointer-events: none;
        }

        .culture-red h3,
        .culture-red p {
            color: #ffffff;
            position: relative;
            z-index: 1;
        }

        .culture-red p {
            color: rgba(255, 255, 255, 0.85);
        }

    /* ----- WHITE CARD COLOURS ----- */
    .culture-white {
        background: #ffffff;
        border: 1px solid #f3f4f6;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

        .culture-white h3 {
            color: #06283f;
        }

        .culture-white p {
            color: #6b7280;
        }

    /* ==================== RESPONSIVE ==================== */

    /* 3 columns on smaller desktops (≤1200px) */
    @@media (max-width: 1200px) {
        .culture-grid

    {
        grid-template-columns: repeat(3, 1fr);
    }

    .culture-card {
        min-height: auto;
    }

    }

    /* 2 columns on tablets (≤992px) */
    @@media (max-width: 992px) {
        .culture-grid

    {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .culture-growth .container-fluid[style*="padding: 0 6rem"],
    .culture-growth .header-container-careers[style*="padding: 0 6rem"] {
        padding-left: 2rem !important;
        padding-right: 2rem !important;
    }

    .culture-card {
        padding: 35px 25px 30px;
        min-height: auto;
    }

    }

    /* Large phones (≤768px) – still 2 columns */
    @@media (max-width: 768px) {
        .culture-grid

    {
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .culture-title {
        margin-bottom: 40px;
    }

    }

    /* Single column on small phones (≤600px) */
    @@media (max-width: 600px) {
        .culture-grid

    {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .culture-growth .container-fluid[style*="padding: 0 6rem"],
    .culture-growth .header-container-careers[style*="padding: 0 6rem"] {
        padding-left: 1.25rem !important;
        padding-right: 1.25rem !important;
    }

    .culture-card {
        padding: 30px 20px 25px;
        min-height: auto;
        /* Stack everything vertically */
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto;
    }

        /* Icon → row 1 */
        .culture-card .culture-icon {
            grid-row: 1;
            grid-column: 1;
            margin-bottom: 12px;
        }

        /* Title → row 2 */
        .culture-card h3 {
            grid-row: 2;
            grid-column: 1;
            margin: 0 0 8px 0;
            font-size: 1.15rem;
        }

        /* Paragraph → row 3 */
        .culture-card p {
            grid-row: 3;
            grid-column: 1;
            margin-top: 8px;
            font-size: 0.875rem;
        }

    .culture-red .culture-icon img,
    .culture-white .culture-icon img {
        width: 40px;
    }

    }
</style>
<style>
    .internship-section {
        padding: 100px 0;
        background: #FFFFFF;
    }

    .internship-badge {
        color: #B82025;
        font-weight: 700;
        font-size: 3rem;
        letter-spacing: 0.1em;
        display: inline-block;
    }

    .internship-main-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        color: #06283F;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-weight: 300;
    }

        .internship-main-title .bold {
            font-weight: 900;
        }

    .internship-subtitle {
        font-size: 1.0625rem;
        line-height: 1.8;
        color: #6B7280;
        margin-bottom: 30px;
    }

    /* ----- Filters ----- */
    .internship-filters {
        display: flex;
        justify-content: space-around;
        gap: 1rem;
        margin-bottom: 60px;
        border-bottom: 1px solid #E5E7EB;
        padding-bottom: 0;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 1rem 0;
        font-size: 1rem;
        font-weight: 600;
        color: #4B5563;
        background: transparent;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        bottom: -1px;
    }

        .filter-btn:hover {
            color: #06283F;
        }

        .filter-btn.active {
            color: #4B5563; /* neutral colour */
        }

            .filter-btn.active::after {
                content: '';
                position: absolute;
                bottom: -4px;
                left: 0;
                width: 100%;
                height: 3px;
                background: #B82025; 
                border-radius: 2px;
            }

    /* ----- Job List ----- */
    .internship-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .internship-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 25px 40px;
        background: #FFFFFF;
        border: 1px solid #F3F4F6;
        border-radius: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    }

        .internship-item:hover {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transform: translateY(-2px);
        }

    .internship-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #06283F;
        margin-bottom: 1rem;
    }

    .internship-meta {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.9375rem;
        color: #9CA3AF;
        font-weight: 500;
    }

        .meta-item img {
            flex-shrink: 0;
        }

    /* ----- Apply Button ----- */
    .btn-apply-job {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 0.8rem 1.8rem;
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        background: #B82025;
        border-radius: 90px;
        transition: all 0.3s ease;
        white-space: nowrap;
        flex-shrink: 0;
        width: auto;
        min-width: 140px;
    }

        .btn-apply-job:hover {
            background: #9d1b1f;
            transform: translateX(5px);
        }

        .btn-apply-job .icon-circle {
            background: white;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #B82025;
            font-size: 0.8rem;
        }

    /* ----- Responsive (small screens) ----- */
    @@media (max-width: 768px) {
        .internship-item

    {
        padding: 20px;
    }

    .internship-meta {
        gap: 1rem;
    }

    }

    @@media (max-width: 640px) {
        .internship-item

    {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .btn-apply-job {
        width: 100%;
        justify-content: center;
        min-width: 0;
    }

    .internship-filters {
        justify-content: flex-start;
        gap: 0.5rem;
    }

    .filter-btn {
        padding: 0.75rem 0;
        font-size: 0.9rem;
    }
    }
    /* ----- Search & Filter Wrapper ----- */
    .internship-filters-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* ----- Search Bar ----- */
    .internship-search {
        position: relative;
        max-width: 500px;
        width: 100%;
    }

        .internship-search .search-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .internship-search input {
            width: 100%;
            padding: 0.9rem 3rem 0.9rem 3rem;
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            font-size: 1rem;
            font-family: inherit;
            background: #F9FAFB;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            outline: none;
        }

            .internship-search input:focus {
                border-color: #B82025;
                box-shadow: 0 0 0 3px rgba(184,32,37,0.1);
                background: #fff;
            }

    .search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        display: none;
        padding: 4px;
        border-radius: 50%;
    }

        .search-clear:hover {
            background: #F3F4F6;
        }

    /* Show clear button when input is not empty */
    .internship-search input:not(:placeholder-shown) ~ .search-clear {
        display: flex;
    }

    /* Keep filter row as before */
    .internship-filters {
        display: flex;
        gap: 1rem;
        margin-bottom: 0;
        border-bottom: 1px solid #E5E7EB;
        padding-bottom: 0;
        flex-wrap: wrap;
    }
</style>
<style>
    /* ===== Culture Message – Text Only ===== */
    .culture-message {
        padding: 30px 0;
        background: #F7F8F8; /* soft neutral background */
    }

    .message-block {
        margin: 0 auto;
        position: relative;
        padding: 50px 60px;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.04);
    }

    /* Decorative accent bar */
    .message-accent {
        position: absolute;
        top: 0;
        left: 60px;
        width: 80px;
        height: 4px;
        background: #B82025;
        border-radius: 0 0 4px 4px;
    }

    .message-heading {
        font-size: 40px;
        font-weight: 800;
        color: #06283F;
        line-height: 1.2;
        margin: 0 0 24px;
        text-transform: uppercase;
        letter-spacing: -0.5px;
    }

    .text-red {
        color: #B82025;
    }

    .message-body {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #4B5563;
        margin: 0 0 36px;
    }

    /* CTA Button */
    .btn-message-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #B82025;
        color: #fff;
        padding: 14px 32px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        transition: background 0.3s ease, transform 0.3s ease;
    }

        .btn-message-cta:hover {
            background: #8b1317;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(184,32,37,0.3);
        }

    .cta-arrow {
