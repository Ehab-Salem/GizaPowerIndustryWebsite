
@{
    ViewData["Title"] = "SupplayChain";
}
<style>
    .navbar {
        padding: 10px 40px !important;
    }

    /* ---------- Hero ---------- */
    .supply-chain-page .sc-hero {
        padding-top: 130px;
        padding-bottom: 40px;
    }

    .supply-chain-page .sc-eyebrow {
        display: inline-block;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 14px;
        font-weight: 600;
        color: var(--dark-gray);
        opacity: .55;
        margin-bottom: 14px;
    }

    .supply-chain-page .sc-hero h1 {
        max-width: 900px;
    }

    .supply-chain-page .sc-hero .sc-lead {
        /* max-width: 760px; */
        font-size: 18px;
        /* line-height: 1.7; */
        opacity: .8;
    }
    /* Responsive: scale down icon & caption on small screens */
    @@media (max-width: 991px) {
        .supply-chain-page .sc-selector .icon-box.w-70px {
            width: 48px !important;
            height: 48px !important;
        }

        .supply-chain-page .sc-selector-caption {
            font-size: 11px;
            margin-top: 10px;
            letter-spacing: 0;
        }

        .supply-chain-page .sc-selector figcaption {
            padding: 12px !important;
        }
    }

    @@media (max-width: 575px) {
        .supply-chain-page .sc-selector .icon-box.w-70px {
            width: 36px !important;
            height: 36px !important;
        }

        .supply-chain-page .sc-selector-caption {
            font-size: 10px;
            margin-top: 6px;
        }
    }

    .supply-chain-page .sc-hero .sc-note {
        font-size: 18px;
        font-weight: 500;
    }

    /* ---------- Stat strip ---------- */
    .supply-chain-page .sc-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 48px;
        padding-top: 28px;
        margin-top: 28px;
        border-top: 1px solid rgba(0, 0, 0, .08);
    }

    .supply-chain-page .sc-stat .sc-stat-number {
        font-size: 34px;
        font-weight: 700;
        line-height: 1;
        color: var(--dark-gray);
    }

    .supply-chain-page .sc-stat .sc-stat-label {
        display: block;
        margin-top: 6px;
        font-size: 14px;
        opacity: .65;
    }

    /* ---------- Product selector cards ---------- */
    .supply-chain-page .sc-selector {
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .supply-chain-page .sc-selector-caption {
        display: block;
        margin-top: 16px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: .2px;
        color: var(--dark-gray);
    }

    /* ---------- Diagram viewer card ---------- */
    .supply-chain-page .sc-viewer-card {
        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, .08);
        background: #fff;
        overflow: hidden;
    }

    .supply-chain-page .sc-viewer-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        padding: 28px 36px 20px;
        border-bottom: 1px solid rgba(0, 0, 0, .08);
    }

    .supply-chain-page #titleText {
        font-size: 22px;
        font-weight: 700;
        color: var(--dark-gray);
        margin: 0;
    }

    .supply-chain-page .sc-viewer-hint {
        font-size: 14px;
        opacity: .6;
        margin: 0;
    }

    .supply-chain-page .sc-viewer-body {
        position: relative;
        padding: 24px;
    }

    .supply-chain-page .svg {
        width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    @@media (max-width: 768px) {
        .resize
        {
            margin-top:8rem;
        }
        .supply-chain-page .sc-hero {
            padding-top: 90px;
        }

        .supply-chain-page .sc-stats {
            gap: 28px;
        }

        .supply-chain-page .sc-viewer-header {
            padding: 20px 20px 16px;
        }
    }

    /* ---------- Sourcing popup ---------- */
    #hotspot-popup .mfp-preloader,
    #hotspot-popup .mfp-arrow,
    #hotspot-popup .mfp-counter {
        display: none !important;
    }

    #hotspot-popup .box-shadow-quadruple-large {
        border-radius: 24px;
        overflow: hidden;
    }

    #hotspot-popup #popup-image {
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    #hotspot-popup #map-title {
        background: linear-gradient(0deg, rgba(0, 0, 0, .55), transparent 60%);
        width: 100%;
        padding: 24px 24px 20px;
    }

    /* Close button - top-right, responsive */
    .popup-close-left {
        position: absolute !important;
        top: 15px !important;
        right: 15px !important;
        left: auto !important;
        width: 36px !important;
        height: 36px !important;
        line-height: 36px !important;
        padding: 0 !important;
        font-size: 20px;
        color: #333;
        background: #fff;
        border-radius: 50%;
        border: none;
        opacity: .9;
        transition: opacity .2s;
        z-index: 1050 !important;
        display: flex !important;
        align-items: center;
        justify-content: center;
    }

        .popup-close-left:hover {
            opacity: 1;
            color: #000;
        }

        .popup-close-left::before,
        .popup-close-left::after {
            content: none !important;
        }

    @@media (max-width: 768px) {
        .popup-close-left {
            top: 10px !important;
            right: 10px !important;
            width: 32px !important;
            height: 32px !important;
            line-height: 32px !important;
            font-size: 18px;
        }
    }

    @@media (max-width: 480px) {
        .popup-close-left {
            top: 8px !important;
            right: 8px !important;
            width: 28px !important;
            height: 28px !important;
            line-height: 28px !important;
            font-size: 16px;
        }
    }

    /* Center the hover arrow inside the circular banner images */
    .interactive-banner-style-01 figcaption {
        justify-content: center !important;
    }

        .interactive-banner-style-01 figcaption .icon-box {
            margin-bottom: 0 !important;
        }
</style>

