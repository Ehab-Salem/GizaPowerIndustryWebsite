<div class="supply-chain-page resize" data-mobile-nav-style="classic">

    <!-- start page title -->
    <section class="sc-hero ipad-top-space-margin md-pt-0">
        <div class="container">
            <div class="row justify-content-start">
                <div class="col-12">
                    <div class="about-header">
                        <span class="about-label" style="color:#B82025;font-weight: 900;">
                            Supply Chain
                        </span>
                        <h2 class="about-subtitle reveal-line">
                            Visualizing GPI&rsquo;s Resilient Supply Chain
                        </h2>
                    </div>
                    <p class="sc-lead text-dark-gray mb-15px">
                        Every GPI cable tells a story of strength, reliability, and global partnership.
                        This interactive demo reveals how each layer of the cable is sourced &mdash; from
                        carefully selected raw materials to trusted suppliers across multiple countries.
                        Click through a cable&rsquo;s construction layers below to discover the geographic
                        diversity behind our supply chain, designed to ensure continuity, quality, and
                        resilience even in challenging market conditions.
                    </p>
                    <p class="sc-note text-dark-gray mb-0">At GPI, resilience isn&rsquo;t a claim &mdash; it&rsquo;s built into every layer.</p>

                    <div class="sc-stats">
                        <div class="sc-stat">
                            <span class="sc-stat-number">15+</span>
                            <span class="sc-stat-label">Sourcing Origins</span>
                        </div>
                        <div class="sc-stat">
                            <span class="sc-stat-number">5</span>
                            <span class="sc-stat-label">Cable Constructions Mapped</span>
                        </div>
                        <div class="sc-stat">
                            <span class="sc-stat-number">40+</span>
                            <span class="sc-stat-label">Years Manufacturing Heritage</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end page title -->

