    <section style="    padding-top: 0px;
    padding-bottom: 5px;
    padding-left: 35px;
    padding-right: 35px;">
        <div class="container">
            <div class="specs-table-container">
                <table class="specs-table" id="specsTable">
                    <thead>
                        <tr class="header-row-1">
                            <th class="product-code-header"   >Product – Code</th>
                            <th class="nominal-area-header" >Cross Sectional <br /> Area mm²</th>
                            <th >Minimum Number of <br /> Wires No.</th>
                            <th   >Max. D.C. Conductor <br /> Resistance at 20 °C Ω/km</th>
                            <th   >Approx. Overall <br /> Diameter mm²</th>
                            <th   >Approx. Weight <br /> kg/km</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="table-section-header">
                            <td colspan="6" style="background-color:#06283F !important">IEC 60228 class 2</td>
                        </tr>
                            @if (ViewBag.Data != null)
                            {
                                foreach (var item in ViewBag.Data as IEnumerable<BareModel>)
                                {
                                    <tr>
                                        <td>@item.ProductCode</td>
                                        <td>@item.Area</td>
                                        <td>@item.NOWires</td>
                                        <td>@item.Resistance</td>
                                        <td>@item.Diameter</td>
                                        <td>@item.ApproxWeight</td>
                                    </tr>
                                }
                            }
                    </tbody>
                </table>
            </div>
            <p style="    margin-top: 10px;
    font-size: 17px;">The above data is approximate and subject to manufacturing tolerances</p>
            </div>
            </section>
</div>