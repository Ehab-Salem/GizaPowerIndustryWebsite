<style>
    @@media (max-width: 991px) {
        .tab-style-04 .nav-tabs .nav-link.active::before {
            display: none !important;
        }
    }
    /* ===== Enhanced Tab Design – GPI Brand ===== */
    :root {
        --gpi-red: #a3191e;
        --text-dark: #06283F;
        --text-grey: #4B5563;
        --border-light: #E5E7EB;
    }

    /* Remove any conflicting Dawyer underline */
    .tab-style-04 .nav-link::after,
    .tab-style-04 .nav-link:hover::after,
    .tab-style-04 .nav-link.active::after {
        display: none !important;
    }

    /* Tabs container */
    .tab-style-04 .nav-tabs {
        border-bottom: 2px solid var(--border-light);
        gap: 0;
        flex-wrap: wrap;
    }

        /* Each tab link */
        .tab-style-04 .nav-tabs .nav-link {
            border: none !important;
            background: transparent !important;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-grey);
            padding: 0.75rem 1.4rem;
            position: relative;
            transition: color 0.2s;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            white-space: nowrap;
        }

            .tab-style-04 .nav-tabs .nav-link:hover {
                color: var(--gpi-red);
            }

            .tab-style-04 .nav-tabs .nav-link.active {
                color: var(--gpi-red);
            }

                /* Active underline – clean red bar */
                .tab-style-04 .nav-tabs .nav-link.active::before {
                    content: "";
                    position: absolute;
                    bottom: -2px;
                    left: 0;
                    width: 100%;
                    height: 3px;
                    background: var(--gpi-red);
                    border-radius: 2px 2px 0 0;
                }

    /* Remove the old span .tab-border – we don't need it anymore,
                                                   but if you keep it, override its colour: */
    .tab-style-04 .tab-border {
        background: var(--gpi-red) !important;
    }

    /* Tab content spacing */
    /* .tab-content {
                                                    padding-top: 2rem;
                                                } */

    /* Technical data rows – soft alternating background */
    #data .row {
        margin-left: 0;
        margin-right: 0;
    }

        #data .row.bg-very-light-gray {
            background-color: #F9FAFB;
        }

    /* Improve readability of data labels & values */
    #data .col-lg-5,
    #data .col-md-3,
    #data .col-sm-4 {
        font-weight: 600;
        color: var(--text-dark);
        font-size: 0.95rem;
    }

    #data .col-lg-7,
    #data .col-md-9,
    #data .col-sm-8 {
        color: var(--text-grey);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* ===== Tables – modern card-like feel ===== */
    .technical-table {
        background: #fff;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 2rem;
        font-size: 0.9rem;
    }

        .technical-table thead {
            background: #F9FAFB;
        }

            .technical-table thead td,
            .technical-table thead th {
                font-weight: 600;
                color: var(--text-dark);
                padding: 0.8rem 0.5rem;
                vertical-align: middle;
                border-bottom: 2px solid var(--border-light);
            }

            /* Red header rows (H05V-U etc.) */
            .technical-table thead .bg-red {
                background: var(--gpi-red) !important;
                color: #fff !important;
            }

                .technical-table thead .bg-red th,
                .technical-table thead .bg-red td {
                    color: #fff !important;
                    font-weight: 700;
                    font-size: 1rem;
                    padding: 1rem 0.5rem;
                }

        /* Table body */
        .technical-table tbody td {
            padding: 0.7rem 0.5rem;
            vertical-align: middle;
            border-color: var(--border-light);
        }

        .technical-table tbody tr:hover {
            background: #FDF2F2;
            /* subtle red tint on hover */
        }

    /* Responsive table – already uses .table-responsive, but add smooth horizontal scroll */
    .table-responsive {
        -webkit-overflow-scrolling: touch;
        border-radius: 8px;
    }

    /* Disclaimer text */
    #data .col-12 > span {
        display: block;
        text-align: center;
        color: #9CA3AF;
        font-size: 0.85rem;
        margin-top: 1rem;
    }

    /* Note tab styling */
    #note p {
        font-size: 1rem;
        color: var(--text-grey);
        line-height: 1.8;
        background: #F9FAFB;
        padding: 2rem;
        border-radius: 12px;
        border-left: 4px solid var(--gpi-red);
    }

    /* ---- New styles for side-by-side sections & new tabs ---- */
    .feature-block {
        background: #F9FAFB;
        border-radius: 12px;
        padding: 1.5rem;
        height: auto;
        border-left: 4px solid var(--gpi-red);
    }

        .feature-block h6 {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--gpi-red);
            margin-bottom: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .feature-block ul {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
        }

            .feature-block ul li {
                position: relative;
                padding-left: 1.4rem;
                margin-bottom: 0.5rem;
                color: var(--text-grey);
                font-size: 0.9rem;
                line-height: 1.6;
            }

                .feature-block ul li::before {
                    content: "•";
                    position: absolute;
                    left: 0;
                    top: 0;
                    color: var(--gpi-red);
                    font-weight: 700;
                    font-size: 1.1rem;
                    line-height: 1.4;
                }

    .card-type-label {
        display: inline-block;
        background: var(--gpi-red);
        color: #fff;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        margin-bottom: 0.6rem;
    }

    .smart-billing-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.9rem;
        padding: 0.8rem 1rem;
        background: #fff;
        border-radius: 8px;
        border: 1px solid var(--border-light);
    }

        .smart-billing-item .bullet-icon {
            flex-shrink: 0;
            width: 10px;
            height: 10px;
            background: var(--gpi-red);
            border-radius: 50%;
            margin-top: 0.45rem;
        }

        .smart-billing-item span {
            color: var(--text-grey);
            font-size: 0.95rem;
            line-height: 1.5;
        }

    /* Responsive adjustments for tab labels on small screens */
    @@media (max-width: 768px) {
        .tab-style-04 .nav-tabs .nav-link {
            padding: 0.6rem 0.8rem;
            font-size: 0.8rem;
            letter-spacing: 0.2px;
        }

        .feature-block {
            margin-bottom: 1rem;
            height: auto;
        }
    }

    @@media (max-width: 576px) {
        .tab-style-04 .nav-tabs .nav-link {
            padding: 0.55rem 0.65rem;
            font-size: 0.72rem;
        }
    }

    @@media (max-width: 768px) {
        .product-main-img {
            height: 210px !important;
            width: auto;
            object-fit: contain;
        }
    }
    /* ===== Scrollable Tabs Wrapper ===== */
    .tab-scroll-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        margin-bottom: 0;
    }

    /* Scrollable area */
    .tab-scroll-container {
        flex: 1;
        overflow-x: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
        display: flex;
    }

        .tab-scroll-container::-webkit-scrollbar {
            display: none; /* Chrome/Safari */
        }

        /* Tab list inside scroll container */
        .tab-scroll-container .nav-tabs {
            flex-wrap: nowrap; /* prevent wrapping */
            border-bottom: 2px solid #E5E7EB;
            gap: 0;
            margin: 0 auto; /* center when content fits */
            white-space: nowrap;
        }

            /* Individual tab links */
            .tab-scroll-container .nav-tabs .nav-link {
                border: none !important;
                background: transparent !important;
                font-size: 0.95rem;
                font-weight: 600;
                color: #4B5563;
                padding: 0.75rem 1.4rem;
                position: relative;
                transition: color 0.2s;
                text-transform: uppercase;
                letter-spacing: 0.4px;
                white-space: nowrap;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .tab-scroll-container .nav-tabs .nav-link:hover {
                    color: #a3191e;
                }

                .tab-scroll-container .nav-tabs .nav-link.active {
                    color: #a3191e;
                }

                    /* Active underline */
                    .tab-scroll-container .nav-tabs .nav-link.active::before {
                        content: "";
                        position: absolute;
                        bottom: -2px;
                        left: 0;
                        width: 100%;
                        height: 3px;
                        background: #a3191e;
                        border-radius: 2px 2px 0 0;
                    }

    /* Arrow buttons */
    .tab-scroll-arrow {
        flex-shrink: 0;
        width: 40px;
        height: 40px;
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #4B5563;
        transition: all 0.2s ease;
        margin: 0 4px;
        z-index: 2;
    }

        .tab-scroll-arrow:hover {
            background: #f9fafb;
            color: #a3191e;
            border-color: #a3191e;
        }

        .tab-scroll-arrow:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .tab-scroll-container .nav-tabs .nav-link

    {
        padding: 0.6rem 0.8rem;
        font-size: 0.8rem;
    }

    .tab-scroll-arrow {
        width: 32px;
        height: 32px;
    }

    }
</style>
